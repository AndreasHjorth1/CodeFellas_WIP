@{
    ViewData["Title"] = "Eksporter data";
}

<style>
    .eksport-page {
        background-color: #ffffff;
        color: #0b1f3a;
        min-height: 100%;
    }

    .eksport-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
    }

    /* Topp: tittel og ingress */
    .eksport-head h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 0 0 0.5rem;
    }

    .eksport-head p {
        color: #4a5b70;
        font-size: 1.05rem;
        max-width: 46rem;
        margin: 0;
    }

    /* To kort side om side: Ressurser og Behov */
    .eksport-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .eksport-card {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        display: flex;
        flex-direction: column;
    }

    .eksport-card-head {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #dde3ea;
    }

    .eksport-card-head .icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.05rem;
    }

    .eksport-card-head .icon-ressurs {
        background-color: #e3f1ea;
        color: #1b6b45;
    }

    .eksport-card-head .icon-behov {
        background-color: #fbe9ec;
        color: #b4233c;
    }

    .eksport-card-head h2 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0;
    }

    .eksport-card-head span {
        color: #4a5b70;
        font-size: 0.9rem;
    }

    /* Ett valg = én rad med forklaring og to nedlastinger */
    .eksport-option {
        padding: 1.25rem 1.5rem 1.4rem;
    }

    .eksport-option + .eksport-option {
        border-top: 1px solid #edf0f4;
    }

    .eksport-option h3 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0 0 0.25rem;
    }

    .eksport-option p {
        color: #4a5b70;
        font-size: 0.95rem;
        margin: 0 0 0.9rem;
    }

    .eksport-option.anbefalt {
        box-shadow: inset 3px 0 0 #04245a;
        background-color: #f7f9fc;
    }

    .eksport-tag {
        display: inline-block;
        margin-left: 0.4rem;
        padding: 0.1rem 0.45rem;
        border-radius: 3px;
        background-color: #04245a;
        color: #ffffff;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        vertical-align: 2px;
    }

    .eksport-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .btn-fil {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        min-height: 44px;
        padding: 0.5rem 1rem;
        border-radius: 3px;
        border: 1px solid #c3ccd8;
        background-color: #ffffff;
        color: #0b1f3a;
        font-size: 0.92rem;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .btn-fil small {
        font-weight: 400;
        color: #5c6c80;
        font-size: 0.8rem;
    }

    .btn-fil:hover {
        border-color: #04245a;
        background-color: #f3f6fb;
        color: #0b1f3a;
        transform: translateY(-1px);
    }

    .btn-fil.primaer {
        background-color: #04245a;
        border-color: #04245a;
        color: #ffffff;
    }

    .btn-fil.primaer small {
        color: #c9d4e6;
    }

    .btn-fil.primaer:hover {
        background-color: #0f3a80;
        border-color: #0f3a80;
        color: #ffffff;
    }

    .btn-fil:focus-visible {
        outline: 3px solid #258cfb;
        outline-offset: 2px;
    }

    .btn-fil .fa-download {
        font-size: 0.8rem;
        opacity: 0.8;
    }

    /* Under kortene: hvilket format og personvern */
    .eksport-info {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.5rem;
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid #dde3ea;
    }

    .eksport-info h4 {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        font-weight: 700;
        margin: 0 0 0.4rem;
    }

    .eksport-info p {
        color: #4a5b70;
        font-size: 0.92rem;
        margin: 0;
    }

    .eksport-head .eksport-varsel {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-top: 1.1rem;
        padding: 0.65rem 0.9rem;
        background-color: #fff6e0;
        border: 1px solid #f1d38a;
        border-radius: 3px;
        color: #5a4300;
        font-size: 0.95rem;
    }

    @@media (max-width: 860px) {
        .eksport-grid,
        .eksport-info {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .btn-fil {
            transition: none;
        }

        .btn-fil:hover {
            transform: none;
        }
    }
</style>

<div class="eksport-page">
    <div class="eksport-inner">

        <div class="eksport-head">
            <h1>Eksporter data</h1>
            <p>Last ned ressurser og behov som en fil. Velg CSV hvis du skal jobbe i Excel, eller GeoJSON hvis du skal se dataene i et kartprogram.</p>
            <p class="eksport-varsel">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                Filene inneholder telefonnumre. Lagre dem trygt og del dem bare med de som trenger dem.
            </p>
        </div>

        <div class="eksport-grid">

            <!-- Ressurser -->
            <section class="eksport-card" aria-labelledby="eksportRessurser">
                <div class="eksport-card-head">
                    <span class="icon-circle icon-ressurs"><i class="fa-solid fa-truck-pickup" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="eksportRessurser">Ressurser</h2>
                        <span>Det innbyggere og virksomheter har registrert</span>
                    </div>
                </div>

                <div class="eksport-option anbefalt">
                    <h3>Tilgjengelige ressurser</h3>
                    <p>Bare ressurser som er markert som tilgjengelige for oppdrag.</p>
                    <div class="eksport-buttons">
                        <a asp-controller="Export" asp-action="ResourcesCsv" asp-route-onlyAvailable="true" class="btn-fil primaer">
                            <i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV
                        </a>
                        <a asp-controller="Export" asp-action="ResourcesGeoJson" asp-route-onlyAvailable="true" class="btn-fil">
                            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> GeoJSON
                        </a>
                    </div>
                </div>

                <div class="eksport-option">
                    <h3>Alle registrerte ressurser</h3>
                    <p>Alle ressurser, også de som ikke er tilgjengelige nå.</p>
                    <div class="eksport-buttons">
                        <a asp-controller="Export" asp-action="ResourcesCsv" asp-route-onlyAvailable="false" class="btn-fil">
                            <i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV
                        </a>
                        <a asp-controller="Export" asp-action="ResourcesGeoJson" asp-route-onlyAvailable="false" class="btn-fil">
                            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> GeoJSON
                        </a>
                    </div>
                </div>
            </section>

            <!-- Behov -->
            <section class="eksport-card" aria-labelledby="eksportBehov">
                <div class="eksport-card-head">
                    <span class="icon-circle icon-behov"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
                    <div>
                        <h2 id="eksportBehov">Behov</h2>
                        <span>Det som er meldt inn av offentlige aktører</span>
                    </div>
                </div>

                <div class="eksport-option anbefalt">
                    <h3>Åpne behov</h3>
                    <p>Behov som ikke er løst ennå (status Ny, Vurderes eller Tildelt).</p>
                    <div class="eksport-buttons">
                        <a asp-controller="Export" asp-action="NeedsCsv" asp-route-onlyOpen="true" class="btn-fil primaer">
                            <i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV
                        </a>
                        <a asp-controller="Export" asp-action="NeedsGeoJson" asp-route-onlyOpen="true" class="btn-fil">
                            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> GeoJSON
                        </a>
                    </div>
                </div>

                <div class="eksport-option">
                    <h3>Alle registrerte behov</h3>
                    <p>Alle behov, også de som er løst.</p>
                    <div class="eksport-buttons">
                        <a asp-controller="Export" asp-action="NeedsCsv" asp-route-onlyOpen="false" class="btn-fil">
                            <i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV
                        </a>
                        <a asp-controller="Export" asp-action="NeedsGeoJson" asp-route-onlyOpen="false" class="btn-fil">
                            <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> GeoJSON
                        </a>
                    </div>
                </div>
            </section>
        </div>

        <!-- Hjelp til å velge format -->
        <div class="eksport-info">
            <div>
                <h4><i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV</h4>
                <p>En tabell med én rad per ressurs eller behov. Åpnes i Excel, Numbers eller Google Regneark.</p>
            </div>
            <div>
                <h4><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i> GeoJSON</h4>
                <p>Punkter med posisjon og opplysninger. Åpnes direkte i QGIS, ArcGIS eller geojson.io.</p>
            </div>
        </div>
    </div>
</div>
