@model Prosjekt.Models.ModelView.GeoChangeViewModel

@{
    ViewData["Title"] = "Registrer Geografiske Hendelser";
}
<div class="position-relative w-100 overflow-hidden" style="height: calc(100vh - 80px); min-height: 500px;">
    <div id="map" class="w-100 h-100" data-lat="@Model?.Latitude" data-lng="@Model?.Longitude"></div>

    <div id="sideMeny" class="position-absolute top-0 start-0 h-100 bg-white shadow-lg p-4 rounded-end d-none" style="z-index: 1000; width: 420px; max-width: 100%; overflow-y: auto;">
        <button type="button" class="btn-close float-end mb-2" id="lukkMenyBtn" aria-label="Lukk"></button>
        <div class="clearfix"></div>

        <h2 class="mb-1">Geografisk Hendelse</h2>
        <p class="text-muted small">Registrer endring og faresone for markert område.</p>
        <hr />

        <form asp-controller="GeoChange" asp-action="CorrectMap" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <div class="border p-3 mb-4 rounded bg-light">
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label for="latitude" class="fw-bold small">Breddegrad</label>
                        <input type="text" id="latitude" name="Latitude" value="@Model?.Latitude" class="form-control form-control-sm" readonly required />
                    </div>
                    <div class="col-6">
                        <label for="longitude" class="fw-bold small">Lengdegrad</label>
                        <input type="text" id="longitude" name="Longitude" value="@Model?.Longitude" class="form-control form-control-sm" readonly required />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label for="radius" class="fw-bold">Radius (meter)</label>
                    <input type="number" id="radius" name="Radius" class="form-control" value="@(Model?.Radius ?? 500)" min="10" step="10" required />
                    <small class="text-muted">Sirkelen oppdateres automatisk i kartet.</small>
                </div>

                <div class="form-group mb-3">
                    <label for="description" class="fw-bold">Beskrivelse</label>
                    <textarea id="description" name="Description" class="form-control" rows="3" required placeholder="Hva har skjedd her?">@Model?.Description</textarea>
                </div>
                
                <div class="form-group">
                    <label class="fw-bold">Endringstyper</label>
                    <div id="changeTypes" class="mt-1 border p-2 rounded bg-white">
                        @if (Model?.ChangeTypes != null && Model.ChangeTypes.Any())
                        {
                            @foreach (var changeType in Model.ChangeTypes)
                            {
                                var isChecked = Model.SelectedChangeTypes != null && Model.SelectedChangeTypes.Contains(changeType);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedChangeTypes" value="@changeType" id="changeType_@changeType" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="changeType_@changeType">@changeType</label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small mb-0">Ingen endringstyper tilgjengelig.</p>
                        }
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary mt-2 w-100">Lagre hendelse</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var mapEl = document.getElementById('map');
        var sideMeny = document.getElementById('sideMeny');
        var initialLat = parseFloat(mapEl.dataset.lat);
        var initialLng = parseFloat(mapEl.dataset.lng);
        if (isNaN(initialLat)) initialLat = 58.1467;
        if (isNaN(initialLng)) initialLng = 7.9956;

        var map = L.map('map').setView([initialLat, initialLng], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(map);

        var currentMarker; var currentCircle;
        var selectedLat = isNaN(parseFloat(mapEl.dataset.lat)) ? null : initialLat;
        var selectedLng = isNaN(parseFloat(mapEl.dataset.lng)) ? null : initialLng;

        function updateShape() {
            if (!selectedLat || !selectedLng) return;
            var radius = parseFloat(document.getElementById('radius').value) || 0;
            if (currentMarker) map.removeLayer(currentMarker);
            if (currentCircle) map.removeLayer(currentCircle);
            currentMarker = L.marker([selectedLat, selectedLng]).addTo(map);
            currentCircle = L.circle([selectedLat, selectedLng], { radius: radius, color: '#3388ff', fillColor: '#3388ff', fillOpacity: 0.2 }).addTo(map);
        }

        if (selectedLat && selectedLng) { updateShape(); sideMeny.classList.remove('d-none'); }

        map.on('click', function(e) {
            selectedLat = e.latlng.lat.toFixed(6);
            selectedLng = e.latlng.lng.toFixed(6);
            document.getElementById('latitude').value = selectedLat;
            document.getElementById('longitude').value = selectedLng;
            updateShape();
            if (sideMeny.classList.contains('d-none')) sideMeny.classList.remove('d-none');
            var menyBredde = sideMeny.offsetWidth || 420;
            map.flyTo([selectedLat, selectedLng], map.getZoom(), { animate: true, duration: 0.8 });
            setTimeout(function() { map.panBy([-menyBredde / 2, 0], { animate: true, duration: 0.4 }); }, 300);
        });

        document.getElementById('radius').addEventListener('input', function() { updateShape(); });

        document.getElementById('lukkMenyBtn').addEventListener('click', function() {
            sideMeny.classList.add('d-none');
            if (currentMarker) map.removeLayer(currentMarker);
            if (currentCircle) map.removeLayer(currentCircle);
            currentMarker = null; currentCircle = null; selectedLat = null; selectedLng = null;
            document.getElementById('latitude').value = ''; document.getElementById('longitude').value = '';
        });

        setTimeout(function() { map.invalidateSize(); }, 200);
    </script>
}