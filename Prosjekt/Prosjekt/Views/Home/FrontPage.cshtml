@{
    ViewData["Title"] = "Registrer det du kan låne ut i en krise";

    /// Kategoriene er de samme som i registreringsskjemaet (ResourceType). Verdien sendes videre som ?kategori=...
    var kategorier = new[]
    {
        (Verdi: "Vehicle", Navn: "Kjøretøy", Eksempler: "Traktor, varebil, båt", Ikon: "fa-truck"),
        (Verdi: "Tool", Navn: "Verktøy", Eksempler: "Aggregat, motorsag, pumpe", Ikon: "fa-screwdriver-wrench"),
        (Verdi: "Materials", Navn: "Materialer", Eksempler: "Sand, grus, plank", Ikon: "fa-trowel-bricks"),
        (Verdi: "Provision", Navn: "Mat og forsyninger", Eksempler: "Vann, mat, førstehjelp", Ikon: "fa-box-open"),
        (Verdi: "Clothing", Navn: "Klær", Eksempler: "Varme klær, ulltepper", Ikon: "fa-shirt"),
        (Verdi: "Competence", Navn: "Kompetanse", Eksempler: "Helse, bygg, frivillig innsats", Ikon: "fa-user-group"),
        (Verdi: "Other", Navn: "Annet", Eksempler: "Lokaler, drone, annet utstyr", Ikon: "fa-ellipsis")
    };
}

<style>
    /* Siden går helt ut i kantene, og hver seksjon har sin egen bakgrunn */
    main {
        background-color: #ffffff !important;
    }

    .fp {
        color: #0f2a4f;
    }

    .fp-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .fp section {
        scroll-margin-top: 4.5rem;
    }

    .fp h1,
    .fp h2,
    .fp h3 {
        color: #04245a;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .fp h2 {
        font-size: 2rem;
        margin: 0 0 0.5rem;
    }

    .fp .lead-text {
        color: #3d4f69;
        font-size: 1.05rem;
        line-height: 1.6;
    }

    /* Knapper */
    .fp-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        border-radius: 2px;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.8rem 1.4rem;
        text-decoration: none;
        border: 1px solid transparent;
    }

    .fp-btn-navy {
        background-color: #04245a;
        border-color: #04245a;
        color: #ffffff;
    }

    .fp-btn-navy:hover {
        background-color: #0f3a80;
        color: #ffffff;
    }

    .fp-btn-white {
        background-color: #ffffff;
        border-color: #ffffff;
        color: #04245a;
    }

    .fp-btn-white:hover {
        background-color: #e9eef5;
        color: #04245a;
    }

    /* 1. Toppen: tittel til venstre, registreringskort til høyre.
       Bakgrunnen stopper midt i snarveiene, så de ser ut til å ligge over kanten. */
    .fp-hero {
        background: linear-gradient(to bottom, #eef2f6 calc(100% - 2.6rem), #ffffff calc(100% - 2.6rem));
        padding-top: 3.5rem;
    }

    .fp-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
    }

    .fp-hero h1 {
        font-size: 3rem;
        line-height: 1.08;
        margin: 0 0 1rem;
    }

    .fp-register-card {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-top: 3px solid #04245a;
        border-radius: 2px;
        padding: 1.5rem;
    }

    .fp-register-card h2 {
        font-size: 1.25rem;
        margin-bottom: 1rem;
    }

    .fp-register-card label {
        display: block;
        font-size: 0.9rem;
        font-weight: 600;
        margin-bottom: 0.4rem;
    }

    .fp-register-card select {
        border-radius: 2px;
        margin-bottom: 1rem;
    }

    .fp-register-card .fp-btn {
        width: 100%;
    }

    .fp-register-card p {
        color: #5f6f86;
        font-size: 0.85rem;
        margin: 0.85rem 0 0;
    }

    .fp-register-card p a {
        color: #04245a;
    }

    /* Snarveier under toppen */
    .fp-shortcuts {
        list-style: none;
        margin: 2.5rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .fp-shortcuts a {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        height: 100%;
        min-height: 5.2rem;
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 2px;
        padding: 0.9rem 1rem;
        color: #04245a;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
    }

    .fp-shortcuts a:hover {
        border-color: #9aa9be;
    }

    .fp-shortcuts .icon {
        flex: 0 0 2.2rem;
        width: 2.2rem;
        height: 2.2rem;
        border-radius: 50%;
        background-color: #eef2f6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
    }

    .fp-shortcuts .icon.red {
        background-color: #fbe9ec;
        color: #c8102e;
    }

    .fp-shortcuts .chevron {
        margin-left: auto;
        font-size: 0.8rem;
    }

    /* 2. Blå seksjon med illustrasjon */
    .fp-together {
        background-color: #04245a;
        color: #ffffff;
        padding: 4rem 0;
        margin-top: 2.5rem;
    }

    .fp-together-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
    }

    .fp-together h2 {
        color: #ffffff;
    }

    .fp-together p {
        color: #d6deeb;
        line-height: 1.6;
    }

    .fp-checks {
        list-style: none;
        margin: 1.5rem 0 1.75rem;
        padding: 0;
    }

    .fp-checks li {
        display: flex;
        gap: 0.85rem;
        align-items: baseline;
        padding: 0.7rem 0;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 0.95rem;
    }

    .fp-checks li:last-child {
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .fp-checks i {
        color: #9fd3b8;
    }

    .fp-illustration {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 2px;
    }

    /* 3. Slik fungerer det */
    .fp-steps {
        background-color: #eef2f6;
        padding: 4rem 0;
    }

    .fp-steps-grid {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
    }

    .fp-steps-grid li {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 2px;
        padding: 1.25rem 1.25rem 1.5rem;
    }

    .fp-steps-grid .num {
        width: 1.9rem;
        height: 1.9rem;
        border-radius: 50%;
        background-color: #04245a;
        color: #ffffff;
        font-size: 0.85rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .fp-steps-grid li:last-child .num {
        background-color: #c8102e;
    }

    .fp-steps-grid h3 {
        font-size: 1.05rem;
        margin: 0 0 0.35rem;
    }

    .fp-steps-grid p {
        color: #5f6f86;
        font-size: 0.92rem;
        margin: 0;
    }

    /* 4. Hva kan du bidra med? */
    .fp-categories {
        padding: 4rem 0;
    }

    .fp-category-grid {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        column-gap: 1rem;
        border-top: 1px solid #dde3ea;
    }

    .fp-category-grid li {
        border-bottom: 1px solid #dde3ea;
    }

    .fp-category-grid a {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.9rem 0.25rem;
        color: #04245a;
        text-decoration: none;
    }

    .fp-category-grid a:hover {
        background-color: #f6f8fb;
    }

    .fp-category-grid .cat-icon {
        width: 1.3rem;
        text-align: center;
    }

    .fp-category-grid strong {
        display: block;
        font-size: 0.95rem;
    }

    .fp-category-grid span {
        display: block;
        color: #5f6f86;
        font-size: 0.8rem;
    }

    .fp-category-grid .chevron {
        margin-left: auto;
        font-size: 0.8rem;
    }

    /* 5. Rødt bånd om egenberedskap */
    .fp-prepared {
        background-color: #c8102e;
        color: #ffffff;
        padding: 2.25rem 0;
    }

    .fp-prepared-inner {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .fp-prepared .warn {
        flex: 0 0 2.6rem;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 50%;
        background-color: #ffffff;
        color: #c8102e;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .fp-prepared h2 {
        color: #ffffff;
        font-size: 1.15rem;
        margin: 0 0 0.25rem;
    }

    .fp-prepared p {
        margin: 0;
        font-size: 0.95rem;
    }

    .fp-prepared .fp-btn {
        margin-left: auto;
        color: #c8102e;
        white-space: nowrap;
    }

    /* 6. Spørsmål og svar */
    .fp-faq {
        background-color: #eef2f6;
        padding: 4rem 0;
    }

    .fp-faq-inner {
        max-width: 760px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .fp-faq-list {
        margin-top: 1.5rem;
        border-top: 1px solid #d3dbe5;
    }

    .fp-faq-item {
        border-bottom: 1px solid #d3dbe5;
    }

    .fp-faq-item button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        background: transparent;
        border: 0;
        padding: 1.1rem 0.5rem;
        color: #04245a;
        font-weight: 700;
        text-align: left;
    }

    .fp-faq-item button i {
        transition: transform 0.2s ease;
    }

    .fp-faq-item button[aria-expanded="true"] i {
        transform: rotate(180deg);
    }

    .fp-faq-item .answer {
        padding: 0 0.5rem 1.1rem;
        color: #3d4f69;
        line-height: 1.6;
    }

    .fp-faq-item .answer a {
        color: #04245a;
    }

    @@media (max-width: 991.98px) {
        .fp-hero-grid,
        .fp-together-grid {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .fp-shortcuts,
        .fp-category-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .fp-steps-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 575.98px) {
        .fp-hero {
            padding-top: 2.25rem;
        }

        .fp-hero h1 {
            font-size: 2.2rem;
        }

        .fp h2 {
            font-size: 1.6rem;
        }

        .fp-shortcuts,
        .fp-category-grid {
            grid-template-columns: 1fr;
        }

        .fp-prepared-inner {
            flex-wrap: wrap;
        }

        .fp-prepared .fp-btn {
            margin-left: 0;
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .fp-faq-item button i {
            transition: none;
        }
    }
</style>

<div class="fp">

    <!-- 1. Tittel, registreringskort og snarveier -->
    <section class="fp-hero" aria-labelledby="forsideTittel">
        <div class="fp-inner">
            <div class="fp-hero-grid">
                <div>
                    <h1 id="forsideTittel">Registrer det du kan låne ut i en krise</h1>
                    <p class="lead-text">
                        Et aggregat, en traktor, en båt eller tid som frivillig. Når du registrerer det i Beredt, vet beredskapen at det finnes,
                        og kan kontakte deg når noen trenger det.
                    </p>
                </div>

                <form class="fp-register-card" method="get" asp-controller="Resource" asp-action="Index">
                    <h2>Hva vil du registrere?</h2>
                    <label for="forsideKategori">Velg kategori</label>
                    <select id="forsideKategori" name="kategori" class="form-select">
                        @foreach (var k in kategorier)
                        {
                            <option value="@k.Verdi">@k.Navn, for eksempel @(k.Eksempler.Split(',')[0].ToLower())</option>
                        }
                    </select>
                    <button type="submit" class="fp-btn fp-btn-navy">
                        Start registrering <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </button>
                    <p>Du blir bedt om å logge inn. Har du ikke bruker? <a asp-controller="Account" asp-action="Register">Registrer deg</a></p>
                </form>
            </div>

            <ul class="fp-shortcuts">
                <li>
                    <a asp-controller="Resource" asp-action="Index">
                        <span class="icon"><i class="fa-solid fa-plus" aria-hidden="true"></i></span>
                        Registrer ressurs
                        <i class="fa-solid fa-chevron-right chevron" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a href="#bidra">
                        <span class="icon"><i class="fa-solid fa-table-cells-large" aria-hidden="true"></i></span>
                        Hva kan du bidra med?
                        <i class="fa-solid fa-chevron-right chevron" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a asp-controller="Home" asp-action="CrisisInformation">
                        <span class="icon red"><i class="fa-solid fa-info" aria-hidden="true"></i></span>
                        Kriseinformasjon
                        <i class="fa-solid fa-chevron-right chevron" aria-hidden="true"></i>
                    </a>
                </li>
                <li>
                    <a href="#sporsmal">
                        <span class="icon"><i class="fa-solid fa-question" aria-hidden="true"></i></span>
                        Spørsmål og svar
                        <i class="fa-solid fa-chevron-right chevron" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </div>
    </section>

    <!-- 2. Sammen står vi sterkere -->
    <section class="fp-together" aria-labelledby="sammenTittel">
        <div class="fp-inner fp-together-grid">
            <div>
                <h2 id="sammenTittel">Sammen står vi sterkere</h2>
                <p>
                    Tenk deg at strømmen går en kald vinternatt, og sykehjemmet der du bor står uten varme. Kanskje er det aggregatet
                    i garasjen din som kan hjelpe. Men står det ikke på listen, vet ingen at det finnes.
                </p>
                <ul class="fp-checks">
                    <li><i class="fa-solid fa-check" aria-hidden="true"></i> Noen kan trenge akkurat det du har.</li>
                    <li><i class="fa-solid fa-check" aria-hidden="true"></i> Hjelpen kommer raskere fram når den er registrert på forhånd.</li>
                    <li><i class="fa-solid fa-check" aria-hidden="true"></i> Store og små bidrag teller like mye.</li>
                </ul>
                <a class="fp-btn fp-btn-white" asp-controller="Resource" asp-action="Index">
                    Registrer ressurs <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>

            @* Tegnet kart med appens egne ressurssymboler. Ingen kartdata hentes. *@
            <svg class="fp-illustration" viewBox="0 0 360 290" role="img" aria-label="Tegning av et nabolag med registrerte ressurser som aggregat, traktor, båt og varebil">
                <rect width="360" height="290" fill="#ebe7df" />
                <g stroke="#ffffff" stroke-width="1.5">
                    <path d="M0 30H360M0 60H360M0 90H360M0 120H360M0 150H360M0 180H360M0 210H360M0 240H360" />
                    <path d="M30 0V290M60 0V290M90 0V290M120 0V290M150 0V290M180 0V290M210 0V290M240 0V290M270 0V290M300 0V290M330 0V290" />
                </g>
                <rect x="20" y="70" width="55" height="45" fill="#d5e3c7" />
                <rect x="150" y="30" width="35" height="28" fill="#d5e3c7" />
                <rect x="285" y="150" width="75" height="60" fill="#d5e3c7" />
                <path d="M0 55 C 80 30, 150 20, 220 32 S 330 60, 360 42" fill="none" stroke="#f2dc9a" stroke-width="8" />
                <path d="M248 0 C 240 60, 262 110, 238 165 S 225 230, 232 262" fill="none" stroke="#a9cbe0" stroke-width="12" />
                <path d="M0 250 C 60 238, 110 262, 170 250 S 280 232, 360 245 V290 H0 Z" fill="#b7d3e3" />
                <circle cx="155" cy="135" r="24" fill="#d0d4d8" stroke="#6b7a8c" stroke-width="1.5" stroke-dasharray="4 3" />

                @{
                    var punkter = new[]
                    {
                        (X: 70, Y: 95, Fil: "tool", Tekst: "Aggregat"),
                        (X: 232, Y: 60, Fil: "vehicle", Tekst: "Varebil"),
                        (X: 272, Y: 118, Fil: "other", Tekst: "Grendehus"),
                        (X: 45, Y: 172, Fil: "vehicle", Tekst: "Traktor"),
                        (X: 220, Y: 180, Fil: "competence", Tekst: "Frivillige"),
                        (X: 278, Y: 200, Fil: "clothing", Tekst: "Ulltepper"),
                        (X: 118, Y: 215, Fil: "vehicle", Tekst: "Båt")
                    };
                }
                @foreach (var p in punkter)
                {
                    /// Heltall, så koordinatene ikke får desimalkomma med norsk tallformat
                    var bredde = p.Tekst.Length * 6 + 12;
                    <g>
                        <image href="@Url.Content($"~/images/resources/{p.Fil}.svg")" x="@(p.X - 11)" y="@(p.Y - 11)" width="22" height="22" />
                        <rect x="@(p.X + 14)" y="@(p.Y - 8)" width="@bredde" height="16" rx="2" fill="#ffffff" stroke="#dde3ea" />
                        <text x="@(p.X + 20)" y="@(p.Y + 3)" font-size="9" font-weight="700" fill="#04245a">@p.Tekst</text>
                    </g>
                }
            </svg>
        </div>
    </section>

    <!-- 3. Slik fungerer det -->
    <section class="fp-steps" id="slik-fungerer-det" aria-labelledby="stegTittel">
        <div class="fp-inner">
            <h2 id="stegTittel">Slik fungerer det</h2>
            <ol class="fp-steps-grid">
                <li>
                    <span class="num" aria-hidden="true">1</span>
                    <h3>Registrer det du har</h3>
                    <p>Fortell hva det er, og hvor det står.</p>
                </li>
                <li>
                    <span class="num" aria-hidden="true">2</span>
                    <h3>Beredskapen ser det</h3>
                    <p>Beredskapskoordinatorer ser hva som finnes i nærheten.</p>
                </li>
                <li>
                    <span class="num" aria-hidden="true">3</span>
                    <h3>Du blir kontaktet</h3>
                    <p>Trenger noen det du har, ringer de deg.</p>
                </li>
            </ol>
        </div>
    </section>

    <!-- 4. Hva kan du bidra med? -->
    <section class="fp-categories" id="bidra" aria-labelledby="bidraTittel">
        <div class="fp-inner">
            <h2 id="bidraTittel">Hva kan du bidra med?</h2>
            <p class="lead-text mb-0">Velg en kategori for å registrere.</p>
            <ul class="fp-category-grid">
                @foreach (var k in kategorier)
                {
                    <li>
                        <a asp-controller="Resource" asp-action="Index" asp-route-kategori="@k.Verdi">
                            <i class="fa-solid @k.Ikon cat-icon" aria-hidden="true"></i>
                            <div>
                                <strong>@k.Navn</strong>
                                <span>@k.Eksempler</span>
                            </div>
                            <i class="fa-solid fa-chevron-right chevron" aria-hidden="true"></i>
                        </a>
                    </li>
                }
                <li>
                    <a asp-controller="Resource" asp-action="Index">
                        <i class="fa-solid fa-plus cat-icon" aria-hidden="true"></i>
                        <div>
                            <strong>Usikker?</strong>
                            <span>Start, og velg kategori underveis</span>
                        </div>
                        <i class="fa-solid fa-chevron-right chevron" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </div>
    </section>

    <!-- 5. Egenberedskap -->
    <section class="fp-prepared" aria-labelledby="forberedtTittel">
        <div class="fp-inner fp-prepared-inner">
            <span class="warn" aria-hidden="true"><i class="fa-solid fa-triangle-exclamation"></i></span>
            <div>
                <h2 id="forberedtTittel">Er du forberedt på en krise?</h2>
                <p>Ha vann og mat nok til å klare deg selv i en uke. Les hva du bør ha hjemme, og finn tilfluktsrom i nærheten.</p>
            </div>
            <a class="fp-btn fp-btn-white" asp-controller="Home" asp-action="CrisisInformation">Les kriseinformasjon</a>
        </div>
    </section>

    <!-- 6. Spørsmål og svar -->
    <section class="fp-faq" id="sporsmal" aria-labelledby="sporsmalTittel">
        <div class="fp-faq-inner">
            <h2 id="sporsmalTittel">Spørsmål og svar</h2>
            <div class="fp-faq-list">
                <div class="fp-faq-item">
                    <button type="button" data-bs-toggle="collapse" data-bs-target="#svar1" aria-expanded="false" aria-controls="svar1">
                        Hvem kan registrere ressurser? <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div id="svar1" class="collapse">
                        <div class="answer">
                            Alle som lager en bruker: privatpersoner, gårdsbruk, bedrifter og frivillige organisasjoner. Kommunen og
                            beredskapskoordinatorene får konto av en administrator.
                        </div>
                    </div>
                </div>
                <div class="fp-faq-item">
                    <button type="button" data-bs-toggle="collapse" data-bs-target="#svar2" aria-expanded="false" aria-controls="svar2">
                        Hva skjer når noen trenger ressursen min? <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div id="svar2" class="collapse">
                        <div class="answer">
                            En koordinator kobler ressursen din til behovet. Du får et varsel i Beredt, og blir ringt opp på telefonnummeret
                            du har oppgitt. Du bestemmer selv om du kan stille.
                        </div>
                    </div>
                </div>
                <div class="fp-faq-item">
                    <button type="button" data-bs-toggle="collapse" data-bs-target="#svar3" aria-expanded="false" aria-controls="svar3">
                        Kan jeg endre eller fjerne det jeg har registrert? <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div id="svar3" class="collapse">
                        <div class="answer">
                            Ja. Under «Mine ressurser» kan du endre, merke som ikke tilgjengelig eller slette det du har registrert, når som helst.
                        </div>
                    </div>
                </div>
                <div class="fp-faq-item">
                    <button type="button" data-bs-toggle="collapse" data-bs-target="#svar4" aria-expanded="false" aria-controls="svar4">
                        Hva brukes opplysningene mine til? <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div id="svar4" class="collapse">
                        <div class="answer">
                            Bare til å finne og kontakte ressurser når det er behov for dem. Det er bare koordinatorer og administratorer som ser
                            telefonnummeret ditt. Les mer under <a asp-controller="Home" asp-action="Privacy">personvern</a>.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
