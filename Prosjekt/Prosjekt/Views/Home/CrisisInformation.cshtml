@{
    ViewData["Title"] = "Kriseinformasjon";
}

<style>
    /* Fjerner layoutens marger så det blå båndet går helt ut */
    main {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .crisis-page {
        background-color: #eff3f6;
        color: #0f2a4f;
        padding-bottom: 4rem;
    }

    .crisis-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .crisis-page a {
        color: #2d4f86;
        text-decoration: underline;
    }

    .crisis-page a:hover {
        color: #0f2a4f;
    }

    /* 1. Blått bånd med tittel og nødnummer */
    .crisis-hero {
        background-color: #04245a;
        color: #ffffff;
        padding: 2.75rem 0 2.25rem;
    }

    .crisis-hero h1 {
        color: #ffffff;
        font-size: 2.4rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin: 0 0 0.5rem;
    }

    .crisis-hero .intro {
        color: #d6deeb;
        font-size: 1.05rem;
        line-height: 1.5;
        max-width: 40rem;
        margin: 0 0 1.75rem;
    }

    .crisis-hero h2 {
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
    }

    .emergency-numbers {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.75rem;
    }

    .emergency-numbers a {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
        height: 100%;
        background-color: #ffffff;
        border-radius: 4px;
        border-top: 4px solid #8a9bb3;
        padding: 0.85rem 1rem 0.95rem;
        color: #0f2a4f !important;
        text-decoration: none !important;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .emergency-numbers a:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 10, 30, 0.35);
    }

    .emergency-numbers a:focus-visible {
        outline: 3px solid #ffffff;
        outline-offset: 2px;
    }

    .emergency-numbers strong {
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
    }

    .emergency-numbers span {
        color: #5f6f86;
        font-size: 0.9rem;
        line-height: 1.35;
    }

    /* De tre akutte numrene får rødt tall */
    .emergency-numbers li:nth-child(-n+3) a {
        border-top-color: #c8102e;
    }

    .emergency-numbers li:nth-child(-n+3) strong {
        color: #c8102e;
    }

    .emergency-numbers .call {
        margin-top: auto;
        padding-top: 0.5rem;
        color: #04245a;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .crisis-hero .net-note {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        background-color: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.22);
        border-radius: 4px;
        padding: 0.75rem 1rem;
        color: #ffffff;
        font-size: 0.92rem;
        line-height: 1.5;
        margin: 1.1rem 0 0;
    }

    .crisis-hero .net-note i {
        margin-top: 0.2rem;
        color: #ffffff;
    }

    /* 2. Kort under båndet */
    .crisis-card {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 1.5rem 1.6rem 1.6rem;
    }

    .crisis-card h2 {
        color: #0f2a4f;
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0 0 0.4rem;
    }

    .crisis-card .card-lead {
        color: #5f6f86;
        font-size: 0.95rem;
        line-height: 1.55;
        margin: 0 0 1.1rem;
    }

    .crisis-card p {
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .crisis-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        gap: 1.5rem;
        margin-top: 2rem;
        align-items: stretch;
    }

    /* Sjekkliste: vanlige avkrysningsbokser, telleren er bare CSS */
    .prep-list {
        list-style: none;
        margin: 0;
        padding: 0;
        counter-reset: klar;
    }

    .prep-list li {
        border-top: 1px solid #eef1f5;
    }

    .prep-list li:last-child {
        border-bottom: 1px solid #eef1f5;
    }

    .prep-list label {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 3.1rem;
        padding: 0.45rem 0.25rem;
        cursor: pointer;
        font-size: 0.98rem;
    }

    .prep-list label:hover {
        background-color: #f6f8fb;
    }

    .prep-list input {
        flex: 0 0 auto;
        width: 1.25rem;
        height: 1.25rem;
        accent-color: #04245a;
        cursor: pointer;
    }

    .prep-list input:checked {
        counter-increment: klar;
    }

    .prep-list label:has(input:checked) {
        background-color: #eef7f2;
    }

    .prep-count {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 1rem;
        color: #5f6f86;
        font-size: 0.85rem;
    }

    .prep-count .count::before {
        content: counter(klar) " av 6 på plass";
        color: #0f2a4f;
        font-weight: 700;
        font-size: 0.95rem;
    }

    .info-card .radio {
        display: flex;
        gap: 0.85rem;
        align-items: center;
        background-color: #eff3f6;
        border-radius: 4px;
        padding: 0.9rem 1rem;
        margin-bottom: 1rem;
    }

    .info-card .radio i {
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 50%;
        background-color: #04245a;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .info-card .radio strong {
        display: block;
        font-size: 1.05rem;
    }

    .info-card .radio span {
        color: #5f6f86;
        font-size: 0.88rem;
    }

    .link-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .link-list li {
        display: flex;
        flex-direction: column;
        padding: 0.7rem 0;
        border-top: 1px solid #eef1f5;
        font-size: 0.95rem;
    }

    .link-list li span {
        color: #5f6f86;
        font-size: 0.85rem;
    }

    .link-list a {
        font-weight: 600;
    }

    /* 3. Tilfluktsrom */
    .shelter-card {
        margin-top: 1.5rem;
    }

    .shelter-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .shelter-head .card-lead {
        margin: 0;
        max-width: 36rem;
    }

    .shelter-legend {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: #5f6f86;
        font-size: 0.88rem;
    }

    .shelter-legend i {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #c8102e;
        box-shadow: 0 0 0 2px #ffffff, 0 0 0 3px #dde3ea;
    }

    #tilfluktsromKart {
        width: 100%;
        height: 480px;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        background-color: #e7ecf2;
        position: relative;
    }

    /* Vises bare så lenge kartet er tomt */
    #tilfluktsromKart:empty::before {
        content: "";
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #5f6f86;
        font-size: 0.95rem;
    }

    .shelter-foot {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
        margin-top: 0.85rem;
    }

    .shelter-foot p {
        margin: 0;
        font-size: 0.88rem;
        color: #5f6f86;
    }

    .shelter-foot .map-status {
        color: #0f2a4f;
        font-weight: 600;
    }

    /* 4. Grønn boks nederst */
    .help-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
        background-color: #e3f1ea;
        border-color: #cfe6da;
    }

    .help-card p {
        margin: 0;
        max-width: 40rem;
    }

    .crisis-page a.btn-help {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #04245a;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.7rem 1.2rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .crisis-page a.btn-help:hover {
        background-color: #0f3a80;
        color: #ffffff;
    }

    @@media (max-width: 900px) {
        .emergency-numbers {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .crisis-grid {
            grid-template-columns: 1fr;
        }

        #tilfluktsromKart {
            height: 360px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .emergency-numbers a {
            transition: none;
        }

        .emergency-numbers a:hover {
            transform: none;
        }
    }

    @@media print {
        .crisis-hero {
            background: none;
            color: #000;
        }

        .crisis-hero h1,
        .crisis-hero h2,
        .crisis-hero .intro,
        .crisis-hero .net-note {
            color: #000;
        }

        #tilfluktsromKart,
        .help-card {
            display: none;
        }
    }
</style>

<div class="crisis-page">

    <!-- 1. Tittel og nødnummer -->
    <section class="crisis-hero" aria-labelledby="nodnummerTittel">
        <div class="crisis-inner">
            <h1>@ViewData["Title"]</h1>
            <p class="intro">Her finner du viktige nummer og råd for hva du kan gjøre før og under en krise.</p>

            <h2 id="nodnummerTittel">Nødnummer</h2>
            <ul class="emergency-numbers">
                <li><a href="tel:110"><strong>110</strong><span>Brann</span><span class="call"><i class="fa-solid fa-phone" aria-hidden="true"></i> Ring</span></a></li>
                <li><a href="tel:112"><strong>112</strong><span>Politi</span><span class="call"><i class="fa-solid fa-phone" aria-hidden="true"></i> Ring</span></a></li>
                <li><a href="tel:113"><strong>113</strong><span>Ambulanse</span><span class="call"><i class="fa-solid fa-phone" aria-hidden="true"></i> Ring</span></a></li>
                <li><a href="tel:116117"><strong>116 117</strong><span>Legevakt</span><span class="call"><i class="fa-solid fa-phone" aria-hidden="true"></i> Ring</span></a></li>
                <li><a href="tel:02800"><strong>02800</strong><span>Politiet, når det ikke haster</span><span class="call"><i class="fa-solid fa-phone" aria-hidden="true"></i> Ring</span></a></li>
            </ul>
            <p class="net-note"><i class="fa-solid fa-signal" aria-hidden="true"></i> Er mobilnettet nede kan du prøve å ringe nødnummer likevel, telefonen bruker da et annet nett hvis det finnes.</p>
        </div>
    </section>

    <div class="crisis-inner">

        <div class="crisis-grid">
            <!-- 2. Vær forberedt, som en sjekkliste -->
            <section class="crisis-card" aria-labelledby="forberedtTittel">
                <h2 id="forberedtTittel">Vær forberedt</h2>
                <p class="card-lead">DSB anbefaler at alle husstander skal klare seg selv i en uke hvis strøm, vann eller mobilnett blir borte. Det er lurt å ha:</p>
                <ul class="prep-list">
                    <li><label><input type="checkbox" /><span>Vann, ca. 3 liter per person per dag</span></label></li>
                    <li><label><input type="checkbox" /><span>Mat som holder seg lenge og ikke trenger strøm</span></label></li>
                    <li><label><input type="checkbox" /><span>Lommelykt, batterier og en DAB-radio på batteri</span></label></li>
                    <li><label><input type="checkbox" /><span>Medisiner du trenger, og førstehjelpsutstyr</span></label></li>
                    <li><label><input type="checkbox" /><span>Noe å varme seg med, som ullklær og soveposer</span></label></li>
                    <li><label><input type="checkbox" /><span>Litt kontanter</span></label></li>
                </ul>
                <div class="prep-count">
                    <span class="count" aria-hidden="true"></span>
                    <span>Kryss av det du har. Ingenting lagres.</span>
                </div>
            </section>

            <!-- Få informasjon -->
            <section class="crisis-card info-card" aria-labelledby="informasjonTittel">
                <h2 id="informasjonTittel">Få informasjon</h2>
                <div class="radio">
                    <i class="fa-solid fa-radio" aria-hidden="true"></i>
                    <div>
                        <strong>NRK P1 på radio</strong>
                        <span>Under en krise kommer viktige meldinger her.</span>
                    </div>
                </div>
                <p class="card-lead" style="margin-bottom: 0.4rem;">Andre steder du kan se:</p>
                <ul class="link-list">
                    <li><a href="https://www.sikkerhverdag.no" target="_blank" rel="noopener">sikkerhverdag.no</a><span>Råd om egenberedskap fra DSB</span></li>
                    <li><a href="https://www.dsb.no/egenberedskap" target="_blank" rel="noopener">dsb.no/egenberedskap</a><span>DSB sine sider om egenberedskap</span></li>
                    <li><strong style="font-weight: 600;">Kommunen din sin nettside</strong><span>Lokale beskjeder og hvor du får hjelp</span></li>
                </ul>
            </section>
        </div>

        <!-- 3. Kart over offentlige tilfluktsrom. Punktene fylles inn av scriptet nederst på siden. -->
        <section class="crisis-card shelter-card" aria-labelledby="tilfluktsromTittel">
            <div class="shelter-head">
                <div>
                    <h2 id="tilfluktsromTittel">Offentlige tilfluktsrom</h2>
                    <p class="card-lead">Trykk på et punkt for å se adresse og antall plasser.</p>
                </div>
                <span class="shelter-legend"><i aria-hidden="true"></i> Offentlig tilfluktsrom</span>
            </div>
            <div id="tilfluktsromKart" role="region" aria-label="Kart over offentlige tilfluktsrom i Norge"></div>
            <div class="shelter-foot">
                <p class="map-status" id="tilfluktsromStatus">Henter tilfluktsrom...</p>
                <p>Data fra DSB via <a href="https://kartkatalog.geonorge.no/metadata/tilfluktsrom-offentlige/dbae9aae-10e7-4b75-8d67-7f0e8828f3d8" target="_blank" rel="noopener">Geonorge</a>.</p>
            </div>
        </section>

        <!-- 4. Har du noe som kan hjelpe? -->
        <section class="crisis-card help-card" aria-labelledby="hjelpeTittel">
            <div>
                <h2 id="hjelpeTittel">Har du noe som kan hjelpe?</h2>
                <p>Har du utstyr, kjøretøy eller annet som kan være nyttig i en krise kan du lage en bruker og registrere det som en ressurs. Da kan kriseledelsen se det og ta kontakt.</p>
            </div>
            <a class="btn-help" asp-controller="Account" asp-action="Register">Lag bruker <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </section>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.CspNonce()">
        document.addEventListener("DOMContentLoaded", function () {
            // DSB sin tjeneste for offentlige tilfluktsrom (publisert på Geonorge)
            const DSB_URL = "https://ogc.dsb.no/wms.ashx";
            const LAG = "layer_340";
            const statusTekst = document.getElementById("tilfluktsromStatus");

            // Lager kartet med hele Norge i bildet, og Kartverkets topografiske kart som bakgrunn.
            // Kartet holdes rundt Norge, der Kartverket har kart og tilfluktsrommene ligger.
            // Grensene og noWrap gjør også at man ikke kan dra seg inn i kopier av verden.
            const kart = L.map("tilfluktsromKart", {
                minZoom: 4,
                maxBounds: [[54, -5], [74, 40]],
                maxBoundsViscosity: 1.0
            }).setView([64.5, 12], 4);
            L.tileLayer("https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png", {
                maxZoom: 18,
                noWrap: true,
                attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a> | Tilfluktsrom: DSB'
            }).addTo(kart);

            // Tjenesten gir bare koordinater i UTM sone 33 (EPSG:32633), men Leaflet trenger
            // breddegrad/lengdegrad. Denne funksjonen regner om med standard UTM-formler.
            // Inn: øst- og nordverdi i meter. Ut: [breddegrad, lengdegrad].
            function utm33TilLatLng(easting, northing) {
                const a = 6378137, f = 1 / 298.257223563, k0 = 0.9996;
                const e2 = f * (2 - f), ep2 = e2 / (1 - e2);
                const e1 = (1 - Math.sqrt(1 - e2)) / (1 + Math.sqrt(1 - e2));
                const x = easting - 500000, lon0 = 15 * Math.PI / 180;
                const mu = (northing / k0) / (a * (1 - e2 / 4 - 3 * e2 * e2 / 64 - 5 * e2 * e2 * e2 / 256));
                const phi1 = mu
                    + (3 * e1 / 2 - 27 * Math.pow(e1, 3) / 32) * Math.sin(2 * mu)
                    + (21 * e1 * e1 / 16 - 55 * Math.pow(e1, 4) / 32) * Math.sin(4 * mu)
                    + (151 * Math.pow(e1, 3) / 96) * Math.sin(6 * mu)
                    + (1097 * Math.pow(e1, 4) / 512) * Math.sin(8 * mu);
                const sin = Math.sin(phi1), cos = Math.cos(phi1), tan = Math.tan(phi1);
                const N1 = a / Math.sqrt(1 - e2 * sin * sin);
                const R1 = a * (1 - e2) / Math.pow(1 - e2 * sin * sin, 1.5);
                const T1 = tan * tan, C1 = ep2 * cos * cos, D = x / (N1 * k0);
                const lat = phi1 - (N1 * tan / R1) * (D * D / 2
                    - (5 + 3 * T1 + 10 * C1 - 4 * C1 * C1 - 9 * ep2) * Math.pow(D, 4) / 24
                    + (61 + 90 * T1 + 298 * C1 + 45 * T1 * T1 - 252 * ep2 - 3 * C1 * C1) * Math.pow(D, 6) / 720);
                const lon = lon0 + (D - (1 + 2 * T1 + C1) * Math.pow(D, 3) / 6
                    + (5 - 2 * C1 + 28 * T1 - 3 * C1 * C1 + 8 * ep2 + 24 * T1 * T1) * Math.pow(D, 5) / 120) / cos;
                return [lat * 180 / Math.PI, lon * 180 / Math.PI];
            }

            // Bygger popup med textContent så tekst fra tjenesten ikke tolkes som HTML
            function lagPopup(adresse, plasser, romnr) {
                const div = document.createElement("div");
                const tittel = document.createElement("strong");
                tittel.textContent = adresse || "Ukjent adresse";
                div.appendChild(tittel);
                div.appendChild(document.createElement("br"));
                div.appendChild(document.createTextNode("Plasser: " + (plasser || "ukjent")));
                div.appendChild(document.createElement("br"));
                div.appendChild(document.createTextNode("Romnr: " + (romnr || "ukjent")));
                return div;
            }

            // Hvis punktene ikke kan hentes, vis i det minste DSB sitt kartlag som bilde
            function visReservelag() {
                L.tileLayer.wms(DSB_URL, {
                    layers: LAG,
                    format: "image/png",
                    transparent: true,
                    version: "1.3.0",
                    noWrap: true
                }).addTo(kart);
                statusTekst.textContent = "Kunne ikke hente detaljer om tilfluktsrommene. Kartet viser plasseringene, men uten adresse og plasser.";
            }

            // Henter alle tilfluktsrom fra DSB (WFS). Svaret er XML med adresse, plasser, romnr og posisjon.
            const wfsUrl = `${DSB_URL}?SERVICE=WFS&VERSION=1.1.0&REQUEST=GetFeature&TYPENAME=${LAG}`;

            fetch(wfsUrl)
                .then(svar => {
                    if (!svar.ok) throw new Error("HTTP " + svar.status);
                    return svar.text();
                })
                .then(tekst => {
                    // Leser XML-svaret og finner hvert tilfluktsrom
                    const xml = new DOMParser().parseFromString(tekst, "application/xml");
                    const MS = "http://mapserver.gis.umn.edu/mapserver";
                    const GML = "http://www.opengis.net/gml";
                    const rom = xml.getElementsByTagNameNS(MS, LAG);
                    if (rom.length === 0) throw new Error("Ingen tilfluktsrom i svaret");

                    // Henter teksten i et felt (f.eks. "adresse") for ett tilfluktsrom
                    const felt = (el, navn) => el.getElementsByTagNameNS(MS, navn)[0]?.textContent?.trim() || "";
                    const markorer = [];
                    let totaltPlasser = 0;

                    // Lager en rød prikk med popup for hvert tilfluktsrom, og hopper over de uten gyldig posisjon
                    for (const el of rom) {
                        const pos = el.getElementsByTagNameNS(GML, "pos")[0]?.textContent?.trim().split(/\s+/).map(Number);
                        if (!pos || pos.length < 2 || pos.some(isNaN)) continue;

                        const plasser = felt(el, "plasser");
                        totaltPlasser += parseInt(plasser, 10) || 0;

                        markorer.push(
                            L.circleMarker(utm33TilLatLng(pos[0], pos[1]), {
                                radius: 6,
                                color: "#ffffff",
                                weight: 1.5,
                                fillColor: "#c8102e",
                                fillOpacity: 0.9
                            }).bindPopup(lagPopup(felt(el, "adresse"), plasser, felt(el, "romnr")))
                        );
                    }

                    // Legger alle prikkene på kartet, zoomer så alle synes, og viser totalen under kartet
                    const gruppe = L.featureGroup(markorer).addTo(kart);
                    kart.fitBounds(gruppe.getBounds(), { padding: [20, 20] });
                    statusTekst.textContent = `${markorer.length} offentlige tilfluktsrom med til sammen ${totaltPlasser.toLocaleString("nb-NO")} plasser.`;
                })
                // Hvis noe går galt (nettverk, feil fra DSB, tomt svar), bruk reservelaget i stedet
                .catch(feil => {
                    console.error("Kunne ikke hente tilfluktsrom:", feil);
                    visReservelag();
                });
        });
    </script>
}
