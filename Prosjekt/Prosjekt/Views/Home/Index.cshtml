@{
    ViewData["Title"] = "Hjem - Kartoversikt";
}

<style>
    /* Strekker kartet slik at det fyller hovedskjermen rent uten marginer */
    main {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
    }

    /* Tvinger Leaflets øvre høyre hjørne til å legge kontrollene ved siden av hverandre */
    .leaflet-top.leaflet-right {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-start;
        gap: 10px;
    }

    /* Styling for Symbol Info-knappen */
    .info-btn {
        background-color: white;
        border: 2px solid rgba(0,0,0,0.2);
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        white-space: nowrap;
    }

        .info-btn:hover {
            background-color: #f4f4f4;
        }

    /* Styling for infoboksen */
    .info-box {
        background: white;
        padding: 16px 20px;
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.3);
        font-size: 1rem;
        min-width: 250px;
    }

        .info-box ul {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
        }

        .info-box li {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

    .color-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
        flex-shrink: 0;
    }
</style>

<!-- Kartbeholder -->
<div id="homeMap" style="height: calc(100vh - 80px); width: 100%; margin: 0; padding: 0;"></div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            // 1. Definer kartlagene med noWrap
            var osmKart = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                noWrap: true
            });

            var geonorgeTopo = L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
                attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>',
                noWrap: true
            });

            var geonorgeFlybilder = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: '&copy; Midlertidig satellitt (Esri) - Venter på Geonorge-tilgang',
                noWrap: true
            });

            // 2. Start kartet med grenser og fast verden
            var map = L.map('homeMap', {
                center: [58.1467, 7.9956],
                zoom: 11,
                minZoom: 3,
                maxBounds: [
                    [-90, -180],
                    [90, 180]
                ],
                maxBoundsViscosity: 1.0,
                layers: [osmKart]
            });

            // 3. Lag menyen i hjørnet for å bytte bakgrunnskart
            var bakgrunnsKart = {
                "Standard (OSM)": osmKart,
                "Topografisk (Geonorge)": geonorgeTopo,
                "Flybilder (Geonorge)": geonorgeFlybilder
            };
            L.control.layers(bakgrunnsKart).addTo(map);

            // --- SYMBOL INFO KNAPP OG BOKS ---
            var symbolInfoControl = L.control({ position: 'topright' });

            symbolInfoControl.onAdd = function (map) {
                var div = L.DomUtil.create('div', 'leaflet-bar');
                div.style.border = 'none';
                div.style.boxShadow = 'none';

                div.innerHTML = `
                    <button id="toggleInfoBtn" class="info-btn">Fargekoder - Markør</button>
                    <div id="infoBoxContainer" class="info-box d-none mt-2">
                        <strong style="font-size: 1.05rem;">Fargekoder - Markør</strong>
                        <hr class="my-2">
                        <ul>
                            <li><span class="color-dot" style="background-color: #dc3545;"></span> Rød: Akutte behov</li>
                            <li><span class="color-dot" style="background-color: #ffc107;"></span> Gul: Planlagte behov</li>
                            <li><span class="color-dot" style="background-color: #0d6efd;"></span> Blå: Offentlige aktører</li>
                            <li><span class="color-dot" style="background-color: #198754;"></span> Grønn: Tilgjengelige ressurser</li>
                            <li><span class="color-dot" style="background-color: #6c757d;"></span> Grå: Utilgjengelige ressurser</li>
                        </ul>
                    </div>
                `;

                L.DomEvent.disableClickPropagation(div);
                return div;
            };

            symbolInfoControl.addTo(map);

            document.getElementById('toggleInfoBtn').addEventListener('click', function () {
                var infoBox = document.getElementById('infoBoxContainer');
                infoBox.classList.toggle('d-none');
            });

            var bounds = [];

            // Hjelpefunksjon for å formatere areal
            function formaterAreal(sqm) {
                if (!sqm) return '';
                if (sqm >= 1000000) {
                    return (sqm / 1000000).toFixed(2) + ' km²';
                }
                return Math.round(sqm).toLocaleString('no-NO') + ' m²';
            }

            // Hjelpefunksjon for å generere fargede ikoner for Behov
            function getIkon(fargeNavn) {
                return new L.Icon({
                    iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                    iconSize: [25, 41],
                    iconAnchor: [12, 41],
                    popupAnchor: [1, -34],
                    shadowSize: [41, 41]
                });
            }

            var behovIkoner = {
                0: getIkon('red'),    // Akutt
                1: getIkon('gold')   // Planlagt
            };

            try {
                // 4. Hent ressurser
                const resResponse = await fetch('/Resource/GetInformasjon');
                if (resResponse.ok) {
                    const resourcesData = await resResponse.json();

                    resourcesData.forEach(function (res) {
                        var lat = parseFloat(res.latitude || res.Latitude);
                        var lng = parseFloat(res.longitude || res.Longitude);

                        if (!isNaN(lat) && !isNaN(lng)) {
                            var status = (res.availability || res.Availability)
                                ? '<span class="badge bg-success">Tilgjengelig</span>'
                                : '<span class="badge bg-danger">Ikke tilgjengelig</span>';

                            var marker = L.marker([lat, lng]).addTo(map);
                            marker.bindPopup(`
                                <div style="font-size: 0.9rem;">
                                    <strong style="color: #0d6efd;">📦 RESSURS</strong><br/>
                                    <b>${res.name || res.Name || 'Uten navn'}</b> (${res.quantity || res.Quantity || 1} stk)<br/>
                                    📞 Tlf: ${res.phoneNumber || res.PhoneNumber || 'Ikke oppgitt'}<br/>
                                    Status: ${status}
                                </div>
                            `);
                            bounds.push([lat, lng]);
                        }
                    });
                }

                // 5. Hent behov (Inkludert inntegnede figurer/områder)
                const needResponse = await fetch('/Need/GetInformasjon');
                if (needResponse.ok) {
                    const needsData = await needResponse.json();

                    needsData.forEach(function (need) {
                        var lat = parseFloat(need.latitude || need.Latitude);
                        var lng = parseFloat(need.longitude || need.Longitude);
                        var importance = need.importance !== undefined ? need.importance : need.Importance;
                        var areaGeoJson = need.areaGeoJson || need.AreaGeoJson;
                        var areaSquareMeters = need.areaSquareMeters || need.AreaSquareMeters;

                        // Teksten som skal vises når du trykker på enten området eller markøren
                        var popupInnhold = `
                            <div style="font-size: 0.9rem;">
                                <strong style="color: #dc3545;">🆘 BEHOV</strong><br/>
                                <b>${need.name || need.Name || 'Uten navn'}</b><br/>
                                ${(need.description || need.Description) ? (need.description || need.Description) + '<br/>' : ''}
                                ${areaSquareMeters ? '<b>Areal:</b> ca. ' + formaterAreal(areaSquareMeters) + '<br/>' : ''}
                                📞 Tlf: ${need.phone || need.Phone || 'Ikke oppgitt'}
                            </div>
                        `;

                        var harOmrade = false;

                        // --- TEGN FIGUR / OMÅDE DERSOM GEOJSON FINNES ---
                        if (areaGeoJson) {
                            try {
                                var parsedGeoJson = typeof areaGeoJson === 'string' ? JSON.parse(areaGeoJson) : areaGeoJson;

                                var omrade = L.geoJSON(parsedGeoJson, {
                                    style: {
                                        color: importance === 0 ? '#dc3545' : '#fd7e14',
                                        weight: 2,
                                        fillOpacity: 0.25
                                    }
                                }).addTo(map);

                                // Fest infoboksen direkte til området ved klikk
                                omrade.bindPopup(popupInnhold);

                                if (areaSquareMeters) {
                                    omrade.bindTooltip(
                                        `${need.name || need.Name || 'Område'}: ca. ${formaterAreal(areaSquareMeters)}`,
                                        { sticky: true }
                                    );
                                }

                                // Hent ut grensene (bounds) til området slik at kartzoomen tilpasser seg
                                bounds.push(omrade.getBounds());
                                harOmrade = true;

                            } catch (err) {
                                console.error("Feil ved innlasting av GeoJSON-figur:", err);
                            }
                        }

                        // --- KUN VIS MARKØR DERSOM DET IKKE FINNES ET INNTEGNET OMÅDE ---
                        if (!harOmrade && !isNaN(lat) && !isNaN(lng)) {
                            var chosenIcon = behovIkoner[importance] || behovIkoner[1];

                            var marker = L.marker([lat, lng], { icon: chosenIcon }).addTo(map);
                            marker.bindPopup(popupInnhold);

                            bounds.push([lat, lng]);
                        }
                    });
                }

                // 6. Tilpass kartzoomen dersom det finnes markører eller områder
                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });
                }

            } catch (error) {
                console.error("Feil ved henting av kartdata:", error);
            }

            setTimeout(function () {
                map.invalidateSize();
            }, 200);
        });
    </script>
}