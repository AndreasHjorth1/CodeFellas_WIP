@model IEnumerable<Prosjekt.Models.ModelView.GeoChangeViewModel>

@{
    ViewData["Title"] = "Hjem - Geografiske Hendelser";
}

<!-- CSS for å tvinge innholdet helt ut i kantene (Fjerner ASP.NET standard marger) -->
<style>
    main {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
    }
</style>

<!-- Kartbeholder som dekker hele det tilgjengelige området -->
<div id="homeMap" style="height: calc(100vh - 80px); width: 100%; margin: 0; padding: 0;"></div>

@section Scripts {
    <script>
        // 1. Definer kartlagene
        // Vanlig gatekart (OpenStreetMap)
        var osmKart = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            noWrap: true // Stopper uendelig repetisjon av kartet
        });

        // Geonorge: Topografisk kart 
        var geonorgeTopo = L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
            attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>',
            noWrap: true // Stopper uendelig repetisjon av kartet
        });

        // Geonorge: Flybilder (Ortofoto via WMS)
        // TODO: Bytt til wms.geonorge.no/skwms1/wms.nib og legg inn token etter Q&A med Kartverket
        var geonorgeFlybilder = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: '&copy; Midlertidig satellitt (Esri) - Venter på Geonorge-tilgang',
            noWrap: true // Stopper uendelig repetisjon av kartet
        });

        // 2. Start kartet og legg til standardkartet (OSM)
        var map = L.map('homeMap', {
            center: [58.1467, 7.9956], // Sentrert over Agder
            zoom: 11,
            minZoom: 3, // Hindrer brukeren i å zoome for langt ut
            maxBounds: [
                [-90, -180], // Sør-vestligste punkt i verden
                [90, 180]    // Nord-østligste punkt i verden
            ],
            maxBoundsViscosity: 1.0, // Gjør kartkanten "solid" slik at man ikke kan dra kartet utenfor grensene
            layers: [osmKart]
        });

        // 3. Lag menyen oppe i hjørnet for å bytte kart
        var bakgrunnsKart = {
            "Standard (OSM)": osmKart,
            "Topografisk (Geonorge)": geonorgeTopo,
            "Flybilder (Geonorge)": geonorgeFlybilder
        };
        L.control.layers(bakgrunnsKart).addTo(map);

        // 4. Logikk for å tegne markører og sirkler fra databasen
        var positions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        var bounds = [];

        if (positions && positions.length > 0) {
            positions.forEach(function(pos) {
                var lat = parseFloat(pos.Latitude);
                var lng = parseFloat(pos.Longitude);
                var radius = parseFloat(pos.Radius);
                
                if (!isNaN(lat) && !isNaN(lng)) {
                    var changeTypesText = (pos.SelectedChangeTypes && pos.SelectedChangeTypes.length > 0) 
                        ? pos.SelectedChangeTypes.join(', ') 
                        : 'Ingen angitt';

                    // Tegn markør med popup
                    L.marker([lat, lng])
                        .bindPopup('<b>' + pos.Description + '</b><br><b>Endringstype:</b> ' + changeTypesText + '<br><b>Radius:</b> ' + radius + ' m')
                        .addTo(map);
                    
                    // Tegn radius-sirkel
                    if (!isNaN(radius) && radius > 0) {
                        L.circle([lat, lng], {
                            radius: radius,
                            color: '#3388ff',
                            fillColor: '#3388ff',
                            fillOpacity: 0.2
                        }).addTo(map);
                    }

                    bounds.push([lat, lng]);
                }
            });
        }

        // Juster kartet slik at alle hendelser er synlige
        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        }

        // 5. Fikser grå fliser ved innlasting av Leaflet
        setTimeout(function() {
            map.invalidateSize();
        }, 300);

        // 6. Gjør at kartet dynamisk tilpasser seg hvis brukeren endrer vindusstørrelsen
        const mapContainer = document.getElementById('homeMap');
        if (mapContainer) {
            const resizeObserver = new ResizeObserver(function() {
                map.invalidateSize();
            });
            resizeObserver.observe(mapContainer);
        }
    </script>
}