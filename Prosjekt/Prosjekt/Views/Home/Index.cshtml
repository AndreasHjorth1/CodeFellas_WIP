@using Prosjekt.Models.Authorization
@using Prosjekt.Models.Enums
@using Prosjekt.Models.ModelView

<link rel="stylesheet" href="~/css/map-symbols.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.Default.css" asp-append-version="true" />
﻿@{
    ViewData["Title"] = "Hjem - Kartoversikt";
    var erAdmin = User.IsInRole(RoleNames.Admin);

    /// Satt av «Stort kart» på ressursoversikten, så man finner tilbake dit
    var fraOversikt = Context.Request.Query["fra"] == "oversikt";

    /// Satt av «Åpne stort kart» på admin-forsiden
    var stortKart = Context.Request.Query["visning"] == "kart";

    /// Admin får oversiktssiden med kart og «Trenger handling». Ellers vises kartet i fullskjerm.
    var visDashboard = erAdmin && !fraOversikt && !stortKart;
    if (visDashboard)
    {
        ViewData["Title"] = "Oversikt";
    }

    var behovTyper = Html.GetEnumSelectList<NeedViewModel.NeedType>().ToDictionary(i => i.Value, i => i.Text);
}

<style>
    /* Tvinger Leaflets øvre høyre hjørne til å legge kontrollene ved siden av hverandre */
    .leaflet-top.leaflet-right {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-start;
        gap: 10px;
    }

    /* Pil som vises at filteret er kollapsbart + animasjon */
    .filter-pil {
        transition: transform 0.5s ease;
    }

    [aria-expanded="false"] .filter-pil {
        transform: rotate(-90deg);
    }
    /* Fjern blå fokusring på filterknappen ved museklikk */
    #filterPanel .btn:focus:not(:focus-visible) {
        box-shadow: none;
    }
    /* Strekker kartet slik at det fyller hovedskjermen rent uten marginer */
    main {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
    }

    /* Tvinger Leaflets øvre høyre hjørne til å legge kontrollene ved siden av hverandre */
    .leaflet-top.leaflet-right {
        display: flex;
        flex-direction: row-reverse;
        align-items: flex-start;
        gap: 10px;
    }

    /* Styling for Symbol Info-knappen */
    .info-btn {
        background-color: white;
        border: 2px solid rgba(0,0,0,0.2);
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 1rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        white-space: nowrap;
    }

        .info-btn:hover {
            background-color: #f4f4f4;
        }

    /* Styling for infoboksen */
    .info-box {
        background: white;
        padding: 16px 20px;
        border-radius: 8px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.3);
        font-size: 1rem;
        min-width: 250px;
    }

        .info-box ul {
            list-style: none;
            padding-left: 0;
            margin-bottom: 0;
        }

        .info-box li {
            margin-bottom: 8px;
            display: flex;
            align-items: center;
        }

    .color-dot {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 10px;
        flex-shrink: 0;
    }

    /* Tilbakeknapp øverst på midten når man kommer fra ressursoversikten */
    .back-to-overview {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background-color: #04245a;
        color: #ffffff;
        border-radius: 3px;
        padding: 0.55rem 1rem;
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
        white-space: nowrap;
    }

    .back-to-overview:hover,
    .back-to-overview:focus {
        background-color: #0f3a80;
        color: #ffffff;
    }

    /* --- Admin-forsiden --- */
    .dashboard-page {
        background-color: #eef1f5;
        min-height: 100%;
    }

    .dashboard {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem 1.5rem 2.5rem;
        color: #0b1f3a;
    }

    .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .dashboard-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
    }

    .dashboard-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .dash-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.7rem 1.4rem;
        border-radius: 3px;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        border: 1px solid #c9d1dc;
        background-color: #ffffff;
        color: #0b1f3a;
    }

    .dash-btn:hover {
        background-color: #f4f6f9;
        color: #0b1f3a;
    }

    .dash-btn.primary {
        background-color: #04245a;
        border-color: #04245a;
        color: #ffffff;
    }

    .dash-btn.primary:hover {
        background-color: #0f3a80;
        color: #ffffff;
    }

    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .stat-card {
        display: flex;
        align-items: flex-start;
        gap: 0.9rem;
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        padding: 0.9rem 1.1rem;
    }

    .stat-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .stat-icon.acute { background-color: #c8102e; }
    .stat-icon.planned { background-color: #f2b705; }
    .stat-icon.available { background-color: #1e7a4c; }

    .stat-number {
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #5b6b7f;
    }

    .dashboard-main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 0.9rem;
    }

    /* Kartet følger med når man blar i «Trenger handling». top = høyden på navbaren + litt luft */
    .dashboard-map-card {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        overflow: hidden;
        position: sticky;
        top: 80px;
        align-self: start;
    }

    /* Høyden er tilpasset så hele siden får plass uten å bla */
    #homeMap.dashboard-map {
        height: calc(100vh - 330px);
        min-height: 300px;
        width: 100%;
    }

    .map-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        padding: 0.6rem 0.9rem;
        font-size: 0.8rem;
        font-weight: 600;
        border-top: 1px solid #dde3ea;
    }

    .map-legend span {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .action-panel {
        display: flex;
        flex-direction: column;
        min-height: 0;
    }

    .action-panel-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 0.6rem;
    }

    .action-panel-header h2 {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
    }

    .action-panel-header a {
        font-size: 0.85rem;
        font-weight: 600;
        color: #0b1f3a;
    }

    .action-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .need-card {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-left: 3px solid transparent;
        border-radius: 4px;
        padding: 0.8rem 0.9rem 0.7rem;
        cursor: pointer;
    }

    .need-card:hover {
        border-color: #b9c4d2;
    }

    .need-card.acute {
        border-left-color: #c8102e;
    }

    .need-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .need-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.15rem 0.45rem;
        border-radius: 2px;
    }

    .need-badge.acute {
        background-color: #c8102e;
        color: #ffffff;
    }

    .need-badge.planned {
        border: 1px solid #f2b705;
        color: #0b1f3a;
    }

    .need-time {
        font-family: ui-monospace, Consolas, monospace;
        font-size: 0.75rem;
        color: #5b6b7f;
    }

    .need-title {
        font-weight: 700;
        font-size: 0.95rem;
        margin-bottom: 0.1rem;
    }

    .need-title a {
        color: inherit;
        text-decoration: none;
    }

    .need-title a:hover {
        text-decoration: underline;
    }

    .need-sub {
        font-size: 0.8rem;
        color: #5b6b7f;
        margin-bottom: 0.6rem;
    }

    .need-progress {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 4px;
    }

    .need-progress .bar {
        height: 3px;
        background-color: #dde3ea;
        border-radius: 2px;
    }

    .need-progress .bar.done {
        background-color: #04245a;
    }

    .need-progress .step {
        font-size: 0.72rem;
        color: #0b1f3a;
        margin-top: 0.3rem;
    }

    .need-progress .step:last-child {
        text-align: right;
    }

    .action-empty {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        padding: 1rem;
        font-size: 0.9rem;
        color: #5b6b7f;
    }

    @@media (max-width: 991px) {
        .dashboard-main {
            grid-template-columns: 1fr;
        }

        /* På smale skjermer ligger listen under kartet, så kartet skal ikke følge med */
        .dashboard-map-card {
            position: static;
        }

        #homeMap.dashboard-map {
            height: 420px;
        }
    }

    @@media (max-width: 575px) {
        .stat-row {
            grid-template-columns: 1fr;
        }
    }
</style>

@if (visDashboard)
{
    <div class="dashboard-page">
        <div class="dashboard">

            <div class="dashboard-header">
                <h1>Velkommen</h1>
                <div class="dashboard-actions">
                    <a class="dash-btn" asp-controller="Resource" asp-action="Overview">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Finn ressurser
                    </a>
                    <a class="dash-btn primary" asp-controller="Need" asp-action="Index">
                        <i class="fa-solid fa-plus" aria-hidden="true"></i> Meld behov
                    </a>
                </div>
            </div>

            <div class="stat-row">
                <div class="stat-card">
                    <span class="stat-icon acute"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i></span>
                    <div>
                        <div class="stat-number" id="antallAkutte">–</div>
                        <div class="stat-label">akutte behov</div>
                    </div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon planned"><i class="fa-regular fa-clock" aria-hidden="true"></i></span>
                    <div>
                        <div class="stat-number" id="antallPlanlagte">–</div>
                        <div class="stat-label">planlagte behov</div>
                    </div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon available"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                    <div>
                        <div class="stat-number" id="antallLedige">–</div>
                        <div class="stat-label">ledige ressurser</div>
                    </div>
                </div>
            </div>

            <div class="dashboard-main">
                <div class="dashboard-map-card">
                    <div id="homeMap" class="dashboard-map"></div>
                    <div class="map-legend">
                        <span><i class="fa-solid fa-location-dot" style="color: #c8102e;" aria-hidden="true"></i> Akutt behov</span>
                        <span><i class="fa-regular fa-clock" style="color: #f2b705;" aria-hidden="true"></i> Planlagt behov</span>
                        <span><i class="fa-regular fa-circle-check" style="color: #1e7a4c;" aria-hidden="true"></i> Ledig ressurs</span>
                        <span><i class="fa-solid fa-shield-halved" style="color: #0d4fb3;" aria-hidden="true"></i> Offentlig aktør</span>
                    </div>
                </div>

                <section class="action-panel" aria-labelledby="trengerHandlingTittel">
                    <div class="action-panel-header">
                        <h2 id="trengerHandlingTittel">Trenger handling</h2>
                        <a asp-controller="Home" asp-action="Index" asp-route-visning="kart">Åpne stort kart</a>
                    </div>
                    <div class="action-list" id="trengerHandlingListe">
                        <div class="action-empty">Henter behov...</div>
                    </div>
                </section>
            </div>

        </div>
    </div>
}
else
{
    <!-- Kartbeholder -->
    <div class="position-relative">
        <div id="homeMap" style="height: calc(100vh - 80px); width: 100%; margin: 0; padding: 0;"></div>
        @if (fraOversikt)
        {
            <a asp-controller="Resource" asp-action="Overview" class="back-to-overview">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                @(erAdmin ? "Tilbake til oversikten" : "Tilbake til Mine ressurser")
            </a>
        }
        else if (stortKart && erAdmin)
        {
            <a asp-controller="Home" asp-action="Index" class="back-to-overview">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                Tilbake til oversikten
            </a>
        }
    </div>
}
@if (erAdmin && !visDashboard)
{
    <div id="filterPanel" class="bg-white shadow rounded" style="width: 260px; display: none;">

        <button class="btn btn-sm text-dark text-decoration-none fw-bold w-100 text-start d-flex justify-content-between align-items-center px-3 py-2"
                type="button" data-bs-toggle="collapse" data-bs-target="#filterKropp"
                aria-expanded="false" aria-controls="filterKropp">
            <span>🎛️ Filter</span>
            <span class="filter-pil">▾</span>
        </button>

        <div class="collapse" id="filterKropp">
            <div class="px-3 pb-3">

                <label class="form-label small mb-1">Vis</label>
                <select id="visFilter" class="form-select form-select-sm mb-2">
                    <option value="">Alt</option>
                    <option value="behov">Bare behov</option>
                    <option value="ressurs">Bare ressurser</option>
                </select>

                <label class="form-label small mb-1">Kategori</label>
                <select id="kategoriFilter" class="form-select form-select-sm mb-2">
                    <option value="">Alle</option>
                    <optgroup label="Behov">
                        @foreach (var i in Html.GetEnumSelectList<NeedViewModel.NeedType>())
                        {
                            <option value="behov:@i.Value">@i.Text</option>
                        }
                    </optgroup>
                    <optgroup label="Ressurser">
                        @foreach (var i in Html.GetEnumSelectList<ResourceViewModel.ResourceType>())
                        {
                            <option value="ressurs:@i.Value">@i.Text</option>
                        }
                    </optgroup>
                </select>

                <label class="form-label small mb-1">Tilgjengelighet <span class="text-muted">(ressurs)</span></label>
                <select id="tilgjengelighetFilter" class="form-select form-select-sm mb-2">
                    <option value="">Alle</option>
                    <option value="true">Tilgjengelig</option>
                    <option value="false">Ikke tilgjengelig</option>
                </select>

                <label class="form-label small mb-1">Status <span class="text-muted">(behov)</span></label>
                <select id="statusFilter" class="form-select form-select-sm mb-2">
                    <option value="">Alle</option>
                    @foreach (var i in Html.GetEnumSelectList<EntryStatus>())
                    {
                        <option value="@i.Value">@i.Text</option>
                    }
                </select>

                <label class="form-label small mb-1">Viktighet <span class="text-muted">(behov)</span></label>
                <select id="viktighetFilter" class="form-select form-select-sm">
                    <option value="">Alle</option>
                    @foreach (var i in Html.GetEnumSelectList<ImportanceLevel>())
                    {
                        <option value="@i.Value">@i.Text</option>
                    }
                </select>
                <label class="form-label small mb-1 mt-2">Innenfor omkrets</label>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" id="velgPunktBtn" class="btn btn-outline-primary btn-sm text-nowrap">
                        📍 Velg punkt
                    </button>
                    <input type="number" id="radiusFelt" class="form-control form-control-sm"
                           value="5" min="1" max="500" step="1" style="max-width: 80px;" />
                    <span class="small text-muted">km</span>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/map-symbols.js" data-resources-url="@Url.Content("~/images/resources/")" data-needs-url="@Url.Content("~/images/needs/")" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            /// 1. Definer kartlagene med noWrap
            var osmKart = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                noWrap: true
            });

            var geonorgeTopo = L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
                attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>',
                noWrap: true
            });

            var geonorgeFlybilder = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
                attribution: '&copy; Midlertidig satellitt (Esri) - Venter på Geonorge-tilgang',
                noWrap: true
            });
            /// Alle kartlag med egenskapene vi filtrerer på
            var kartElementer = [];

            function filtrerKart() {

                var tilg = document.getElementById('tilgjengelighetFilter')?.value ?? '';
                var vis = document.getElementById('visFilter')?.value ?? '';
                var kat = document.getElementById('kategoriFilter')?.value ?? '';
                var sta = document.getElementById('statusFilter')?.value ?? '';
                var vik = document.getElementById('viktighetFilter')?.value ?? '';

                kartElementer.forEach(function(e) {
                    var synlig = true;

                    /// radiusSenter og radiusMeter settes av settOppRadiusSok i site.js
                    if (radiusSenter && !isNaN(e.lat) && !isNaN(e.lng)) {
                        if (radiusSenter.distanceTo(L.latLng(e.lat, e.lng)) > radiusMeter) synlig = false;
                    }

                    if (vis !== '' && e.type !== vis) synlig = false;

                    /// kategori har formen "behov:3" eller "ressurs:1"
                    if (kat !== '') {
                        var deler = kat.split(':');
                        if (e.type !== deler[0] || String(e.kategori) !== deler[1]) synlig = false;
                    }

                    /// Disse gjelder bare sin egen type - den andre slipper gjennom
                    if (sta !== '' && e.type === 'behov' && String(e.status) !== sta) synlig = false;
                    if (vik !== '' && e.type === 'behov' && String(e.viktighet) !== vik) synlig = false;
                    if (tilg !== '' && e.type === 'ressurs' && String(e.tilgjengelig) !== tilg) synlig = false;
                    
                    if (synlig) { e.gruppe.addLayer(e.lag); } else { e.gruppe.removeLayer(e.lag); }
                });
            }
            var visDashboard = @(visDashboard ? "true" : "false");

            /// 2. Start kartet med grenser og fast verden
            var map = L.map('homeMap', {
                center: [58.1467, 7.9956],
                zoom: 11,
                minZoom: 3,
                maxBounds: [
                    [-90, -180],
                    [90, 180]
                ],
                maxBoundsViscosity: 1.0,
                zoomControl: !visDashboard,
                layers: [osmKart]
            });

            var symbolMarkers = MapSymbols.createCluster(map);
            var behovMarkorer = {};

            if (visDashboard) {
                /// Zoom og «min posisjon» oppe til høyre, slik som på skissen
                L.control.zoom({ position: 'topright', zoomInTitle: 'Zoom inn', zoomOutTitle: 'Zoom ut' }).addTo(map);

                var posisjonControl = L.control({ position: 'topright' });
                posisjonControl.onAdd = function () {
                    var div = L.DomUtil.create('div', 'leaflet-bar');
                    div.innerHTML = '<a href="#" role="button" title="Vis min posisjon" aria-label="Vis min posisjon"><i class="fa-solid fa-location-crosshairs"></i></a>';
                    L.DomEvent.disableClickPropagation(div);
                    div.querySelector('a').addEventListener('click', function (e) {
                        e.preventDefault();
                        map.locate({ setView: true, maxZoom: 14 });
                    });
                    return div;
                };
                posisjonControl.addTo(map);

                await byggDashboard();
                setTimeout(function () { map.invalidateSize(); }, 200);
                return;
            }

            /// Henter behov og ressurser, fyller tallene og «Trenger handling», og legger alt på kartet
            async function byggDashboard() {
                var behovTyper = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(behovTyper));
                var statusSteg = ['Meldt', 'Vurderes', 'Tildelt', 'Løst'];
                var matchUrl = '@Url.Action("Match", "Need")';
                var bounds = [];

                try {
                    const [resResponse, needResponse] = await Promise.all([
                        fetch('@Url.Action("GetInformation", "Resource")'),
                        fetch('@Url.Action("GetInformation", "Need")')
                    ]);

                    var ressurser = resResponse.ok ? await resResponse.json() : [];
                    var behov = needResponse.ok ? await needResponse.json() : [];

                    ressurser.forEach(function (res) {
                        var lat = parseFloat(res.latitude);
                        var lng = parseFloat(res.longitude);
                        if (isNaN(lat) || isNaN(lng)) return;

                        var available = MapSymbols.isAvailable(res.availability);
                        L.marker([lat, lng], {
                            icon: MapSymbols.resourceIcon(res.category, available),
                            title: (res.name || 'Ressurs') + (available ? ' – Tilgjengelig' : ' – Ikke tilgjengelig'),
                            alt: available ? 'Tilgjengelig ressurs' : 'Ikke tilgjengelig ressurs'
                        }).addTo(symbolMarkers).bindPopup(`
                            <div style="font-size: 0.9rem;">
                                <b>${escapeHtml(res.name || 'Uten navn')}</b> (${res.quantity || 1} stk)<br/>
                                Tlf: ${escapeHtml(res.phoneNumber || 'Ikke oppgitt')}<br/>
                                ${available ? '<span class="badge bg-success">Tilgjengelig</span>' : '<span class="badge bg-danger">Ikke tilgjengelig</span>'}
                            </div>`);
                        bounds.push([lat, lng]);
                    });

                    /// Løste behov trenger ikke handling, så de vises verken i tallene, listen eller på kartet
                    var apneBehov = behov.filter(function (b) { return b.status !== 3; });

                    apneBehov.forEach(function (b) {
                        var lat = parseFloat(b.latitude);
                        var lng = parseFloat(b.longitude);
                        var akutt = MapSymbols.isAcute(b.importance);

                        if (b.areaGeoJson) {
                            try {
                                var omrade = L.geoJSON(JSON.parse(b.areaGeoJson), {
                                    style: { color: akutt ? '#c8102e' : '#f2b705', weight: 2, dashArray: '6 4', fillOpacity: 0.15 }
                                }).addTo(map);
                                bounds.push(omrade.getBounds());
                            } catch (err) {
                                console.error("Feil ved innlasting av GeoJSON-figur:", err);
                            }
                        }

                        if (isNaN(lat) || isNaN(lng)) return;

                        var marker = L.marker([lat, lng], {
                            icon: MapSymbols.needIcon(b.type, b.importance),
                            title: b.name || 'Behov',
                            alt: b.name || 'Behov'
                        }).addTo(symbolMarkers).bindPopup(`
                            <div style="font-size: 0.9rem;">
                                <b>${escapeHtml(b.name || 'Uten navn')}</b><br/>
                                ${b.description ? escapeHtml(b.description) + '<br/>' : ''}
                                Status: ${statusSteg[b.status] || 'Meldt'}<br/>
                                <a href="${matchUrl}/${b.id}">Finn ressurser</a>
                            </div>`);
                        behovMarkorer[b.id] = marker;
                        bounds.push([lat, lng]);
                    });

                    document.getElementById('antallAkutte').textContent = apneBehov.filter(function (b) { return MapSymbols.isAcute(b.importance); }).length;
                    document.getElementById('antallPlanlagte').textContent = apneBehov.filter(function (b) { return !MapSymbols.isAcute(b.importance); }).length;
                    document.getElementById('antallLedige').textContent = ressurser.filter(function (r) { return MapSymbols.isAvailable(r.availability); }).length;

                    /// Akutte først, deretter de som har kommet kortest i statusflyten
                    apneBehov.sort(function (a, b) {
                        var akuttA = MapSymbols.isAcute(a.importance) ? 0 : 1;
                        var akuttB = MapSymbols.isAcute(b.importance) ? 0 : 1;
                        return akuttA - akuttB || a.status - b.status;
                    });

                    var liste = document.getElementById('trengerHandlingListe');
                    if (apneBehov.length === 0) {
                        liste.innerHTML = '<div class="action-empty">Ingen behov trenger handling nå.</div>';
                    } else {
                        liste.innerHTML = apneBehov.map(function (b) {
                            var akutt = MapSymbols.isAcute(b.importance);
                            var frist = b.deadline
                                ? new Date(b.deadline).toLocaleString('no-NO', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })
                                : '';
                            var undertekst = [behovTyper[String(b.type)], b.description].filter(Boolean).join(' · ');
                            var barer = statusSteg.map(function (_, i) {
                                return `<div><div class="bar ${i <= b.status ? 'done' : ''}"></div><div class="step">${statusSteg[i]}</div></div>`;
                            }).join('');

                            return `
                                <article class="need-card ${akutt ? 'acute' : ''}" data-id="${b.id}">
                                    <div class="need-card-top">
                                        <span class="need-badge ${akutt ? 'acute' : 'planned'}">
                                            <i class="fa-solid ${akutt ? 'fa-triangle-exclamation' : 'fa-diamond'}" aria-hidden="true"></i>
                                            ${akutt ? 'Akutt' : 'Planlagt'}
                                        </span>
                                        <span class="need-time">${frist}</span>
                                    </div>
                                    <div class="need-title"><a href="${matchUrl}/${b.id}">${escapeHtml(b.name || 'Uten navn')}</a></div>
                                    <div class="need-sub">${escapeHtml(undertekst)}</div>
                                    <div class="need-progress" aria-label="Status: ${statusSteg[b.status] || 'Meldt'}">${barer}</div>
                                </article>`;
                        }).join('');

                        /// Klikk på et kort viser behovet på kartet
                        liste.querySelectorAll('.need-card').forEach(function (kort) {
                            kort.addEventListener('click', function (e) {
                                if (e.target.closest('a')) return;
                                MapSymbols.focus(symbolMarkers, behovMarkorer[kort.dataset.id]);
                            });
                        });
                    }

                    if (bounds.length > 0) {
                        map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });
                    }
                } catch (error) {
                    console.error("Feil ved henting av data til oversikten:", error);
                    document.getElementById('trengerHandlingListe').innerHTML = '<div class="action-empty">Klarte ikke å hente behov.</div>';
                }
            }

            /// 3. Lag menyen i hjørnet for å bytte bakgrunnskart
            var bakgrunnsKart = {
                "Standard (OSM)": osmKart,
                "Topografisk (Geonorge)": geonorgeTopo,
                "Flybilder (Geonorge)": geonorgeFlybilder
            };
            L.control.layers(bakgrunnsKart).addTo(map);

            /// --- SYMBOL INFO KNAPP OG BOKS ---
            var symbolInfoControl = L.control({ position: 'topright' });

            symbolInfoControl.onAdd = function (map) {
                var div = L.DomUtil.create('div', 'leaflet-bar');
                div.style.border = 'none';
                div.style.boxShadow = 'none';

                div.innerHTML = `
                    <button id="toggleInfoBtn" class="info-btn">Symboler og fargekoder</button>
                    <div id="infoBoxContainer" class="info-box d-none mt-2">
                        <strong style="font-size: 1.05rem;">Symboler og fargekoder</strong>
                        <hr class="my-2">
                        <ul>
                            <li><span class="color-dot" style="background-color: #dc3545;"></span> Rød: Akutte behov</li>
                            <li><span class="color-dot" style="background-color: #ffc107;"></span> Gul: Planlagte behov</li>
                            <li><span class="color-dot" style="background-color: #0d6efd;"></span> Blå: Offentlige aktører</li>
                            <li><span class="color-dot" style="background-color: #198754;"></span> Grønn: Tilgjengelige ressurser</li>
                            <li><span class="color-dot" style="background-color: #6c757d;"></span> Grå og skråstrek: Utilgjengelige ressurser</li>
                            <li>Tall: Flere registreringer. Klikk for å vise symbolene.</li>
                            <li>Symbolet viser ressurs- eller behovstypen.</li>
                        </ul>
                    </div>
                `;

                L.DomEvent.disableClickPropagation(div);
                return div;
            };

            symbolInfoControl.addTo(map);

            document.getElementById('toggleInfoBtn').addEventListener('click', function () {
                var infoBox = document.getElementById('infoBoxContainer');
                infoBox.classList.toggle('d-none');
            });

            /// Flytt filterpanelet inn i kartets kontrollhjørne
            var filterControl = L.control({ position: 'topright' });
            filterControl.onAdd = function() {
                var el = document.getElementById('filterPanel');
                el.style.display = 'block';
                L.DomEvent.disableClickPropagation(el);
                L.DomEvent.disableScrollPropagation(el);
                return el;
            };
            filterControl.addTo(map);

            var bounds = [];

            /// Hjelpefunksjon for å formatere areal
            function formaterAreal(sqm) {
                if (!sqm) return '';
                if (sqm >= 1000000) {
                    return (sqm / 1000000).toFixed(2) + ' km²';
                }
                return Math.round(sqm).toLocaleString('no-NO') + ' m²';
            }

            try {
            /// 4. Hent ressurser
              
              const resResponse = await fetch('@Url.Action("GetInformation", "Resource")');
              
                if (resResponse.ok) {
                    const resourcesData = await resResponse.json();

                    resourcesData.forEach(function (res) {
                        var lat = parseFloat(res.latitude ?? res.Latitude);
                        var lng = parseFloat(res.longitude ?? res.Longitude);

                        if (!isNaN(lat) && !isNaN(lng)) {
                            var available = MapSymbols.isAvailable(res.availability ?? res.Availability);
                            var status = available
                                ? '<span class="badge bg-success">Tilgjengelig</span>'
                                : '<span class="badge bg-danger">Ikke tilgjengelig</span>';

                            var marker = L.marker([lat, lng], { icon: MapSymbols.resourceIcon(res.category ?? res.Category, available), title: (res.name ?? res.Name ?? 'Ressurs') + (available ? ' – Tilgjengelig' : ' – Ikke tilgjengelig'), alt: available ? 'Tilgjengelig ressurs' : 'Ikke tilgjengelig ressurs' }).addTo(symbolMarkers);
                            kartElementer.push({ lag: marker, gruppe: symbolMarkers, type: 'ressurs', kategori: res.category !== undefined ? res.category : res.Category, status: null, viktighet: null, tilgjengelig: (res.availability !== undefined ? res.availability : res.Availability), lat: lat, lng: lng });
                            marker.bindPopup(`
                                <div style="font-size: 0.9rem;">
                                    <strong style="color: #0d6efd;">📦 RESSURS</strong><br/>
                                    <b>${escapeHtml(res.name || res.Name || 'Uten navn')}</b> (${res.quantity || res.Quantity || 1} stk)<br/>
                                    📞 Tlf: ${escapeHtml(res.phoneNumber || res.PhoneNumber || 'Ikke oppgitt')}<br/>
                                    Status: ${status}
                                </div>
                            `);
                            bounds.push([lat, lng]);
                        }
                    });
                }

                /// 5. Hent behov (Inkludert inntegnede figurer/områder)
              
              const needResponse = await fetch('@Url.Action("GetInformation", "Need")');
              
                if (needResponse.ok) {
                    const needsData = await needResponse.json();

                    needsData.forEach(function (need) {
                        var lat = parseFloat(need.latitude ?? need.Latitude);
                        var lng = parseFloat(need.longitude ?? need.Longitude);
                        var importance = need.importance !== undefined ? need.importance : need.Importance;
                        var areaGeoJson = need.areaGeoJson || need.AreaGeoJson;
                        var areaSquareMeters = need.areaSquareMeters || need.AreaSquareMeters;

                        /// Teksten som skal vises når du trykker på enten området eller markøren
                        var popupInnhold = `
                            <div style="font-size: 0.9rem;">
                                <strong style="color: #dc3545;">🆘 BEHOV</strong><br/>
                                <b>${escapeHtml(need.name || need.Name || 'Uten navn')}</b><br/>
                                ${(need.description || need.Description) ? escapeHtml(need.description || need.Description) + '<br/>' : ''}
                                ${areaSquareMeters ? '<b>Areal:</b> ca. ' + formaterAreal(areaSquareMeters) + '<br/>' : ''}
                                ${(need.phone || need.Phone) ? '📞 Tlf: ' + escapeHtml(need.phone || need.Phone) : ''}
                            </div>
                        `;

                        var harOmrade = false;

                        /// --- TEGN FIGUR / OMÅDE DERSOM GEOJSON FINNES ---
                        if (areaGeoJson) {
                            try {
                                var parsedGeoJson = typeof areaGeoJson === 'string' ? JSON.parse(areaGeoJson) : areaGeoJson;

                                var omrade = L.geoJSON(parsedGeoJson, {
                                    style: {
                                        color: importance === 0 ? '#dc3545' : '#fd7e14',
                                        weight: 2,
                                        fillOpacity: 0.25
                                    }
                                }).addTo(map);
                                kartElementer.push({ lag: omrade, gruppe: map, type: 'behov', kategori: need.type !== undefined ? need.type : need.Type, status: need.status !== undefined ? need.status : need.Status, viktighet: importance, tilgjengelig: null, lat: omrade.getBounds().getCenter().lat, lng: omrade.getBounds().getCenter().lng });

                                /// Fest infoboksen direkte til området ved klikk
                                omrade.bindPopup(popupInnhold);

                                if (areaSquareMeters) {
                                    omrade.bindTooltip(
                                        `${escapeHtml(need.name || need.Name || 'Område')}: ca. ${formaterAreal(areaSquareMeters)}`,
                                        { sticky: true }
                                    );
                                }

                                /// Hent ut grensene (bounds) til området slik at kartzoomen tilpasser seg
                                bounds.push(omrade.getBounds());
                                harOmrade = true;

                            } catch (err) {
                                console.error("Feil ved innlasting av GeoJSON-figur:", err);
                            }
                        }

                        /// Vis behovssymbolet også når behovet har et inntegnet område.
                        if (!isNaN(lat) && !isNaN(lng)) {
                            var chosenIcon = MapSymbols.needIcon(need.type ?? need.Type, importance);

                            var marker = L.marker([lat, lng], { icon: chosenIcon, title: need.name ?? need.Name ?? 'Behov', alt: need.name ?? need.Name ?? 'Behov' }).addTo(symbolMarkers);
                            kartElementer.push({ lag: marker, gruppe: symbolMarkers, type: 'behov', kategori: need.type !== undefined ? need.type : need.Type, status: need.status !== undefined ? need.status : need.Status, viktighet: importance, tilgjengelig: null, lat: lat, lng: lng });
                            marker.bindPopup(popupInnhold);

                                bounds.push([lat, lng]);
                            }
                        });
                    }

                    ['visFilter', 'kategoriFilter', 'tilgjengelighetFilter', 'statusFilter', 'viktighetFilter'].forEach(function (id) {
                    document.getElementById(id)?.addEventListener('change', filtrerKart);

                    });
                    settOppRadiusSok(map, filtrerKart);

                /// 6. Tilpass kartzoomen dersom det finnes markører eller områder
                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [40, 40], maxZoom: 13 });
                }

            } catch (error) {
                console.error("Feil ved henting av kartdata:", error);
            }

            setTimeout(function () {
                map.invalidateSize();
            }, 200);
        });
    </script>
}