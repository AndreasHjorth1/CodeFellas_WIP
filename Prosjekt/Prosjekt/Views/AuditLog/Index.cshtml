@model List<Prosjekt.Models.Entities.AuditLog>

@{
    ViewData["Title"] = "Endringshistorikk";
}

<h1>Endringshistorikk</h1>

<p>De 100 nyeste loggpostene for behov. Tidspunkter vises i UTC.</p>

@if (Model.Count == 0)
{
    <p>Ingen hendelser er loggført ennå.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Tidspunkt (UTC)</th>
                    <th scope="col">Bruker-ID</th>
                    <th scope="col">Handling</th>
                    <th scope="col">Behov-ID</th>
                    <th scope="col">Felt</th>
                    <th scope="col">Gammel verdi</th>
                    <th scope="col">Ny verdi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    var action = log.Action switch
                    {
                        "Create" => "Opprettet",
                        "Update" => "Endret",
                        "Delete" => "Slettet",
                        _ => log.Action
                    };

                    <tr>
                        <td>@log.Timestamp.UtcDateTime.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@(log.UserId ?? "Ikke innlogget / system")</td>
                        <td>@action</td>
                        <td>@log.EntityId</td>
                        <td>@(log.FieldName ?? "–")</td>
                        <td>@(log.OldValue ?? "–")</td>
                        <td>@(log.NewValue ?? "–")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}