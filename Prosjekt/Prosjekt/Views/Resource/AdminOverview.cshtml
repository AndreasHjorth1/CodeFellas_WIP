<link rel="stylesheet" href="~/css/map-symbols.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.Default.css" asp-append-version="true" />
@using Prosjekt.Models.ModelView
@using Prosjekt.Utils
@using System.Globalization
@using System.Security.Claims
@using Prosjekt.Models.Authorization
@model IEnumerable<ResourceViewModel>

@{
    /// Admin og koordinator sin oversikt over alle ressurser. Vanlige brukere får Overview.cshtml.
    /// Admin kan slette alle ressurser, koordinator bare sine egne.
    ViewData["Title"] = "Ressurser";
    var erAdmin = User.IsInRole(RoleNames.Admin);
    var minId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var ressurser = (Model ?? Enumerable.Empty<ResourceViewModel>()).ToList();
    var naa = NorwegianTime.FromUtc(DateTime.UtcNow);
    var antallPerKategori = ressurser.GroupBy(r => r.Category).ToDictionary(g => g.Key, g => g.Count());
    var stegNavn = new[] { "Registrert", "Tilgjengelig", "Tildelt behov", "Utløpt" };
}

<link rel="stylesheet" href="~/css/resource-icons.css" asp-append-version="true" />

@functions {
    string RessursIkon(ResourceViewModel.ResourceType kategori) => kategori switch
    {
        ResourceViewModel.ResourceType.Vehicle => "vehicle",
        ResourceViewModel.ResourceType.Tool => "tool",
        ResourceViewModel.ResourceType.Competence => "competence",
        ResourceViewModel.ResourceType.Clothing => "clothing",
        ResourceViewModel.ResourceType.Provision => "provision",
        ResourceViewModel.ResourceType.Materials => "materials",
        _ => "other"
    };

    string RessursIkonFil(ResourceViewModel.ResourceType kategori, bool tilgjengelig)
        => RessursIkon(kategori) + (tilgjengelig ? "" : "-unavailable") + ".svg";

    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Competence => "Kompetanse",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Mat og utstyr",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };

    /// <summary>
    /// Samme statusflyt som på «Mine ressurser»: Registrert, Tilgjengelig, Tildelt behov og Utløpt.
    /// </summary>
    (string Tekst, string Klasse) Status(ResourceViewModel r, DateTime naa)
    {
        if (r.AvailableTo < naa) return ("Utløpt", "status-expired");
        if (r.Allocated > 0) return ("Tildelt behov", "status-busy");
        if (r.Availability) return ("Tilgjengelig", "status-free");
        return ("Registrert", "status-off");
    }

    string LedigPeriode(ResourceViewModel r)
    {
        if (r.AvailableFrom.HasValue && r.AvailableTo.HasValue)
            return $"{r.AvailableFrom.Value:dd.MM. HH:mm}–{r.AvailableTo.Value:dd.MM. HH:mm}";
        if (r.AvailableTo.HasValue) return $"til {r.AvailableTo.Value:dd.MM.}";
        if (r.AvailableFrom.HasValue) return $"fra {r.AvailableFrom.Value:dd.MM.}";
        return "døgnet rundt";
    }

    /// <summary>
    /// Samme steg som på «Mine ressurser»: 1 registrert, 2 tilgjengelig, 3 tildelt et behov, 4 utløpt.
    /// </summary>
    int Steg(ResourceViewModel r, DateTime naa)
    {
        if (r.AvailableTo < naa) return 4;
        if (r.Allocated > 0) return 3;
        return r.Availability ? 2 : 1;
    }

    string StatusTekst(ResourceViewModel r, int steg) => steg switch
    {
        4 => "Perioden er over.",
        3 => $"Tildelt et behov. {r.Allocated} av {r.Quantity} er i bruk.",
        2 => "Klar. Ingen tildelinger ennå.",
        _ => "Ikke tilgjengelig for oppdrag."
    };
}

<style>
    /* _Layout setter body til høyden på skjermen. Da slipper menyen øverst taket etter én skjermhøyde,
       og kartet blir hengende med et hull over seg. Med auto følger body innholdet, og menyen står fast hele veien. */
    body {
        height: auto !important;
    }

    /* Fjerner marginene fra layouten så de grå og hvite flatene går helt ut */
    main {
        max-width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .res-page {
        background-color: #eef1f5;
        min-height: 100%;
        color: #0b1f3a;
    }

    .res-head {
        background-color: #ffffff;
        border-bottom: 1px solid #dde3ea;
    }

    /* Samme bredde som «Mine ressurser», så kartet får plassen som før var tom */
    .res-inner {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 1.5rem;
    }

    .res-head .res-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
    }

    .res-head h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
    }

    .res-head-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.6rem;
    }

    .res-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background-color: #ffffff;
        border: 1px solid #c3ccd8;
        border-radius: 3px;
        color: #0b1f3a;
        font-size: 0.9rem;
        font-weight: 600;
        padding: 0.45rem 0.9rem;
        text-decoration: none;
    }

    .res-btn:hover {
        background-color: #f4f6f9;
        color: #0b1f3a;
    }

    /* Liste / Delt / Kart */
    .view-toggle {
        display: inline-flex;
        border: 1px solid #c3ccd8;
        border-radius: 3px;
        overflow: hidden;
    }

    .view-toggle button {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background-color: #ffffff;
        border: none;
        border-right: 1px solid #c3ccd8;
        color: #0b1f3a;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.45rem 0.75rem;
    }

    .view-toggle button:last-child {
        border-right: none;
    }

    .view-toggle button.active {
        background-color: #04245a;
        color: #ffffff;
    }

    .res-body {
        padding-top: 1rem;
        padding-bottom: 2.5rem;
    }

    /* Kategorifilter som «chips» */
    .chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    .chip {
        background-color: #ffffff;
        border: 1px solid #c3ccd8;
        border-radius: 999px;
        color: #0b1f3a;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.8rem;
    }

    .chip:hover {
        border-color: #04245a;
    }

    .chip.active {
        background-color: #04245a;
        border-color: #04245a;
        color: #ffffff;
    }

    .res-map-wrap {
        border: 1px solid #dde3ea;
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        background-color: #ffffff;
    }

    #adminRessursKart {
        width: 100%;
        height: clamp(240px, 34vh, 340px);
    }

    /* Kart-visningen bruker hele bredden og høyden som er igjen under menyen, overskriften og kategoriene */
    .vis-kart .res-body {
        max-width: none;
        padding-bottom: 1rem;
    }

    .vis-kart .res-map-wrap {
        margin-bottom: 0;
    }

    .vis-kart #adminRessursKart {
        height: calc(100vh - 62px - 160px);
        min-height: 360px;
    }

    .vis-liste .res-map-wrap,
    .vis-kart .res-table-section {
        display: none;
    }

    /* --- Delt visning: listen til venstre og kartet til høyre, som på «Mine ressurser» --- */

    /* Mobil og nettbrett: kartet øverst og listen under. Kartet står fast øverst mens man blar i listen. */
    @@media (max-width: 991px) {
        .vis-delt .res-split {
            display: flex;
            flex-direction: column;
        }

        .vis-delt .res-map-wrap {
            order: -1;
            position: sticky;
            top: 62px; /* høyden på menyen øverst */
            z-index: 5;
        }

        .vis-delt #adminRessursKart {
            height: 35vh;
            min-height: 220px;
        }
    }

    /* Desktop: to kolonner. Kartet får mest plass og står fast ved siden av listen. */
    @@media (min-width: 992px) {
        .vis-delt .res-split {
            display: grid;
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
            gap: 1.5rem;
            align-items: start;
        }

        .vis-delt .res-map-wrap {
            position: sticky;
            top: calc(62px + 1rem); /* høyden på menyen øverst, pluss litt luft */
            margin-bottom: 0;
        }

        .vis-delt #adminRessursKart {
            height: calc(100vh - 62px - 2rem);
            min-height: 420px;
        }

        .vis-delt .res-table-filters {
            width: 100%;
        }

        .vis-delt .res-table-filters .form-control {
            flex: 1 1 200px;
            width: auto;
        }
    }

    .res-table-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .res-table-head h2 {
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
    }

    .res-table-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .res-table-filters .form-control {
        border: 1px solid #c3ccd8;
        border-radius: 3px;
        font-size: 0.85rem;
        color: #0b1f3a;
        width: 240px;
    }

    /* --- Ressurskort, samme utseende som på «Mine ressurser» --- */
    .resource-card {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        padding: 1.1rem 1.1rem 1rem;
        margin-bottom: 1rem;
    }

    .resource-card:hover {
        border-color: #b9c4d3;
    }

    /* Kortet man har åpnet med «Se mer» får en annen farge */
    .resource-card:has(.see-more-btn:not(.collapsed)) {
        background-color: #f3f6fb;
        border-color: #04245a;
        box-shadow: inset 3px 0 0 #04245a;
    }

    .resource-card-head {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
    }

    .resource-card .icon-circle {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background-color: #e9eff6;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .resource-card .icon-circle img {
        width: 26px;
        height: 26px;
    }

    .resource-card .card-title-block {
        flex: 1;
        min-width: 0;
    }

    .resource-card h3 {
        color: #0f2a4f;
        font-size: 1.1rem;
        font-weight: 700;
        margin: 0 0 0.15rem;
    }

    .resource-card .card-sub {
        color: #5f6f86;
        font-size: 0.85rem;
    }

    .resource-card .card-actions {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        font-size: 0.9rem;
    }

    .resource-card .card-actions a,
    .resource-card .card-actions button,
    .resource-card .see-more-btn {
        color: #2d4f86;
        text-decoration: underline;
        background: none;
        border: none;
        padding: 0;
        font-size: 0.9rem;
    }

    .resource-card .card-actions button.delete-link {
        color: #b02a37;
    }

    .progress-steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.35rem;
        margin: 1rem 0 0.75rem;
    }

    .progress-steps .step-bar {
        height: 3px;
        background-color: #dde3ea;
        margin-bottom: 0.4rem;
    }

    .progress-steps .step.done .step-bar {
        background-color: #04245a;
    }

    .progress-steps .step-label {
        color: #5f6f86;
        font-size: 0.75rem;
    }

    .resource-card .card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .resource-card .card-status {
        color: #0f2a4f;
        font-size: 0.9rem;
        margin: 0;
    }

    .resource-card .see-more-btn {
        flex-shrink: 0;
    }

    .resource-card .see-more-btn i {
        font-size: 0.75rem;
        margin-left: 0.2rem;
        transition: transform 0.2s;
    }

    .resource-card .see-more-btn:not(.collapsed) i {
        transform: rotate(180deg);
    }

    /* I Liste-visningen er det plass til flere kort ved siden av hverandre */
    .vis-liste .res-card-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
        gap: 1rem;
        align-items: start;
    }

    .vis-liste .res-card-list .resource-card {
        margin-bottom: 0;
    }

    @@media (max-width: 575px) {
        .vis-liste .res-card-list {
            grid-template-columns: 1fr;
        }
    }

    .resource-details {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 0.4rem 1rem;
        margin: 1rem 0 0;
        padding-top: 1rem;
        border-top: 1px solid #dde3ea;
        font-size: 0.85rem;
    }

    .resource-details dt {
        font-weight: 600;
    }

    .resource-details dd {
        margin: 0;
        overflow-wrap: anywhere;
    }

    @@media (max-width: 575px) {
        .resource-details {
            grid-template-columns: 1fr;
            gap: 0.1rem;
        }

        .resource-details dd {
            margin-bottom: 0.4rem;
        }
    }

    .res-empty {
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 4px;
        padding: 2rem;
        text-align: center;
        color: #5b6b7f;
    }

    @@media print {
        .res-head-actions, .chip-row, .res-map-wrap, .res-table-filters, .card-actions, .see-more-btn {
            display: none !important;
        }
    }
</style>

<div class="res-page vis-delt" id="ressursSide">

    <div class="res-head">
        <div class="res-inner">
            <h1>Ressurser</h1>
            <div class="res-head-actions">
                <div class="view-toggle" role="group" aria-label="Visning">
                    <button type="button" data-visning="liste"><i class="fa-solid fa-list" aria-hidden="true"></i> Liste</button>
                    <button type="button" data-visning="delt" class="active"><i class="fa-regular fa-map" aria-hidden="true"></i> Delt</button>
                    <button type="button" data-visning="kart"><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Kart</button>
                </div>
                <a class="res-btn" asp-controller="Need" asp-action="Overview">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Finn til et behov
                </a>
                <a class="res-btn" asp-controller="Export" asp-action="Index">
                    <i class="fa-solid fa-file-export" aria-hidden="true"></i> Eksporter
                </a>
                <button type="button" class="res-btn" data-on-click="print">
                    <i class="fa-solid fa-print" aria-hidden="true"></i> Skriv ut liste
                </button>
            </div>
        </div>
    </div>

    <div class="res-inner res-body">

        <div class="chip-row" role="group" aria-label="Kategori">
            <button type="button" class="chip active" data-kategori="">Alle @ressurser.Count</button>
            @foreach (var k in Enum.GetValues<ResourceViewModel.ResourceType>().OrderBy(k => k == ResourceViewModel.ResourceType.Other))
            {
                <button type="button" class="chip" data-kategori="@k">@OversettKategori(k) @(antallPerKategori.GetValueOrDefault(k))</button>
            }
        </div>

        @* setupFilter i site.js leser kategorien herfra. Chipsene over setter verdien. *@
        <select id="typeFilter" class="d-none" aria-hidden="true">
            <option value=""></option>
            @foreach (var k in Enum.GetValues<ResourceViewModel.ResourceType>())
            {
                <option value="@k"></option>
            }
        </select>

        @* Listen står først og kartet sist, så kartet havner til høyre på desktop. På mobil flyttes kartet øverst med CSS. *@
        <div class="res-split">

        <section class="res-table-section">
            <div class="res-table-head">
                <h2>Alle ressurser</h2>
                <div class="res-table-filters">
                    <input type="search" id="sokeFelt" class="form-control" placeholder="Søk på navn, telefon eller utstyr" />
                    <input type="search" id="stedsFelt" class="form-control" placeholder="Sted eller bydel, trykk Enter" />
                </div>
            </div>

            <div class="res-card-list">
                        @if (ressurser.Any())
                        {
                            @foreach (var res in ressurser)
                            {
                                var status = Status(res, naa);
                                var steg = Steg(res, naa);
                                var lat = (res.Latitude ?? 0).ToString(CultureInfo.InvariantCulture);
                                var lng = (res.Longitude ?? 0).ToString(CultureInfo.InvariantCulture);
                                var ledigTekst = !res.Availability
                                    ? "ikke tilgjengelig"
                                    : res.AvailableTo.HasValue ? $"ledig til {res.AvailableTo.Value:dd.MM. 'kl.' HH:mm}" : "ledig";

                                @* table-row-clickable og data-feltene må stå, filteret i site.js finner kortene med dem *@
                                <div class="resource-card table-row-clickable"
                                     data-lat="@lat" data-lng="@lng"
                                     data-id="@res.Id" data-type="@res.Category"
                                     data-sok="@(($"{res.Name}{res.Description} {res.PhoneNumber} {res.OwnerName} {OversettKategori(res.Category)}").ToLower())">

                                    <div class="resource-card-head">
                                        <span class="icon-circle">
                                            <img src="@Url.Content($"~/images/resources/{RessursIkonFil(res.Category, res.Availability)}")" alt="" />
                                        </span>
                                        <div class="card-title-block">
                                            <h3>@res.Name</h3>
                                            <div class="card-sub">
                                                @OversettKategori(res.Category) · @res.Available av @res.Quantity stk · @ledigTekst
                                                @if (!string.IsNullOrWhiteSpace(res.PhoneNumber))
                                                {
                                                    <span> · Tlf. @res.PhoneNumber</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="card-actions">
                                            <a asp-action="Edit" asp-route-id="@res.Id">Endre</a>
                                            @if (erAdmin || res.UserId == minId)
                                            {
                                                @* data-confirm leses av site.js. Razor koder navnet, så det kan ikke kjøres som JavaScript (XSS). *@
                                                <form asp-action="Delete" asp-route-id="@res.Id" method="post" class="d-inline" data-confirm="Er du sikker på at du vil slette @res.Name?" data-confirm-title="Slett ressurs">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="delete-link">Slett</button>
                                                </form>
                                            }
                                        </div>
                                    </div>

                                    <div class="progress-steps" aria-label="Status: @stegNavn[steg - 1]">
                                        @for (int i = 0; i < stegNavn.Length; i++)
                                        {
                                            <div class="step @(i < steg ? "done" : "")">
                                                <div class="step-bar"></div>
                                                <div class="step-label">@stegNavn[i]</div>
                                            </div>
                                        }
                                    </div>

                                    <div class="card-bottom">
                                        <p class="card-status">@StatusTekst(res, steg)</p>
                                        <button type="button" class="see-more-btn collapsed"
                                                data-bs-toggle="collapse" data-bs-target="#ressursInfo-@res.Id"
                                                aria-expanded="false" aria-controls="ressursInfo-@res.Id">
                                            Se mer <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                    @* Mer informasjon om ressursen, vises under kortet når man trykker «Se mer» *@
                                    <div class="collapse" id="ressursInfo-@res.Id">
                                            <dl class="resource-details">
                                                <dt>Kategori</dt>
                                                <dd>@OversettKategori(res.Category)</dd>

                                                <dt>Antall</dt>
                                                <dd>@res.Quantity stk (@res.Allocated i bruk, @res.Available ledig)</dd>

                                                <dt>Status</dt>
                                                <dd>@status.Tekst</dd>

                                                <dt>Tilgjengelig fra</dt>
                                                <dd>@(res.AvailableFrom.HasValue ? res.AvailableFrom.Value.ToString("dd.MM.yyyy 'kl.' HH:mm") : "Ikke satt")</dd>

                                                <dt>Tilgjengelig til</dt>
                                                <dd>@(res.AvailableTo.HasValue ? res.AvailableTo.Value.ToString("dd.MM.yyyy 'kl.' HH:mm") : "Ikke satt")</dd>

                                                @if (!string.IsNullOrWhiteSpace(res.VehicleType))
                                                {
                                                    <dt>Type kjøretøy</dt>
                                                    <dd>@res.VehicleType</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(res.LicensePlate))
                                                {
                                                    <dt>Registreringsnummer</dt>
                                                    <dd>@res.LicensePlate</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(res.ToolType))
                                                {
                                                    <dt>Type verktøy</dt>
                                                    <dd>@res.ToolType</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(res.Size))
                                                {
                                                    <dt>Størrelse</dt>
                                                    <dd>@res.Size</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(res.MaterialType))
                                                {
                                                    <dt>Type materiale</dt>
                                                    <dd>@res.MaterialType</dd>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(res.ProvisionType))
                                                {
                                                    <dt>Type mat og utstyr</dt>
                                                    <dd>@res.ProvisionType</dd>
                                                }

                                                <dt>Eier</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(res.OwnerName) ? "Ukjent" : res.OwnerName)</dd>

                                                <dt>Telefon</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(res.PhoneNumber) ? "Ikke oppgitt" : res.PhoneNumber)</dd>

                                                <dt>Beskrivelse</dt>
                                                <dd>@(string.IsNullOrWhiteSpace(res.Description) ? "Ingen beskrivelse" : res.Description)</dd>
                                            </dl>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="res-empty">Ingen ressurser registrert ennå.</div>
                        }
            </div>
        </section>

        <div class="res-map-wrap">
            <div id="adminRessursKart"></div>
        </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/map-symbols.js" data-resources-url="@Url.Content("~/images/resources/")" data-needs-url="@Url.Content("~/images/needs/")" asp-append-version="true"></script>

    <script nonce="@Context.CspNonce()">
        var kart;
        var markorerMap = {};
        var symbolMarkers;

        function fokuserPaRessurs(id) {
            MapSymbols.focus(symbolMarkers, markorerMap[id]);
        }

        document.addEventListener("DOMContentLoaded", function () {
            var ressurser = @Json.Serialize(ressurser.Select(r => new
            {
                id = r.Id,
                name = r.Name,
                quantity = r.Quantity,
                phone = r.PhoneNumber,
                isAvailable = r.Availability,
                categoryName = OversettKategori(r.Category),
                iconUrl = Url.Content($"~/images/resources/{RessursIkonFil(r.Category, r.Availability)}"),
                lat = r.Latitude,
                lng = r.Longitude
            }));

            kart = L.map('adminRessursKart', { zoomControl: false }).setView([58.163, 8.003], 12);
            L.control.zoom({ position: 'topright', zoomInTitle: 'Zoom inn', zoomOutTitle: 'Zoom ut' }).addTo(kart);

            L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
                attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>'
            }).addTo(kart);

            var bounds = [];
            symbolMarkers = MapSymbols.createCluster(kart);

            ressurser.forEach(function (r) {
                var lat = parseFloat(r.lat);
                var lng = parseFloat(r.lng);
                if (!Number.isFinite(lat) || !Number.isFinite(lng) ||
                    lat < -90 || lat > 90 || lng < -180 || lng > 180) return;

                bounds.push([lat, lng]);

                var tittel = r.categoryName + ': ' + r.name + (r.isAvailable ? ' – Tilgjengelig' : ' – Ikke tilgjengelig');
                var marker = L.marker([lat, lng], {
                    icon: MapSymbols.icon(r.iconUrl, 'resource-map-icon'),
                    title: tittel,
                    alt: tittel
                }).addTo(symbolMarkers);
                markorerMap[r.id] = marker;

                marker.bindPopup(`
                    <b>${escapeHtml(r.name)}</b> (${r.quantity} stk)<br/>
                    ${escapeHtml(r.categoryName)}<br/>
                    Tlf: ${escapeHtml(r.phone || 'Ikke oppgitt')}<br/>
                    ${r.isAvailable
                        ? '<span style="color: green; font-weight: bold;">Tilgjengelig</span>'
                        : '<span style="color: red; font-weight: bold;">Ikke tilgjengelig</span>'}`);
            });

            var kjorFilter = setupFilter(kart, [markorerMap], [symbolMarkers]);
            setupPlaceSearch(kart, kjorFilter);

            /// Kategorichipsene styrer den skjulte typeFilter-listen som setupFilter bruker
            var typeFilter = document.getElementById('typeFilter');
            document.querySelectorAll('.chip').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    document.querySelectorAll('.chip').forEach(function (c) { c.classList.toggle('active', c === chip); });
                    typeFilter.value = chip.dataset.kategori;
                    typeFilter.dispatchEvent(new Event('change'));
                });
            });

            /// Liste / Delt / Kart
            var side = document.getElementById('ressursSide');
            document.querySelectorAll('.view-toggle button').forEach(function (knapp) {
                knapp.addEventListener('click', function () {
                    document.querySelectorAll('.view-toggle button').forEach(function (k) { k.classList.toggle('active', k === knapp); });
                    side.classList.remove('vis-liste', 'vis-delt', 'vis-kart');
                    side.classList.add('vis-' + knapp.dataset.visning);
                    kart.invalidateSize();
                });
            });

            if (bounds.length > 0) {
                kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 14 });
            }

            setTimeout(function () { kart.invalidateSize(); }, 200);
        });
    </script>
}
