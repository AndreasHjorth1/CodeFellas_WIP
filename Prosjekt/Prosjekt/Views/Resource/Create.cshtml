@using Prosjekt.Models.ModelView
@using System.Globalization
@model ResourceViewModel

@{
    ViewData["Title"] = "Ressurs opprettet";
}

@functions {
    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Mat og utstyr",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };
}

<h1>Ressurs opprettet</h1>
<hr />

<div class="row mb-4 align-items-start">
    <div class="col-md-6 mb-4 mb-md-0">
        <!-- Fjernet 'h-100' og lagt til 'd-inline-block w-100' slik at kortet tilpasser seg innholdet dynamisk -->
        <div class="card p-4 shadow-sm h-auto d-inline-block w-100">
            <p><strong>Navn:</strong> @Model.Name</p>
            <p><strong>Telefonnummer:</strong> @Model.PhoneNumber</p>
            <p><strong>Beskrivelse:</strong> @Model.Description</p>
            <p><strong>Type:</strong> @OversettKategori(Model.Category)</p>
            <p><strong>Antall:</strong> @Model.Quantity</p>
            <p><strong>Breddegrad:</strong> @Model.Latitude</p>
            <p class="mb-0"><strong>Lengdegrad:</strong> @Model.Longitude</p>
        </div>
    </div>
    <div class="col-md-6">
        <div id="map" style="height: 500px;" class="shadow-sm border rounded"></div>
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Resource" asp-action="Index" class="btn btn-secondary">Opprett enda en ressurs</a>
    <a asp-controller="Resource" asp-action="Overview" class="btn btn-primary">Gå til oversikten</a>
</div>

@section Scripts 
{
    <script>
        (function () {
            // Sjekker om verdien finnes og konverterer double trygt til streng med punktum
            var lat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(CultureInfo.InvariantCulture) : "0");
            var lng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(CultureInfo.InvariantCulture) : "0");

            // Initialize the map
            var map = L.map('map').setView([lat, lng], 13);

            // Add a tile layer to the map
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            // Initialize the feature group that will hold layers
            var drawnItems = new L.FeatureGroup();
            map.addLayer(drawnItems);

            // Create a marker at the model coordinates and add it to the feature group
            var marker = L.marker([lat, lng]);
            drawnItems.addLayer(marker);

            // Open popup after reverse geocode to ensure the address is displayed
            var url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;

            fetch(url)
                .then(function (response) {
                    if (!response.ok) throw new Error('Nettverksrespons var ikke OK');
                    return response.json();
                })
                .then(function (data) {
                    var address = data && data.display_name ? data.display_name : 'Adresse ikke funnet';
                    marker.bindPopup('<b>Adresse:</b> ' + address).openPopup();
                })
                .catch(function (err) {
                    console.error('Adresseoppslag mislyktes:', err);
                    marker.bindPopup('<b>Adresse:</b> Ikke tilgjengelig').openPopup();
                });
        })();
    </script>
}