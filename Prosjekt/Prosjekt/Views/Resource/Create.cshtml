<link rel="stylesheet" href="~/css/map-symbols.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.Default.css" asp-append-version="true" />
@using Prosjekt.Models.ModelView
@using System.Globalization
@model List<ResourceViewModel>

@{
    ViewData["Title"] = Model.Count == 1 ? "Ressurs opprettet" : "Ressurser opprettet";

    /// Alle ressursene i ett skjema deler samme posisjon, så den første holder for kartet
    var forste = Model.FirstOrDefault();
}

@functions {
    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Mat og utstyr",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };
}

<style>
    .resizable-container {
        display: flex;
        width: 100%;
        height: calc(100vh - 80px);
        min-height: 500px;
        position: relative;
    }

    /* Brukes av scrollIntoView slik at menylinjen ikke dekker toppen av kartet */
    #splitWrapper {
        scroll-margin-top: 90px; /* høyden på menylinjen, juster ved behov */
    }

    /* Infoseksjonen starter på 40 %, kartet tar resten */
    .info-section {
        flex: 0 0 40%;
        min-width: 250px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .map-section {
        flex: 1 1 0;
        min-width: 200px;
        position: relative;
    }

    /* Drabar skillelinje */
    .resizer {
        width: 10px;
        background: #e0e0e0;
        cursor: col-resize;
        transition: background 0.2s;
        border-radius: 4px;
        margin: 0 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
    }

        .resizer:hover, .resizer.dragging {
            background: #0d6efd;
        }

        .resizer::after {
            content: "⋮";
            color: #666;
            font-weight: bold;
        }

        .resizer:hover::after, .resizer.dragging::after {
            color: white;
        }

    #kvitteringRessursKart {
        width: 100%;
        height: 100%;
        border-radius: 8px;
    }

    .info-clickable {
        cursor: pointer;
    }

        .info-clickable:hover {
            background-color: #f8f9fa;
        }
</style>

<h1>@(Model.Count == 1 ? "Ressurs opprettet" : $"{Model.Count} ressurser opprettet")</h1>
<hr />

<div class="resizable-container mb-3" id="splitWrapper">
    <!-- Info-seksjon: ett kort per ressurs -->
    <div class="info-section" id="infoBox">
        @if (forste != null)
        {
            <p class="text-muted small mb-2">
                <strong>Posisjon:</strong> @forste.Latitude, @forste.Longitude
            </p>
        }

        @for (int i = 0; i < Model.Count; i++)
        {
            var r = Model[i];
            <div class="card p-3 mb-3 shadow-sm info-clickable" onclick="fokuserPaKart(@i)">
                <p class="mb-1"><strong>Navn:</strong> @r.Name</p>
                <p class="mb-1"><strong>Telefonnummer:</strong> @r.PhoneNumber</p>
                <p class="mb-1"><strong>Beskrivelse:</strong> @r.Description</p>
                <p class="mb-1"><strong>Type:</strong> <img class="map-symbol-small ressurs-symbol" data-index="@i" alt="" width="28" height="28" /> @OversettKategori(r.Category)</p>
                <p class="mb-0"><strong>Antall:</strong> @r.Quantity</p>
            </div>
        }
    </div>

    <!-- Drabar skillelinje -->
    <div class="resizer" id="dragHandle"></div>

    <!-- Kart-seksjon -->
    <div class="map-section" id="mapBox">
        <div id="kvitteringRessursKart" class="shadow-sm border"></div>
    </div>
</div>

<div class="mb-5 pb-4 d-flex flex-wrap gap-2">
    <a asp-controller="Resource" asp-action="Index" class="btn btn-secondary">Opprett enda en ressurs</a>
    <a asp-controller="Resource" asp-action="Overview" class="btn btn-primary">Gå til oversikten</a>
</div>

@section Scripts {
    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/map-symbols.js" data-resources-url="@Url.Content("~/images/resources/")" data-needs-url="@Url.Content("~/images/needs/")" asp-append-version="true"></script>

    <script>
        var kart;
        var gruppe;
        var markorer = [];

        /// Flytter kartet til ressursen man klikket på og åpner popupen
        function fokuserPaKart(index) {
            var marker = markorer[index];
            if (!kart || !gruppe || !marker) return;
            gruppe.zoomToShowLayer(marker, function () { marker.openPopup(); });
        }

        document.addEventListener("DOMContentLoaded", function () {
            /// Konverterer tall trygt til punktum som desimaltegn
            var lat = @(forste?.Latitude is double la ? la.ToString(CultureInfo.InvariantCulture) : "null");
            var lng = @(forste?.Longitude is double lo ? lo.ToString(CultureInfo.InvariantCulture) : "null");

            var ressurser = @Json.Serialize(Model.Select(r => new
            {
                navn = r.Name,
                antall = r.Quantity,
                category = r.Category.ToString(),
                available = r.Availability
            }));

            /// Symbol ved siden av typen i hvert kort
            document.querySelectorAll('.ressurs-symbol').forEach(function (img) {
                var r = ressurser[img.dataset.index];
                img.src = MapSymbols.resourceUrl(r.category, r.available);
            });

            /// --- KART ---
            if (lat !== null && lng !== null && ressurser.length > 0) {
                kart = L.map('kvitteringRessursKart').setView([lat, lng], 14);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                }).addTo(kart);

                /// Alle ressursene står på samme punkt. Gruppen samler dem og sprer dem ut når man klikker,
                /// så ingen markører ligger skjult under hverandre.
                gruppe = L.markerClusterGroup({ spiderfyOnMaxZoom: true, showCoverageOnHover: false });

                var adresseTekst = '<div class="small text-muted"><i>Henter adresse...</i></div>';

                function popupInnhold(r) {
                    return `<b>${escapeHtml(r.navn)}</b> (${r.antall} stk)<hr class="my-1"/>` + adresseTekst;
                }

                ressurser.forEach(function (r) {
                    var marker = L.marker([lat, lng], {
                        icon: MapSymbols.resourceIcon(r.category, r.available),
                        title: r.available ? 'Tilgjengelig' : 'Ikke tilgjengelig',
                        alt: r.available ? 'Tilgjengelig ressurs' : 'Ikke tilgjengelig ressurs'
                    });
                    marker.bindPopup(popupInnhold(r));
                    markorer.push(marker);
                    gruppe.addLayer(marker);
                });

                kart.addLayer(gruppe);

                /// Adressen er den samme for alle, så den hentes bare én gang
                function oppdaterAdresse(tekst) {
                    adresseTekst = tekst;
                    markorer.forEach(function (m, i) { m.setPopupContent(popupInnhold(ressurser[i])); });
                }

                fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
                    .then(response => response.ok ? response.json() : null)
                    .then(data => {
                        var address = (data && data.display_name) ? data.display_name : 'Adresse ikke funnet';
                        oppdaterAdresse(`<small>📍 <b>Adresse:</b> ${escapeHtml(address)}</small>`);
                        if (markorer.length === 1) markorer[0].openPopup();
                    })
                    .catch(function () {
                        oppdaterAdresse('<small>📍 <b>Adresse:</b> Ikke tilgjengelig</small>');
                    });
            } else {
                document.getElementById('mapBox').innerHTML =
                    '<div class="text-muted p-3">Ingen gyldig posisjon å vise på kart.</div>';
            }

            /// --- DRAG / RESIZE LOGIKK ---
            const resizer = document.getElementById('dragHandle');
            const leftSide = document.getElementById('infoBox');
            const container = document.getElementById('splitWrapper');

            let x = 0;
            let leftWidth = 0;

            const mouseDownHandler = function (e) {
                x = e.clientX;
                leftWidth = leftSide.getBoundingClientRect().width;
                resizer.classList.add('dragging');
                document.addEventListener('mousemove', mouseMoveHandler);
                document.addEventListener('mouseup', mouseUpHandler);
            };

            const mouseMoveHandler = function (e) {
                const dx = e.clientX - x;
                const newLeftWidth = ((leftWidth + dx) * 100) / container.getBoundingClientRect().width;

                /// Tillat justering mellom 15 % og 85 % bredde
                if (newLeftWidth > 15 && newLeftWidth < 85) {
                    leftSide.style.flex = `0 0 ${newLeftWidth}%`;
                    if (kart) kart.invalidateSize();
                }
            };

            const mouseUpHandler = function () {
                resizer.classList.remove('dragging');
                document.removeEventListener('mousemove', mouseMoveHandler);
                document.removeEventListener('mouseup', mouseUpHandler);
                if (kart) kart.invalidateSize();
            };

            resizer.addEventListener('mousedown', mouseDownHandler);

            setTimeout(function () { if (kart) kart.invalidateSize(); }, 200);

            /// Scroll ned slik at kartet fyller skjermen under menylinjen
            document.getElementById('splitWrapper').scrollIntoView({ block: 'start' });
        });
    </script>
}
