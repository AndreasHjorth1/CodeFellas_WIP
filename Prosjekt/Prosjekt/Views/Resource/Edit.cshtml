@using Prosjekt.Models.ModelView
@using System.Globalization
@model ResourceViewModel

@{
    ViewData["Title"] = "Rediger Ressurs";
}

<div class="row min-vh-100 g-0 mt-2">
    <div class="col-lg-5 col-md-6 p-3 d-flex flex-column">
        <h2 class="mb-4">Rediger Ressurs</h2>
        <form asp-controller="Resource" asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off" class="flex-grow-1">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="border p-4 mb-3 rounded bg-light shadow-sm">
                <div class="form-group mb-3">
                    <label asp-for="Name" class="fw-bold">Navn *</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="fw-bold">Beskrivelse *</label>
                    <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="PhoneNumber" class="fw-bold">Telefonnummer (Kontaktpunkt) *</label>
                    <input asp-for="PhoneNumber" class="form-control" required />
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Availability" class="form-check-input" type="checkbox" id="inputAvailability" />
                    <label class="form-check-label fw-bold" for="inputAvailability">Er tilgjengelig for oppdrag</label>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label asp-for="AvailableFrom" class="form-label small fw-bold mb-1">Tilgjengelig fra *</label>
                        <input asp-for="AvailableFrom" type="datetime-local" class="form-control form-control-sm" required />
                    </div>
                    <div class="col-6">
                        <label asp-for="AvailableTo" class="form-label small fw-bold mb-1">Tilgjengelig til *</label>
                        <input asp-for="AvailableTo" type="datetime-local" class="form-control form-control-sm" required />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Category" class="fw-bold">Kategori *</label>
                    <select asp-for="Category" id="kategoriVelger" class="form-select" onchange="oppdaterSkjemavisning()">
                        <option value="Vehicle">Kjøretøy</option>
                        <option value="Provision">Provisjon</option>
                        <option value="Materials">Materialer</option>
                        <option value="Clothing">Klær</option>
                        <option value="Tool">Verktøy</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <div id="seksjonKjøretøy" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Kjøretøytype</label>
                    <select id="inputVehicleType" asp-for="VehicleType" class="form-select mb-2">
                        <option value="Car">Bil</option>
                        <option value="Bus">Buss</option>
                        <option value="Bicycle">Sykkel</option>
                        <option value="Motorcycle">Motorsykkel</option>
                        <option value="Tractor">Traktor</option>
                        <option value="Truck">Lastebil</option>
                        <option value="Dozer">Doser</option>
                        <option value="Excavator">Gravemaskin</option>
                        <option value="Other">Annet</option>
                    </select>
                    <label class="fw-bold">Skiltnummer</label>
                    <input id="inputLicensePlate" asp-for="LicensePlate" class="form-control" placeholder="F.eks. EL 12345" />
                </div>

                <div id="seksjonVerktøy" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Verktøytype</label>
                    <select id="inputToolType" asp-for="ToolType" class="form-select mb-2">
                        <option value="HandTool">Håndverktøy</option>
                        <option value="PowerTool">Elektroverktøy</option>
                        <option value="GardenTool">Hageverktøy</option>
                        <option value="MeasuringTool">Måleverktøy</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <div id="seksjonMaterialer" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Materialtype</label>
                    <select id="inputMaterialType" asp-for="MaterialType" class="form-select mb-2">
                        <option value="Wood">Treverk (meter)</option>
                        <option value="Metal">Metall (kg)</option>
                        <option value="Plastic">Plast (kg)</option>
                        <option value="Glass">Glass (m*2)</option>
                        <option value="Gravel">Grus (Kg)</option>
                        <option value="Stone">Stein (Kg)</option>
                        <option value="Soil">Jord (Kg)</option>
                        <option value="Sand">Sand (Kg)</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <div id="seksjonKlær" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Størrelse</label>
                    <select id="inputSize" asp-for="Size" class="form-select mb-2">
                        <option value="XS">XS</option>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="XXL">XXL</option>
                    </select>
                </div>

                <div id="seksjonProvisjon" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Provisjonstype</label>
                    <select id="inputProvisionType" asp-for="ProvisionType" class="form-select mb-2">
                        <option value="Water">Vann (liter)</option>
                        <option value="FoodOnePortion">Mat (1 porsjon)</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Quantity" class="fw-bold">Antall *</label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" required />
                </div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Latitude" class="form-label small fw-bold">Breddegrad *</label>
                    <input asp-for="Latitude" id="Latitude" class="form-control form-control-sm" readonly required />
                </div>
                <div class="col-6">
                    <label asp-for="Longitude" class="form-label small fw-bold">Lengdegrad *</label>
                    <input asp-for="Longitude" id="Longitude" class="form-control form-control-sm" readonly required />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50">Lagre</button>
                <a asp-action="Overview" class="btn btn-secondary w-50">Avbryt</a>
            </div>
        </form>
    </div>

    <div class="col-lg-7 col-md-6 d-flex flex-column p-3">
        <div id="map" class="flex-grow-1 w-100 rounded shadow-sm" style="min-height: 400px; height: 60vh;"></div>
    </div>
</div>

@section Scripts {
    <script>
        // Lagrede underkategorier fra serveren (JSON-kodet)
        var lagredeVerdier = {
            inputVehicleType: @Json.Serialize(Model.VehicleType),
            inputToolType: @Json.Serialize(Model.ToolType),
            inputMaterialType: @Json.Serialize(Model.MaterialType),
            inputProvisionType: @Json.Serialize(Model.ProvisionType),
            inputSize: @Json.Serialize(Model.Size)
                };

        function settSelectVerdi(el, verdi) {
            if (!el || !verdi) return;

            var onsket = String(verdi).trim().toLowerCase();

            // Finn option uavhengig av store/små bokstaver og mellomrom
            var treff = Array.from(el.options).find(function (o) {
                return o.value.trim().toLowerCase() === onsket;
            });

            if (treff) {
                el.value = treff.value;
            } else {
                // Verdien finnes ikke i listen: legg den til slik at den vises og ikke går tapt
                var ny = new Option(verdi + " (ikke i listen)", verdi, true, true);
                el.add(ny);
                el.value = verdi;
                console.warn("Ukjent underkategori:", verdi, "for", el.id);
            }
        }

        function oppdaterSkjemavisning() {
            var valgt = document.getElementById('kategoriVelger').value;

            var seksjoner = {
                Vehicle: 'seksjonKjøretøy',
                Provision: 'seksjonProvisjon',
                Materials: 'seksjonMaterialer',
                Clothing: 'seksjonKlær',
                Tool: 'seksjonVerktøy'
            };

            document.querySelectorAll('.kategori-seksjon').forEach(function (s) {
                var skalVises = (s.id === seksjoner[valgt]);
                s.style.display = skalVises ? 'block' : 'none';

                // Skjulte seksjoner sendes ikke med i skjemaet
                s.querySelectorAll('select, input').forEach(function (el) {
                    el.disabled = !skalVises;
                });
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            Object.keys(lagredeVerdier).forEach(function (id) {
                settSelectVerdi(document.getElementById(id), lagredeVerdier[id]);
            });

            oppdaterSkjemavisning();
        });

        function getIkon(fargeNavn) {
            return new L.Icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
        }

        var ikonGronn = getIkon('green');

        var lat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(CultureInfo.InvariantCulture) : "null");
        var lng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(CultureInfo.InvariantCulture) : "null");

        var harPosisjon = (lat !== null && lng !== null && !isNaN(lat) && !isNaN(lng));
        var startPunkt = harPosisjon ? [lat, lng] : [58.163, 8.003];

        var map = L.map('map').setView(startPunkt, harPosisjon ? 14 : 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        if (harPosisjon) {
            var existingMarker = L.marker(startPunkt, { icon: ikonGronn });
            drawnItems.addLayer(existingMarker);
        }

        var drawControl = new L.Control.Draw({
            draw: {
                polygon: false, polyline: false, circle: false, rectangle: false,
                marker: { icon: ikonGronn }
            },
            edit: { featureGroup: drawnItems, remove: true }
        });
        map.addControl(drawControl);

        map.on('draw:created', function (e) {
            var layer = e.layer;
            drawnItems.clearLayers();
            layer.setIcon(ikonGronn);
            drawnItems.addLayer(layer);

            var latlng = layer.getLatLng();
            document.getElementById('Latitude').value = latlng.lat.toFixed(6);
            document.getElementById('Longitude').value = latlng.lng.toFixed(6);
        });

        map.on('draw:deleted', function () {
            document.getElementById('Latitude').value = '';
            document.getElementById('Longitude').value = '';
        });

        setTimeout(function () { map.invalidateSize(); }, 200);
    </script>
    <partial name="_ValidationScriptsPartial" />
}