@using Prosjekt.Models.ModelView
@model ResourceViewModel

@{ 
    ViewData["Title"] = "Rediger Ressurs"; 
}

<div class="row min-vh-100 g-0 mt-2">
    <div class="col-lg-5 col-md-6 p-3 d-flex flex-column">
        <h2 class="mb-4">Rediger Ressurs</h2>
        <form asp-controller="Resource" asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off" class="flex-grow-1">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            <!-- Skjult felt for å sende den unike ID-en -->
            <input type="hidden" asp-for="Id" />

            <div class="border p-4 mb-3 rounded bg-light shadow-sm">
                <!-- Navn -->
                <div class="form-group mb-3">
                    <label asp-for="Name" class="fw-bold">Navn</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <!-- Beskrivelse -->
                <div class="form-group mb-3">
                    <label asp-for="Description" class="fw-bold">Beskrivelse</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <!-- Telefonnummer / Kontaktpunkt -->
                <div class="form-group mb-3">
                    <label asp-for="PhoneNumber" class="fw-bold">Telefonnummer (Kontaktpunkt)</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                </div>

                <!-- Tilgjengelighet -->
                <div class="form-check mb-3">
                    <input asp-for="Availability" class="form-check-input" type="checkbox" id="inputAvailability" />
                    <label class="form-check-label fw-bold" for="inputAvailability">Er tilgjengelig for oppdrag</label>
                </div>

                <!-- Tidsrom / Frister -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label asp-for="AvailableFrom" class="form-label small fw-bold mb-1">Tilgjengelig fra</label>
                        <input asp-for="AvailableFrom" type="datetime-local" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6">
                        <label asp-for="AvailableTo" class="form-label small fw-bold mb-1">Tilgjengelig til</label>
                        <input asp-for="AvailableTo" type="datetime-local" class="form-control form-control-sm" />
                    </div>
                </div>

                <!-- Kategori -->
                <div class="form-group mb-3">
                    <label asp-for="Category" class="fw-bold">Kategori</label>
                    <select asp-for="Category" id="kategoriVelger" class="form-select" onchange="oppdaterSkjemavisning()">
                        <option value="Vehicle">Kjøretøy</option>
                        <option value="Provision">Provisjon</option>
                        <option value="Materials">Materialer</option>
                        <option value="Clothing">Klær</option>
                        <option value="Tool">Verktøy</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <!-- Underkategori: Kjøretøy -->
                <div id="seksjonKjøretøy" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Kjøretøytype</label>
                    <select id="inputVehicleType" name="VehicleType" class="form-select mb-2">
                        <option value="Car">Bil</option>
                        <option value="Bus">Buss</option>
                        <option value="Bicycle">Sykkel</option>
                        <option value="Motorcycle">Motorsykkel</option>
                        <option value="Tractor">Traktor</option>
                        <option value="Truck">Lastebil</option>
                        <option value="Dozer">Doser</option>
                        <option value="Excavator">Gravemaskin</option>
                        <option value="Other">Annet</option>
                    </select>
                    <label class="fw-bold">Skiltnummer</label>
                    <input id="inputLicensePlate" name="LicensePlate" class="form-control" placeholder="F.eks. EL 12345" />
                </div>

                <!-- Underkategori: Verktøy -->
                <div id="seksjonVerktøy" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Verktøytype</label>
                    <select id="inputToolType" name="ToolType" class="form-select mb-2">
                        <option value="HandTool">Håndverktøy</option>
                        <option value="PowerTool">Elektroverktøy</option>
                        <option value="GardenTool">Hageverktøy</option>
                        <option value="MeasuringTool">Måleverktøy</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <!-- Underkategori: Materialer -->
                <div id="seksjonMaterialer" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Materialtype</label>
                    <select id="inputMaterialType" name="MaterialType" class="form-select mb-2">
                        <option value="Wood">Treverk</option>
                        <option value="Metal">Metall</option>
                        <option value="Plastic">Plast</option>
                        <option value="Glass">Glass</option>
                        <option value="Gravel">Grus</option>
                        <option value="Stone">Stein</option>
                        <option value="Soil">Jord</option>
                        <option value="Sand">Sand</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <!-- Underkategori: Klær -->
                <div id="seksjonKlær" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Størrelse</label>
                    <select id="inputSize" name="Size" class="form-select mb-2">
                        <option value="XS">XS</option>
                        <option value="S">S</option>
                        <option value="M">M</option>
                        <option value="L">L</option>
                        <option value="XL">XL</option>
                        <option value="XXL">XXL</option>
                    </select>
                </div>

                <!-- Underkategori: Provisjon -->
                <div id="seksjonProvisjon" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Provisjonstype</label>
                    <select id="inputProvisionType" name="ProvisionType" class="form-select mb-2">
                        <option value="Water">Vann</option>
                        <option value="FoodOnePortion">Mat (1 porsjon)</option>
                    </select>
                </div>

                <!-- Antall -->
                <div class="form-group mb-3">
                    <label asp-for="Quantity" class="fw-bold">Antall</label>
                    <input asp-for="Quantity" type="number" min="1" class="form-control" />
                </div>
            </div>

            <!-- Koordinater -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Latitude" class="form-label small fw-bold">Breddegrad</label>
                    <input asp-for="Latitude" id="Latitude" class="form-control form-control-sm" readonly required />
                </div>
                <div class="col-6">
                    <label asp-for="Longitude" class="form-label small fw-bold">Lengdegrad</label>
                    <input asp-for="Longitude" id="Longitude" class="form-control form-control-sm" readonly required />
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50">Lagre</button>
                <a asp-action="Overview" class="btn btn-secondary w-50">Avbryt</a>
            </div>
        </form>
    </div>

    <!-- Kart-seksjon -->
    <div class="col-lg-7 col-md-6 d-flex flex-column p-3">
        <div id="map" class="flex-grow-1 w-100 rounded shadow-sm" style="min-height: 400px; height: 60vh;"></div>
    </div>
</div>

@section Scripts {
    <script>
        function oppdaterSkjemavisning() {
            let valgtTekst = document.getElementById('kategoriVelger').value;
            document.querySelectorAll('.kategori-seksjon').forEach(s => s.style.display = 'none');
            
            if (valgtTekst === "Vehicle") document.getElementById('seksjonKjøretøy').style.display = 'block';
            else if (valgtTekst === "Provision") document.getElementById('seksjonProvisjon').style.display = 'block';
            else if (valgtTekst === "Materials") document.getElementById('seksjonMaterialer').style.display = 'block';
            else if (valgtTekst === "Clothing") document.getElementById('seksjonKlær').style.display = 'block';
            else if (valgtTekst === "Tool") document.getElementById('seksjonVerktøy').style.display = 'block';
        }

        document.addEventListener("DOMContentLoaded", function() { 
            oppdaterSkjemavisning(); 
        });

        var latRaw = '@Model.Latitude'.replace(',', '.');
        var lngRaw = '@Model.Longitude'.replace(',', '.');
        var lat = parseFloat(latRaw); 
        var lng = parseFloat(lngRaw);
        
        var harPosisjon = !isNaN(lat) && !isNaN(lng);
        var startPunkt = harPosisjon ? [lat, lng] : [58.1467, 7.9956];

        var map = L.map('map').setView(startPunkt, harPosisjon ? 14 : 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
            attribution: '&copy; OpenStreetMap contributors' 
        }).addTo(map);

        var currentMarker; 
        if (harPosisjon) {
            currentMarker = L.marker(startPunkt).addTo(map);
        }

        map.on('click', function(e) {
            var klikketLat = e.latlng.lat.toFixed(6); 
            var klikketLng = e.latlng.lng.toFixed(6);
            document.getElementById('Latitude').value = klikketLat; 
            document.getElementById('Longitude').value = klikketLng;
            
            if (currentMarker) map.removeLayer(currentMarker);
            currentMarker = L.marker([klikketLat, klikketLng]).addTo(map);
        });

        setTimeout(function () { map.invalidateSize(); }, 200);
    </script>
}