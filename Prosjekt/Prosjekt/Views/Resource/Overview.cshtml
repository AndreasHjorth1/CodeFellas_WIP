@using Prosjekt.Models.ModelView
@model List<ResourceViewModel>

@{ ViewData["Title"] = "Oversikt over ressurser"; }

@functions {
    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Mat og utstyr",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };
}

<h1 class="mb-4">Oversikt over ressurser</h1>

<div class="row">
    <div class="col-lg-7 col-md-12 mb-4">
        <div class="table-responsive shadow-sm border rounded bg-white">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Navn / Kontakt</th>
                        <th>Kategori</th>
                        <th>Antall</th>
                        <th>Status</th>
                        <th>Tidsrom</th>
                        <th class="text-end">Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.Name</div>
                                    <div class="small text-muted">📞 @item.PhoneNumber</div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="small text-secondary text-truncate" style="max-width: 150px;" title="@item.Description">@item.Description</div>
                                    }
                                </td>
                                <td>@OversettKategori(item.Category)</td>
                                <td>@item.Quantity</td>
                                <td>
                                    @if (item.Availability)
                                    {
                                        <span class="badge bg-success">Tilgjengelig</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Utilgjengelig</span>
                                    }
                                </td>
                                <td class="small">
                                    @if (item.AvailableFrom.HasValue && item.AvailableTo.HasValue)
                                    {
                                        <div>Fra: @item.AvailableFrom.Value.ToString("dd.MM.yyyy HH:mm")</div>
                                        <div>Til: @item.AvailableTo.Value.ToString("dd.MM.yyyy HH:mm")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Ingen frist satt</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-controller="Resource" asp-action="Edit" asp-route-id="@item.Name" class="btn btn-sm btn-warning">Rediger</a>
                                    <form asp-controller="Resource" asp-action="Delete" asp-route-id="@item.Name" method="post" style="display:inline;" onsubmit="return confirm('Er du sikker på at du vil slette @item.Name?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">Ingen ressurser registrert ennå.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    
    <div class="col-lg-5 col-md-12">
        <div id="oversiktKart" class="shadow-sm rounded bg-white" style="height: 65vh; min-height: 400px; border-radius: 8px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        var ressurser = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        var kart = L.map('oversiktKart').setView([58.1467, 7.9956], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(kart);

        var grupperteRessurser = {};

        if (ressurser && ressurser.length > 0) {
            ressurser.forEach(function(r) {
                var lat = parseFloat(r.Latitude); var lng = parseFloat(r.Longitude);
                if (isNaN(lat) || isNaN(lng)) return;
                var nokkel = lat.toFixed(6) + ',' + lng.toFixed(6);
                if (!grupperteRessurser[nokkel]) grupperteRessurser[nokkel] = { lat: lat, lng: lng, items: [] };
                grupperteRessurser[nokkel].items.push(r);
            });
        }

        var bounds = [];
        Object.keys(grupperteRessurser).forEach(function(nokkel) {
            var gruppe = grupperteRessurser[nokkel];
            var innhold = '<div style="max-height: 200px; overflow-y: auto; font-size: 0.9rem;">';
            
            gruppe.items.forEach(function(r, index) {
                innhold += `<b>${r.Name}</b> (${r.Quantity} stk)<br>`;
                innhold += `📞 Tlf: ${r.PhoneNumber || 'Ikke oppgitt'}<br>`;
                innhold += `Status: <span style="color: ${r.Availability ? 'green' : 'gray'}; font-weight: bold;">${r.Availability ? 'Tilgjengelig' : 'Utilgjengelig'}</span>`;
                
                if (index < gruppe.items.length - 1) {
                    innhold += '<hr style="margin: 6px 0; border: 0; border-top: 1px solid #ccc;">';
                }
            });
            innhold += '</div>';

            var marker = L.marker([gruppe.lat, gruppe.lng]);
            marker.bindPopup(innhold);
            if (gruppe.items.length > 1) {
                marker.bindTooltip(`${gruppe.items.length} ressurser på dette stedet`);
            }
            marker.addTo(kart);
            bounds.push([gruppe.lat, gruppe.lng]);
        });

        if (bounds.length > 0) kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        setTimeout(function () { kart.invalidateSize(); }, 200);
    </script>
}