@using Prosjekt.Models.ModelView
@using System.Globalization
@model IEnumerable<ResourceViewModel>

@{
    ViewData["Title"] = "Oversikt over ressurser";
}

<link rel="stylesheet" href="~/css/resource-icons.css" asp-append-version="true" />

@functions {
    string RessursIkon(ResourceViewModel.ResourceType kategori) => kategori switch
    {
        ResourceViewModel.ResourceType.Vehicle => "vehicle",
        ResourceViewModel.ResourceType.Tool => "tool",
        ResourceViewModel.ResourceType.Clothing => "clothing",
        ResourceViewModel.ResourceType.Provision => "provision",
        ResourceViewModel.ResourceType.Materials => "materials",
        _ => "other"
    };

    string RessursIkonFil(ResourceViewModel.ResourceType kategori, bool tilgjengelig)
        => RessursIkon(kategori) + (tilgjengelig ? "" : "-unavailable") + ".svg";

    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Mat og utstyr",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };
}

<style>
    .resizable-container {
        display: flex;
        width: 100%;
        height: calc(100vh - 120px);
        min-height: 500px;
        position: relative;
    }

    /* Ressursoversikten starter på 70 % av bredden */
    .table-section {
        flex: 0 0 70%;
        min-width: 250px;
        overflow-y: auto;
        padding-right: 10px;
    }

    .resource-overview-form {
        padding-top: 0.25rem;
    }

    .resource-overview-table .tf-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
        flex-wrap: wrap;
        min-width: 170px;
    }

    .resource-overview-table .tf-actions form {
        margin: 0;
    }

    /* Kartet tar resten av bredden */
    .map-section {
        flex: 1 1 0;
        min-width: 200px;
        position: relative;
    }

    /* Drabar skillelinje */
    .resizer {
        width: 10px;
        background: #e0e0e0;
        cursor: col-resize;
        transition: background 0.2s;
        border-radius: 4px;
        margin: 0 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
    }

        .resizer:hover, .resizer.dragging {
            background: #0d6efd;
        }

        .resizer::after {
            content: "⋮";
            color: #666;
            font-weight: bold;
        }

        .resizer:hover::after, .resizer.dragging::after {
            color: white;
        }

    #oversiktRessursKart {
        width: 100%;
        height: 100%;
        border-radius: 8px;
    }

    .table-row-clickable {
        cursor: pointer;
    }
</style>

<header class="tf-page-head">
    <div>
        <p class="tf-kicker">Ressurser</p>
        <h1 class="tf-title" style="font-size: clamp(2rem, 3.2vw, 2.75rem);">Oversikt over <em>ressurser.</em></h1>
        <p class="tf-lede mb-0"><span class="tf-num">@(Model?.Count() ?? 0)</span> registrert. Klikk på en rad for å se den på kartet.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="tf-btn tf-btn--ghost tf-btn--sm" onclick="window.print()">Skriv ut listen</button>
        <a asp-controller="Resource" asp-action="Index" class="tf-btn tf-btn--sm">Registrer ressurs <span aria-hidden="true">&rarr;</span></a>
    </div>
</header>

<div class="resizable-container tf-split" id="splitWrapper">
    <!-- Tabell-seksjon (Ressursoversikt) -->
    <div class="table-section" id="tableBox">
        <div class="tf-form resource-overview-form">
            <div class="tf-toolbar" role="search" aria-label="Filtrer listen">
                <div>
                    <label for="sokeFelt">Søk</label>
                    <input type="search" id="sokeFelt" class="form-control" placeholder="Navn eller beskrivelse" />
                </div>
                <div>
                    <label for="typeFilter">Kategori</label>
                    <select id="typeFilter" class="form-select">
                        <option value="">Alle kategorier</option>
                        @foreach (var k in Enum.GetValues<ResourceViewModel.ResourceType>())
                        {
                            <option value="@k">@OversettKategori(k)</option>
                        }
                    </select>
                </div>
                <div class="tf-full">
                    <label for="stedsFelt">Sted</label>
                    <input type="search" id="stedsFelt" class="form-control" placeholder="F.eks. Kristiansand, trykk Enter" />
                </div>
                <div class="tf-full">
                    <label for="radiusFelt">Avstand fra et punkt</label>
                    <div class="tf-radius">
                        <button type="button" id="velgPunktBtn" class="tf-btn tf-btn--ghost tf-btn--sm text-nowrap">Velg punkt</button>
                        <input type="number" id="radiusFelt" class="form-control tf-num" value="5" min="1" max="500" step="1" inputmode="numeric" />
                        <span class="tf-meta mt-0">km</span>
                    </div>
                </div>
            </div>
            <table class="tf-table tf-table--cards resource-overview-table">
                <thead>
                    <tr>
                        <th scope="col">Ressurs</th>
                        <th scope="col">Kategori</th>
                        <th scope="col">Antall</th>
                        <th scope="col">Status</th>
                        <th scope="col"><span class="visually-hidden">Handlinger</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var res in Model)
                        {
                            var ledig = res.Availability;
                            <tr class="table-row-clickable" tabindex="0" data-lat="@((res.Latitude ?? 0).ToString(CultureInfo.InvariantCulture))" data-lng="@((res.Longitude ?? 0).ToString(CultureInfo.InvariantCulture))"
                                data-id="@res.Id" data-type="@res.Category" data-sok="@(($"{res.Name} {res.Description}").ToLower())"
                                onclick="fokuserPaRessurs('@res.Id', @((res.Latitude ?? 0).ToString(CultureInfo.InvariantCulture)), @((res.Longitude ?? 0).ToString(CultureInfo.InvariantCulture)))"
                                onkeydown="if (event.key === 'Enter') { this.click(); }">
                                <td class="tf-first">
                                    <span class="tf-name">@res.Name</span>
                                    <span class="tf-meta">@res.Description</span>
                                </td>
                                <td data-label="Kategori">
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <img class="resource-category-icon"
                                             src="@Url.Content($"~/images/resources/{RessursIkonFil(res.Category, res.Availability)}")"
                                             width="24" height="24" alt="" />
                                        <span class="tf-chip">@OversettKategori(res.Category)</span>
                                    </span>
                                </td>
                                <td data-label="Antall" class="tf-num">
                                    <span>
                                        @res.Quantity
                                        @if (!res.Availability)
                                        {
                                            <span class="tf-meta">Utilgjengelig</span>
                                        }
                                    </span>
                                </td>
                                <td data-label="Status">
                                    <span>
                                        <span class="tf-status">
                                            <span class="tf-shape" style="background-color: @(ledig ? "var(--tf-available)" : "var(--tf-unavailable)");"></span>
                                            @(ledig ? "Ledig" : "Utilgjengelig")
                                        </span>
                                        <span class="tf-meta tf-num">
                                            @(res.AvailableFrom?.ToString("dd.MM.yy HH:mm") ?? "–") – @(res.AvailableTo?.ToString("dd.MM.yy HH:mm") ?? "–")
                                        </span>
                                    </span>
                                </td>
                                <td class="tf-actions" onclick="event.stopPropagation();" onkeydown="event.stopPropagation();">
                                    <a asp-action="Edit" asp-route-id="@res.Id" class="tf-link">Rediger</a>
                                    <form asp-action="Delete" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Slette denne ressursen? Dette kan ikke angres.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="tf-link tf-link--danger">Slett</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="tf-empty">Ingen ressurser registrert ennå.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Drabar skillelinje -->
    <div class="resizer" id="dragHandle"></div>

    <!-- Kart-seksjon -->
    <div class="map-section" id="mapBox">
        <div id="oversiktRessursKart" class="shadow-sm border"></div>
    </div>
</div>

@section Scripts {
    <script>
        var kart;
        var markorerMap = {};

        function fokuserPaRessurs(id, lat, lng) {
            if (lat && lng && markorerMap[id]) {
                kart.flyTo([lat, lng], 15, { duration: 1 });
                markorerMap[id].openPopup();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Konverter C#-modellen til JS uten kontaktinfo/reg-nr
            var ressurser = @Json.Serialize((Model ?? Enumerable.Empty<ResourceViewModel>()).Select(r => new
            {
                id = r.Id,
                name = r.Name,
                quantity = r.Quantity,
                isAvailable = r.Availability,
                categoryName = OversettKategori(r.Category),
                iconUrl = Url.Content($"~/images/resources/{RessursIkonFil(r.Category, r.Availability)}"),
                lat = r.Latitude,
                lng = r.Longitude
            }));

            // Initialiser kartet
            kart = L.map('oversiktRessursKart').setView([58.163, 8.003], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(kart);

            var bounds = [];

            ressurser.forEach(function (r) {
                var lat = parseFloat(r.lat);
                var lng = parseFloat(r.lng);
                if (!Number.isFinite(lat) || !Number.isFinite(lng) ||
                    lat < -90 || lat > 90 || lng < -180 || lng > 180) return;

                bounds.push([lat, lng]);

                var statusTekst = r.isAvailable
                    ? '<span style="color: green; font-weight: bold;">Tilgjengelig</span>'
                    : '<span style="color: red; font-weight: bold;">Opptatt</span>';

                var resourceIcon = L.icon({
                    iconUrl: r.iconUrl,
                    iconSize: [40, 40],
                    iconAnchor: [20, 20],
                    popupAnchor: [0, -22],
                    className: 'resource-map-icon'
                });

                var marker = L.marker([lat, lng], {
                    icon: resourceIcon,
                    title: r.categoryName + ': ' + r.name + (r.isAvailable ? ' – Tilgjengelig' : ' – Ikke tilgjengelig'),
                    alt: r.categoryName + ': ' + r.name + (r.isAvailable ? ' – Tilgjengelig' : ' – Ikke tilgjengelig')
                }).addTo(kart);
                markorerMap[r.id] = marker;

                var toppInnhold = `
                    <b>${r.name}</b> (${r.quantity} stk)<br/>
                    Status: ${statusTekst}<br/>`;

                marker.bindPopup(toppInnhold + '<div class="small text-muted mt-1"><i>Henter adresse...</i></div>');

                // Slå opp adresse via Nominatim API
                fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
                    .then(response => response.ok ? response.json() : null)
                    .then(data => {
                        var address = (data && data.display_name) ? data.display_name : 'Adresse ikke funnet';
                        marker.setPopupContent(toppInnhold + `<hr class="my-1"/><small>📍 <b>Adresse:</b> ${address}</small>`);
                    })
                    .catch(function () {
                        marker.setPopupContent(toppInnhold + '<hr class="my-1"/><small>📍 <b>Adresse:</b> Ikke tilgjengelig</small>');
                    });
            });

            if (bounds.length > 0) {
                kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 14 });
            }

            // --- DRAG / RESIZE LOGIKK ---
            const resizer = document.getElementById('dragHandle');
            const leftSide = document.getElementById('tableBox');
            const container = document.getElementById('splitWrapper');

            let x = 0;
            let leftWidth = 0;

            const mouseDownHandler = function (e) {
                x = e.clientX;
                leftWidth = leftSide.getBoundingClientRect().width;

                resizer.classList.add('dragging');
                document.addEventListener('mousemove', mouseMoveHandler);
                document.addEventListener('mouseup', mouseUpHandler);
            };

            const mouseMoveHandler = function (e) {
                const dx = e.clientX - x;
                const newLeftWidth = ((leftWidth + dx) * 100) / container.getBoundingClientRect().width;

                // Tillat justering mellom 15 % og 85 % bredde
                if (newLeftWidth > 15 && newLeftWidth < 85) {
                    leftSide.style.flex = `0 0 ${newLeftWidth}%`;
                    kart.invalidateSize();
                }
            };

            const mouseUpHandler = function () {
                resizer.classList.remove('dragging');
                document.removeEventListener('mousemove', mouseMoveHandler);
                document.removeEventListener('mouseup', mouseUpHandler);
                kart.invalidateSize();
            };

            resizer.addEventListener('mousedown', mouseDownHandler);

            setTimeout(function () { kart.invalidateSize(); }, 200);
        });
    </script>
}