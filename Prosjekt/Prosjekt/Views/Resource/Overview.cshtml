@using Prosjekt.Models.ModelView
@using System.Globalization
@model IEnumerable<ResourceViewModel>

@{
    // Vanlige brukere ser bare sine egne ressurser
    var erAdmin = User.IsInRole("Admin");
    ViewData["Title"] = erAdmin ? "Oversikt over ressurser" : "Mine ressurser";
}

<link rel="stylesheet" href="~/css/resource-icons.css" asp-append-version="true" />

@functions {
    string RessursIkon(ResourceViewModel.ResourceType kategori) => kategori switch
    {
        ResourceViewModel.ResourceType.Vehicle => "vehicle",
        ResourceViewModel.ResourceType.Tool => "tool",
        ResourceViewModel.ResourceType.Clothing => "clothing",
        ResourceViewModel.ResourceType.Provision => "provision",
        ResourceViewModel.ResourceType.Materials => "materials",
        _ => "other"
    };

    string RessursIkonFil(ResourceViewModel.ResourceType kategori, bool tilgjengelig)
        => RessursIkon(kategori) + (tilgjengelig ? "" : "-unavailable") + ".svg";

    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Mat og utstyr",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };
}

<style>
    .resizable-container {
        display: flex;
        width: 100%;
        height: calc(100vh - 120px);
        min-height: 500px;
        position: relative;
    }

    /* Ressursoversikten starter på 45 % av bredden */
    .table-section {
        flex: 0 0 45%;
        min-width: 250px;
        overflow-y: auto;
        padding-right: 10px;
    }

    /* Kartet tar resten av bredden */
    .map-section {
        flex: 1 1 0;
        min-width: 200px;
        position: relative;
    }

    /* Drabar skillelinje */
    .resizer {
        width: 10px;
        background: #e0e0e0;
        cursor: col-resize;
        transition: background 0.2s;
        border-radius: 4px;
        margin: 0 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
    }

        .resizer:hover, .resizer.dragging {
            background: #0d6efd;
        }

        .resizer::after {
            content: "⋮";
            color: #666;
            font-weight: bold;
        }

        .resizer:hover::after, .resizer.dragging::after {
            color: white;
        }

    #oversiktRessursKart {
        width: 100%;
        height: 100%;
        border-radius: 8px;
    }

    .table-row-clickable {
        cursor: pointer;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    @if (User.IsInRole(Prosjekt.Models.Authorization.RoleNames.Admin))
    {
        <a asp-controller="Resource" asp-action="Export" class="btn btn-outline-success">Eksporter ressurser</a>
    }
</div>

<div class="resizable-container" id="splitWrapper">
    <!-- Tabell-seksjon (Ressursoversikt) -->
    <div class="table-section" id="tableBox">
        <div class="table-responsive bg-white p-3 shadow-sm border rounded h-100">
            <div class="row g-2 mb-3">
                <div class="col-md-7">
                    <input type="search" id="sokeFelt" class="form-control"
                           placeholder="Søk i navn eller beskrivelse" />
                </div>
                <div class="col-md-5">
                    <select id="typeFilter" class="form-select">
                        <option value="">Alle kategorier</option>
                        @foreach (var k in Enum.GetValues<ResourceViewModel.ResourceType>())
                        {
                            <option value="@k">@OversettKategori(k)</option>
                        }
                    </select>
                </div>
                <div class="col-md-12">
                    <input type="search" id="stedsFelt" class="form-control" placeholder="Søk på sted, f.eks. Kristiansand - trykk Enter"/>
                </div>
                <div class="col-md-12">

                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                        🖨️ Skriv ut listen
                    </button>
                </div>
                <div class="col-md-6 d-flex gap-2 align-items-center">
                    <button type="button" id="velgPunktBtn" class="btn btn-outline-primary btn-sm text-nowrap">
                        Velg punkt
                    </button>
                    <input type="number" id="radiusFelt" class="form-control form-control-sm" value="5" min="1" max="500" step="1" style="max-width: 90px;" />
                    <span class="small text-muted">km</span>
                </div>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th>Navn / Beskrivelse</th>
                        <th>Kategori</th>
                        <th>Antall</th>
                        <th>Status</th>
                        <th>Tidsrom</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var res in Model)
                        {
                            <tr class="table-row-clickable" data-lat="@((res.Latitude ?? 0).ToString(CultureInfo.InvariantCulture))" data-lng="@((res.Longitude ?? 0).ToString(CultureInfo.InvariantCulture))"
                                data-id="@res.Id" data-type="@res.Category" data-sok="@(($"{res.Name} {res.Description}").ToLower())" 
                                onclick="fokuserPaRessurs('@res.Id', @((res.Latitude ?? 0).ToString(CultureInfo.InvariantCulture)), @((res.Longitude ?? 0).ToString(CultureInfo.InvariantCulture)))">
                                <td>
                                    <strong>@res.Name</strong><br />
                                    <small class="text-secondary">@res.Description</small>
                                </td>
                                <td>
                                    <span class="resource-category">
                                        <img class="resource-category-icon"
                                             src="@Url.Content($"~/images/resources/{RessursIkonFil(res.Category, res.Availability)}")"
                                             width="28" height="28" alt="" />
                                        <span class="badge bg-secondary">@OversettKategori(res.Category)</span>
                                    </span>
                                </td>
                                <td class="small">
                                    @res.Available av @res.Quantity
                                    @if (res.Allocated > 0)
                                    {
                                        <br /><span class="badge bg-warning text-dark">@res.Allocated i bruk</span>
                                    }
                                </td>
                                <td>
                                    @if (res.Availability)
                                    {
                                        <span class="badge bg-success">Tilgjengelig</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Ikke tilgjengelig</span>
                                    }
                                </td>
                                <td class="small">
                                    Fra: @(res.AvailableFrom?.ToString("dd.MM.yyyy HH:mm") ?? "-")<br />
                                    Til: @(res.AvailableTo?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                                </td>
                                <td class="text-nowrap" onclick="event.stopPropagation();">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@res.Id" class="btn btn-sm btn-warning">Rediger</a>
                                        <form asp-action="Delete" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Er du sikker på at du vil slette @res.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">@(erAdmin ? "Ingen ressurser registrert ennå." : "Du har ikke registrert noen ressurser ennå.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Drabar skillelinje -->
    <div class="resizer" id="dragHandle"></div>

    <!-- Kart-seksjon -->
    <div class="map-section" id="mapBox">
        <div id="oversiktRessursKart" class="shadow-sm border"></div>
    </div>
</div>

@section Scripts {
    <script>
        var kart;
        var markorerMap = {};

        function fokuserPaRessurs(id, lat, lng) {
            if (lat && lng && markorerMap[id]) {
                kart.flyTo([lat, lng], 15, { duration: 1 });
                markorerMap[id].openPopup();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Konverter C#-modellen til JS uten kontaktinfo/reg-nr
            var ressurser = @Json.Serialize((Model ?? Enumerable.Empty<ResourceViewModel>()).Select(r => new
            {
                id = r.Id,
                name = r.Name,
                quantity = r.Quantity,
                isAvailable = r.Availability,
                categoryName = OversettKategori(r.Category),
                iconUrl = Url.Content($"~/images/resources/{RessursIkonFil(r.Category, r.Availability)}"),
                lat = r.Latitude,
                lng = r.Longitude
            }));

            // Initialiser kartet
            kart = L.map('oversiktRessursKart').setView([58.163, 8.003], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(kart);

            var bounds = [];

            ressurser.forEach(function (r) {
                var lat = parseFloat(r.lat);
                var lng = parseFloat(r.lng);
                if (!Number.isFinite(lat) || !Number.isFinite(lng) ||
                    lat < -90 || lat > 90 || lng < -180 || lng > 180) return;

                bounds.push([lat, lng]);

                var statusTekst = r.isAvailable
                    ? '<span style="color: green; font-weight: bold;">Tilgjengelig</span>'
                    : '<span style="color: red; font-weight: bold;">Opptatt</span>';

                var resourceIcon = L.icon({
                    iconUrl: r.iconUrl,
                    iconSize: [40, 40],
                    iconAnchor: [20, 20],
                    popupAnchor: [0, -22],
                    className: 'resource-map-icon'
                });

                var marker = L.marker([lat, lng], {
                    icon: resourceIcon,
                    title: r.categoryName + ': ' + r.name + (r.isAvailable ? ' – Tilgjengelig' : ' – Ikke tilgjengelig'),
                    alt: r.categoryName + ': ' + r.name + (r.isAvailable ? ' – Tilgjengelig' : ' – Ikke tilgjengelig')
                }).addTo(kart);
                markorerMap[r.id] = marker;

                var toppInnhold = `
                    <b>${escapeHtml(r.name)}</b> (${r.quantity} stk)<br/>
                    Status: ${statusTekst}<br/>`;

                marker.bindPopup(toppInnhold + '<div class="small text-muted mt-1"><i>Henter adresse...</i></div>');

                // Slå opp adresse via Nominatim API
                fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
                    .then(response => response.ok ? response.json() : null)
                    .then(data => {
                        var address = (data && data.display_name) ? data.display_name : 'Adresse ikke funnet';
                        marker.setPopupContent(toppInnhold + `<hr class="my-1"/><small>📍 <b>Adresse:</b> ${escapeHtml(address)}</small>`);
                    })
                    .catch(function () {
                        marker.setPopupContent(toppInnhold + '<hr class="my-1"/><small>📍 <b>Adresse:</b> Ikke tilgjengelig</small>');
                    });
            });
            
            var kjorFilter = settOppFilter(kart, [markorerMap]);
            settOppStedssok(kart, kjorFilter);
            settOppRadiusSok(kart, kjorFilter);

            if (bounds.length > 0) {
                kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 14 });
            }

            // --- DRAG / RESIZE LOGIKK ---
            const resizer = document.getElementById('dragHandle');
            const leftSide = document.getElementById('tableBox');
            const container = document.getElementById('splitWrapper');

            let x = 0;
            let leftWidth = 0;

            const mouseDownHandler = function (e) {
                x = e.clientX;
                leftWidth = leftSide.getBoundingClientRect().width;

                resizer.classList.add('dragging');
                document.addEventListener('mousemove', mouseMoveHandler);
                document.addEventListener('mouseup', mouseUpHandler);
            };

            const mouseMoveHandler = function (e) {
                const dx = e.clientX - x;
                const newLeftWidth = ((leftWidth + dx) * 100) / container.getBoundingClientRect().width;

                // Tillat justering mellom 15 % og 85 % bredde
                if (newLeftWidth > 15 && newLeftWidth < 85) {
                    leftSide.style.flex = `0 0 ${newLeftWidth}%`;
                    kart.invalidateSize();
                }
            };

            const mouseUpHandler = function () {
                resizer.classList.remove('dragging');
                document.removeEventListener('mousemove', mouseMoveHandler);
                document.removeEventListener('mouseup', mouseUpHandler);
                kart.invalidateSize();
            };

            resizer.addEventListener('mousedown', mouseDownHandler);

            setTimeout(function () { kart.invalidateSize(); }, 200);
        });
    </script>
}