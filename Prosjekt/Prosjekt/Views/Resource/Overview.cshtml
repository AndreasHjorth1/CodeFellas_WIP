@using Prosjekt.Models.ModelView
@using System.Globalization
@model IEnumerable<ResourceViewModel>

@{
    ViewData["Title"] = "Oversikt over ressurser";
}

@functions {
    string OversettKategori(ResourceViewModel.ResourceType k) => k switch
    {
        ResourceViewModel.ResourceType.Vehicle => "Kjøretøy",
        ResourceViewModel.ResourceType.Tool => "Verktøy",
        ResourceViewModel.ResourceType.Clothing => "Klær",
        ResourceViewModel.ResourceType.Provision => "Provisjon",
        ResourceViewModel.ResourceType.Materials => "Materialer",
        _ => "Annet"
    };
}

<h1 class="mb-4">Oversikt over ressurser</h1>

<div class="row min-vh-100 g-3">
    <!-- Tabell-seksjon -->
    <div class="col-lg-7">
        <div class="table-responsive bg-white p-3 rounded shadow-sm border">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Navn / Beskrivelse</th>
                        <th>Kategori</th>
                        <th>Antall</th>
                        <th>Status</th>
                        <th>Tidsrom</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        <tr>
                            <td>
                                <strong>@res.Name</strong><br />
                                <span class="small text-secondary">@res.Description</span>
                            </td>
                            <td>@OversettKategori(res.Category)</td>
                            <td>@res.Quantity</td>
                            <td>
                                @if (res.Availability)
                                {
                                    <span class="badge bg-success">Tilgjengelig</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Ikke tilgjengelig</span>
                                }
                            </td>
                            <td class="small">
                                Fra: @(res.AvailableFrom?.ToString("dd.MM.yyyy HH:mm") ?? "-")<br />
                                Til: @(res.AvailableTo?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@res.Id" class="btn btn-warning btn-sm">Rediger</a>
                                    <form asp-action="Delete" asp-route-id="@res.Id" method="post" onsubmit="return confirm('Er du sikker på at du vil slette denne ressursen?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">Slett</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Kart-seksjon -->
    <div class="col-lg-5">
        <div id="map" class="w-100 rounded shadow-sm border" style="min-height: 400px; height: 80vh; position: sticky; top: 1rem;"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Initialiser kartet
            var map = L.map('map').setView([58.163, 8.003], 12); // Standard sentrum (Kristiansand)

            // 2. Legg til kartfliser (Tile layer)
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);

            var bounds = [];

            // 3. Konverter C#-modellen til et JS-objekt uten kontaktinfo/reg-nr
            var resources = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Select(r => new
                {
                    id = r.Id,
                    name = r.Name,
                    quantity = r.Quantity,
                    isAvailable = r.Availability,
                    lat = r.Latitude,
                    lng = r.Longitude
            })));

            // 4. Looper gjennom alle ressurser og oppretter markører med adresseoppslag
            resources.forEach(function (res) {
                if (res.lat && res.lng) {
                    var lat = parseFloat(res.lat);
                    var lng = parseFloat(res.lng);
                    var pos = [lat, lng];

                    bounds.push(pos);

                    var statusBadge = res.isAvailable
                        ? '<span style="color: green; font-weight: bold;">Tilgjengelig</span>'
                        : '<span style="color: red; font-weight: bold;">Opptatt</span>';

                    var marker = L.marker(pos).addTo(map);

                    // Sett opp en midlertidig popup mens adressen hentes
                    var basePopupContent = `
                        <b>${res.name}</b> (${res.quantity} stk)<br/>
                        Status: ${statusBadge}<br/>
                        <div id="address-${res.id}" class="small text-muted mt-1"><i>Henter adresse...</i></div>
                    `;

                    marker.bindPopup(basePopupContent);

                    // Slå opp adresse via Nominatim API
                    var url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;
                    fetch(url)
                        .then(response => response.ok ? response.json() : null)
                        .then(data => {
                            var address = (data && data.display_name) ? data.display_name : 'Adresse ikke funnet';

                            // Oppdater popup-innholdet med adressen når den åpnes
                            var updatedPopupContent = `
                                <b>${res.name}</b> (${res.quantity} stk)<br/>
                                Status: ${statusBadge}<br/>
                                <hr class="my-1"/>
                                <small>📍 <b>Adresse:</b> ${address}</small>
                            `;
                            marker.setPopupContent(updatedPopupContent);
                        })
                        .catch(err => {
                            console.error('Kunne ikke hente adresse:', err);
                            var fallbackContent = `
                                <b>${res.name}</b> (${res.quantity} stk)<br/>
                                Status: ${statusBadge}<br/>
                                <hr class="my-1"/>
                                <small>📍 <b>Adresse:</b> Ikke tilgjengelig</small>
                            `;
                            marker.setPopupContent(fallbackContent);
                        });
                }
            });
        });
    </script>
}