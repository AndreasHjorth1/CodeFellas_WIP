@using Prosjekt.Models.ModelView
@model ResourceCreatorViewModel

@{ ViewData["Title"] = "Registrer ressurser"; }

<div class="position-relative w-100 overflow-hidden" style="height: calc(100vh - 80px); min-height: 500px;">
    <!-- Kart -->
    <div id="map" class="w-100 h-100"></div>

    <!-- Sidemeny -->
    <aside id="sideMeny" class="position-absolute top-0 end-0 h-100 tf-panel d-none" aria-labelledby="panelTittel"
           style="z-index: 1000; width: 440px; max-width: 100%; overflow-y: auto;">

        <div class="tf-panel-head">
            <div>
                <p class="tf-kicker">Ny registrering</p>
                <h2 id="panelTittel" class="tf-title fs-2">Registrer <em>ressurser.</em></h2>
                <p class="tf-lede">Du har valgt et punkt på kartet. Legg til én eller flere ressurser som står her.</p>
            </div>
            <button type="button" class="tf-close" id="lukkMenyBtn" aria-label="Lukk panelet">Lukk <span aria-hidden="true">✕</span></button>
        </div>

        <form asp-controller="Resource" asp-action="Create" method="post" autocomplete="off" id="hovedSkjema" class="tf-form" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="tf-error mb-3"></div>

            <!-- Steg 1: beskriv ressursen -->
            <section class="tf-block" aria-labelledby="steg1">
                <p class="tf-step" id="steg1"><span>01</span> Beskriv ressursen</p>

                <div class="tf-subcard">
                    <div class="mb-3">
                        <label for="kategoriVelger">Kategori<span class="tf-req" aria-hidden="true">*</span></label>
                        <select id="kategoriVelger" class="form-select" onchange="oppdaterSkjemavisning()">
                            <option value="Vehicle">Kjøretøy</option>
                            <option value="Provision">Provisjon</option>
                            <option value="Materials">Materialer</option>
                            <option value="Clothing">Klær</option>
                            <option value="Tool">Verktøy</option>
                            <option value="Other">Annet</option>
                        </select>
                    </div>

                    <!-- Underkategori: Kjøretøy -->
                    <div id="seksjonKjøretøy" class="kategori-seksjon mb-3">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="inputVehicleType">Kjøretøytype<span class="tf-req" aria-hidden="true">*</span></label>
                                <select id="inputVehicleType" class="form-select">
                                    <option value="Car">Bil</option><option value="Bus">Buss</option>
                                    <option value="Bicycle">Sykkel</option><option value="Motorcycle">Motorsykkel</option>
                                    <option value="Tractor">Traktor</option><option value="Truck">Lastebil</option>
                                    <option value="Dozer">Doser</option><option value="Excavator">Gravemaskin</option>
                                    <option value="Other">Annet</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="inputLicensePlate">Skiltnummer<span class="tf-req" aria-hidden="true">*</span></label>
                                <input id="inputLicensePlate" class="form-control" placeholder="EL 12345" autocapitalize="characters" />
                            </div>
                        </div>
                    </div>

                    <!-- Underkategori: Verktøy -->
                    <div id="seksjonVerktøy" class="kategori-seksjon mb-3" style="display:none;">
                        <label for="inputToolType">Verktøytype<span class="tf-req" aria-hidden="true">*</span></label>
                        <select id="inputToolType" class="form-select">
                            <option value="HandTool">Håndverktøy</option><option value="PowerTool">Elektroverktøy</option>
                            <option value="GardenTool">Hageverktøy</option><option value="MeasuringTool">Måleverktøy</option>
                            <option value="Other">Annet</option>
                        </select>
                    </div>

                    <!-- Underkategori: Materialer -->
                    <div id="seksjonMaterialer" class="kategori-seksjon mb-3" style="display:none;">
                        <label for="inputMaterialType">Materialtype<span class="tf-req" aria-hidden="true">*</span></label>
                        <select id="inputMaterialType" class="form-select">
                            <option value="Wood">Treverk (meter)</option><option value="Metal">Metall (kg/meter)</option>
                            <option value="Plastic">Plast (kg/meter)</option><option value="Glass">Glass (m²)</option>
                            <option value="Gravel">Grus (kg)</option><option value="Stone">Stein (kg)</option>
                            <option value="Soil">Jord (kg)</option><option value="Sand">Sand (kg)</option>
                            <option value="Other">Annet</option>
                        </select>
                    </div>

                    <!-- Underkategori: Klær -->
                    <div id="seksjonKlær" class="kategori-seksjon mb-3" style="display:none;">
                        <label for="inputSize">Størrelse<span class="tf-req" aria-hidden="true">*</span></label>
                        <select id="inputSize" class="form-select">
                            <option value="XS">XS</option><option value="S">S</option><option value="M">M</option>
                            <option value="L">L</option><option value="XL">XL</option><option value="XXL">XXL</option>
                        </select>
                    </div>

                    <!-- Underkategori: Provisjon -->
                    <div id="seksjonProvisjon" class="kategori-seksjon mb-3" style="display:none;">
                        <label for="inputProvisionType">Provisjonstype<span class="tf-req" aria-hidden="true">*</span></label>
                        <select id="inputProvisionType" class="form-select">
                            <option value="Water">Vann</option><option value="FoodOnePortion">Mat (1 porsjon)</option>
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-8">
                            <label for="inputName">Navn<span class="tf-req" aria-hidden="true">*</span></label>
                            <input id="inputName" class="form-control" placeholder="F.eks. Traktor med frontlaster" />
                        </div>
                        <div class="col-4">
                            <label for="inputQuantity">Antall<span class="tf-req" aria-hidden="true">*</span></label>
                            <input id="inputQuantity" type="number" min="1" value="1" inputmode="numeric" class="form-control tf-num" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="inputDescription">Beskrivelse<span class="tf-req" aria-hidden="true">*</span></label>
                        <textarea id="inputDescription" class="form-control" rows="2" placeholder="Hva den kan brukes til, og hva som trengs for å bruke den."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="inputPhoneNumber">Telefon til kontaktperson<span class="tf-req" aria-hidden="true">*</span></label>
                        <input id="inputPhoneNumber" type="tel" inputmode="tel" autocomplete="tel" class="form-control" placeholder="912 34 567" />
                        <span class="tf-hint">Vises først når ressursen er tildelt et behov.</span>
                    </div>

                    <div class="form-check mb-2">
                        <input id="inputAvailability" class="form-check-input" type="checkbox" checked />
                        <label class="form-check-label" for="inputAvailability">Kan brukes i oppdrag nå</label>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="inputAvailableFrom">Tilgjengelig fra<span class="tf-req" aria-hidden="true">*</span></label>
                            <input id="inputAvailableFrom" type="datetime-local" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label for="inputAvailableTo">Tilgjengelig til<span class="tf-req" aria-hidden="true">*</span></label>
                            <input id="inputAvailableTo" type="datetime-local" class="form-control" />
                        </div>
                    </div>

                    <p id="skjemaFeil" class="tf-error mb-3" role="alert" aria-live="assertive"></p>

                    <button type="button" class="tf-btn tf-btn--ghost w-100" onclick="leggTilIListe()">+ Legg i listen</button>
                </div>
            </section>

            <!-- Steg 2: kontroller listen -->
            <section class="tf-block" aria-labelledby="steg2">
                <p class="tf-step" id="steg2"><span>02</span> Kontroller listen</p>
                <table class="tf-table tf-table--compact" id="ressursTabell">
                    <thead><tr><th scope="col">Navn</th><th scope="col">Antall</th><th scope="col">Kategori</th><th scope="col"><span class="visually-hidden">Handling</span></th></tr></thead>
                    <tbody></tbody>
                </table>
                <p id="tomListe" class="tf-meta mt-2">Ingen ressurser i listen ennå. Fyll inn steg 1 og trykk «Legg i listen».</p>

                <!-- Her blir de skjulte input-feltene fra mekortListe lagt til -->
                <div id="skjulteInputFelter"></div>
            </section>

            <!-- Steg 3: plassering og innsending -->
            <section class="tf-block" aria-labelledby="steg3">
                <p class="tf-step" id="steg3"><span>03</span> Plassering</p>
                <div class="row g-2 mb-1">
                    <div class="col-6"><label asp-for="Latitude">Breddegrad</label><input asp-for="Latitude" id="Latitude" class="form-control" readonly required /></div>
                    <div class="col-6"><label asp-for="Longitude">Lengdegrad</label><input asp-for="Longitude" id="Longitude" class="form-control" readonly required /></div>
                </div>
                <span class="tf-hint mb-4">Klikk et annet sted på kartet for å flytte punktet.</span>

                <button type="submit" id="opprettKnapp" class="tf-btn w-100" onclick="return validerInnsending()">Opprett ressurser <span aria-hidden="true">&rarr;</span></button>
            </section>
        </form>
    </aside>
</div>

@section Scripts {
    <script>
                // Escaper tekst før den settes inn som HTML, så navn med < > " ' ikke ødelegger siden
        function esc(s) {
            return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        // Viser feilmelding i skjemaet i stedet for alert(), og flytter fokus til feltet
        function visFeil(melding, feltId) {
            var boks = document.getElementById('skjemaFeil');
            if (boks) boks.textContent = melding;
            if (feltId) { var felt = document.getElementById(feltId); if (felt) felt.focus(); }
        }
        let mekortListe = [];
        var sideMeny = document.getElementById('sideMeny');

        // Funksjon for fargede markører
        function getIkon(fargeNavn) {
            return new L.Icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
        }

        var ikonGronn = getIkon('green');

        // 1. Definer kartlagene med noWrap
        var osmKart = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
            attribution: '&copy; OpenStreetMap contributors',
            noWrap: true
        });

        var geonorgeTopo = L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
            attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>',
            noWrap: true
        });

        var geonorgeFlybilder = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: '&copy; Midlertidig satellitt (Esri) - Venter på Geonorge-tilgang',
            noWrap: true
        });

        // 2. Start kartet med grenser og fast verden
        var map = L.map('map', {
            center: [58.1467, 7.9956],
            zoom: 11,
            minZoom: 3,
            maxBounds: [
                [-90, -180],
                [90, 180]
            ],
            maxBoundsViscosity: 1.0,
            layers: [osmKart]
        });

        // 3. Lag menyen oppe i hjørnet for å bytte kart
        var bakgrunnsKart = {
            "Standard (OSM)": osmKart,
            "Topografisk (Geonorge)": geonorgeTopo,
            "Flybilder (Geonorge)": geonorgeFlybilder
        };
        L.control.layers(bakgrunnsKart).addTo(map);

        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        var drawControl = new L.Control.Draw({
            draw: {
                polygon: false, polyline: false, circle: false, rectangle: false,
                marker: { icon: ikonGronn }
            },
            edit: { featureGroup: drawnItems, remove: true }
        });
        map.addControl(drawControl);

        function settPosisjonOgVisMeny(lat, lng) {
            document.getElementById('Latitude').value = lat;
            document.getElementById('Longitude').value = lng;
            sideMeny.classList.remove('d-none');
            
            var menyBredde = sideMeny.offsetWidth || 420;
            map.flyTo([lat, lng], map.getZoom(), { animate: true, duration: 0.8 });
            setTimeout(function() { map.panBy([menyBredde / 2, 0], { animate: true, duration: 0.4 }); }, 300);
        }

        map.on('draw:created', function(e) {
            var layer = e.layer;
            drawnItems.clearLayers();
            layer.setIcon(ikonGronn);
            drawnItems.addLayer(layer);

            var latlng = layer.getLatLng();
            settPosisjonOgVisMeny(latlng.lat.toFixed(6), latlng.lng.toFixed(6));
        });

        map.on('click', function(e) {
            var lat = e.latlng.lat.toFixed(6);
            var lng = e.latlng.lng.toFixed(6);
            
            drawnItems.clearLayers();
            var newMarker = L.marker([lat, lng], { icon: ikonGronn });
            drawnItems.addLayer(newMarker);

            settPosisjonOgVisMeny(lat, lng);
        });

        document.getElementById('lukkMenyBtn').addEventListener('click', function() {
            sideMeny.classList.add('d-none');
            drawnItems.clearLayers();
            document.getElementById('Latitude').value = '';
            document.getElementById('Longitude').value = '';
        });

        function oppdaterSkjemavisning() {
            let valgtTekst = document.getElementById('kategoriVelger').value;
            document.querySelectorAll('.kategori-seksjon').forEach(s => s.style.display = 'none');
            if (valgtTekst === "Vehicle") document.getElementById('seksjonKjøretøy').style.display = 'block';
            else if (valgtTekst === "Tool") document.getElementById('seksjonVerktøy').style.display = 'block';
            else if (valgtTekst === "Materials") document.getElementById('seksjonMaterialer').style.display = 'block';
            else if (valgtTekst === "Clothing") document.getElementById('seksjonKlær').style.display = 'block';
            else if (valgtTekst === "Provision") document.getElementById('seksjonProvisjon').style.display = 'block';
        }

        function leggTilIListe() {
            let name = document.getElementById('inputName').value.trim();
            let description = document.getElementById('inputDescription').value.trim();
            let phoneNumber = document.getElementById('inputPhoneNumber').value.trim();
            let availability = document.getElementById('inputAvailability').checked;
            let availableFrom = document.getElementById('inputAvailableFrom').value;
            let availableTo = document.getElementById('inputAvailableTo').value;
            let quantity = document.getElementById('inputQuantity').value;
            
            let categorySelect = document.getElementById('kategoriVelger');
            let category = categorySelect.value;
            let categoryNameNO = categorySelect.options[categorySelect.selectedIndex].text;

            let vehicleType = document.getElementById('inputVehicleType') ? document.getElementById('inputVehicleType').value : '';
            let licensePlate = document.getElementById('inputLicensePlate') ? document.getElementById('inputLicensePlate').value.trim() : '';
            let toolType = document.getElementById('inputToolType') ? document.getElementById('inputToolType').value : '';
            let materialType = document.getElementById('inputMaterialType') ? document.getElementById('inputMaterialType').value : '';
            let size = document.getElementById('inputSize') ? document.getElementById('inputSize').value : '';
            let provisionType = document.getElementById('inputProvisionType') ? document.getElementById('inputProvisionType').value : '';

            // Sjekk at alle felt for ressursen er fylt ut før den legges til
                        if (!name) { visFeil("Vennligst fyll ut 'Navn'.", 'inputName'); return; }
            if (!description) { visFeil("Vennligst fyll ut 'Beskrivelse'.", 'inputDescription'); return; }
            if (!phoneNumber) { visFeil("Vennligst fyll ut 'Telefonnummer'.", 'inputPhoneNumber'); return; }
            if (!availableFrom) { visFeil("Vennligst velg 'Tilgjengelig fra'.", 'inputAvailableFrom'); return; }
            if (!availableTo) { visFeil("Vennligst velg 'Tilgjengelig til'.", 'inputAvailableTo'); return; }
            if (!quantity || quantity <= 0) { visFeil("Vennligst fyll ut et gyldig 'Antall'.", 'inputQuantity'); return; }
            if (category === "Vehicle" && !licensePlate) { visFeil("Vennligst fyll ut 'Skiltnummer'.", 'inputLicensePlate'); return; }

            mekortListe.push({ 
                name, description, phoneNumber, availability, availableFrom, availableTo, 
                quantity, category, categoryNameNO, vehicleType, licensePlate, toolType, 
                materialType, size, provisionType 
            });

            // Tøm feltene
            document.getElementById('inputName').value = '';
            document.getElementById('inputDescription').value = '';
            document.getElementById('inputPhoneNumber').value = '';
            document.getElementById('inputAvailableFrom').value = '';
            document.getElementById('inputAvailableTo').value = '';
            document.getElementById('inputQuantity').value = '1';
            if (document.getElementById('inputLicensePlate')) document.getElementById('inputLicensePlate').value = '';
            
            oppdaterTabell();
        }

                function oppdaterTabell() {
            let tbody = document.querySelector('#ressursTabell tbody');
            let skjulteInputs = document.getElementById('skjulteInputFelter');
            tbody.innerHTML = ''; skjulteInputs.innerHTML = '';

            mekortListe.forEach((item, index) => {
                tbody.innerHTML += `<tr><td>${esc(item.name)}</td><td>${esc(item.quantity)}</td><td>${esc(item.categoryNameNO)}</td><td class="text-end"><button type="button" class="tf-link tf-link--danger" onclick="fjernFraListe(${index})" aria-label="Fjern ${esc(item.name)} fra listen">Fjern</button></td></tr>`;

                let inputs = `
                    <input type="hidden" name="ResourceList[${index}].Name" value="${esc(item.name)}" />
                    <input type="hidden" name="ResourceList[${index}].Description" value="${esc(item.description)}" />
                    <input type="hidden" name="ResourceList[${index}].PhoneNumber" value="${esc(item.phoneNumber)}" />
                    <input type="hidden" name="ResourceList[${index}].Availability" value="${esc(item.availability)}" />
                    <input type="hidden" name="ResourceList[${index}].AvailableFrom" value="${esc(item.availableFrom)}" />
                    <input type="hidden" name="ResourceList[${index}].AvailableTo" value="${esc(item.availableTo)}" />
                    <input type="hidden" name="ResourceList[${index}].Quantity" value="${esc(item.quantity)}" />
                    <input type="hidden" name="ResourceList[${index}].Category" value="${esc(item.category)}" />
                `;

                if (item.category === "Vehicle") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].VehicleType" value="${esc(item.vehicleType)}" /><input type="hidden" name="ResourceList[${index}].LicensePlate" value="${esc(item.licensePlate)}" />`;
                } else if (item.category === "Tool") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].ToolType" value="${esc(item.toolType)}" />`;
                } else if (item.category === "Materials") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].MaterialType" value="${esc(item.materialType)}" />`;
                } else if (item.category === "Clothing") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].Size" value="${esc(item.size)}" />`;
                } else if (item.category === "Provision") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].ProvisionType" value="${esc(item.provisionType)}" />`;
                }
                skjulteInputs.innerHTML += inputs;
            });
            var antall = mekortListe.length;
            document.getElementById('tomListe').style.display = antall ? 'none' : 'block';
            document.getElementById('opprettKnapp').innerHTML = (antall ? 'Opprett ' + antall + ' ' + (antall === 1 ? 'ressurs' : 'ressurser') : 'Opprett ressurser') + ' <span aria-hidden="true">&rarr;</span>';
            visFeil('');
        }

        function validerInnsending() {
            if (mekortListe.length === 0) {
                visFeil("Du må legge til minst én ressurs i listen før du kan opprette!", null); return false;
            }
            return true;
        }

        function fjernFraListe(index) { mekortListe.splice(index, 1); oppdaterTabell(); }
        setTimeout(function () { map.invalidateSize(); }, 200);
    </script>
}