@using Prosjekt.Models.ModelView
@model ResourceCreatorViewModel

@{ ViewData["Title"] = "Opprett Ressurser"; }

<div class="position-relative w-100 overflow-hidden" style="height: calc(100vh - 80px); min-height: 500px;">
    <div id="map" class="w-100 h-100"></div>
    <div id="sideMeny" class="position-absolute top-0 start-0 h-100 bg-white shadow-lg p-4 rounded-end d-none" style="z-index: 1000; width: 420px; max-width: 100%; overflow-y: auto;">
        <button type="button" class="btn-close float-end mb-2" id="lukkMenyBtn" aria-label="Lukk"></button>
        <div class="clearfix"></div>
        <h2 class="mb-1">Registrer Ressurser</h2>
        <p class="text-muted small">Fyll inn ressurser for den valgte posisjonen på kartet.</p>
        <hr />

        <form asp-controller="Resource" asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="border p-3 mb-4 rounded bg-light">
                <h5 class="mb-3">Legg til ressurs i listen</h5>
                
                <div class="form-group mb-3"><label class="fw-bold">Navn</label><input id="inputName" class="form-control" placeholder="F.eks. Lastebil, Skrutrekker" /></div>
                <div class="form-group mb-3"><label class="fw-bold">Beskrivelse</label><textarea id="inputDescription" class="form-control" rows="2"></textarea></div>

                <!-- NYE FELTER: Kontaktpunkt og Tilgjengelighet -->
                <div class="form-group mb-3"><label class="fw-bold">Telefonnummer (Kontaktpunkt)</label><input id="inputPhoneNumber" class="form-control" placeholder="F.eks. 98765432" /></div>
                
                <div class="form-check mb-3">
                    <input id="inputAvailability" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label fw-bold" for="inputAvailability">Er tilgjengelig for oppdrag</label>
                </div>

                <!-- NYE FELTER: Tidspunkt / Frister -->
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1">Tilgjengelig fra</label>
                        <input id="inputAvailableFrom" type="datetime-local" class="form-control form-control-sm" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold mb-1">Tilgjengelig til</label>
                        <input id="inputAvailableTo" type="datetime-local" class="form-control form-control-sm" />
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="fw-bold">Kategori</label>
                    <select id="kategoriVelger" class="form-select" onchange="oppdaterSkjemavisning()">
                        <option value="Vehicle">Kjøretøy</option>
                        <option value="Provision">Provisjon</option>
                        <option value="Materials">Materialer</option>
                        <option value="Clothing">Klær</option>
                        <option value="Tool">Verktøy</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <div id="seksjonKjøretøy" class="kategori-seksjon mb-3">
                    <label class="fw-bold">Kjøretøytype</label>
                    <select id="inputVehicleType" class="form-select mb-2">
                        <option value="Car">Bil</option><option value="Bus">Buss</option>
                        <option value="Bicycle">Sykkel</option><option value="Motorcycle">Motorsykkel</option>
                        <option value="Tractor">Traktor</option><option value="Truck">Lastebil</option>
                        <option value="Dozer">Doser</option><option value="Excavator">Gravemaskin</option>
                        <option value="Other">Annet</option>
                    </select>
                    <label class="fw-bold">Skiltnummer</label>
                    <input id="inputLicensePlate" class="form-control" placeholder="F.eks. EL 12345" />
                </div>

                <div id="seksjonVerktøy" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Verktøystype</label>
                    <select id="inputToolType" class="form-select mb-2">
                        <option value="HandTool">Håndverktøy</option><option value="PowerTool">Elektroverktøy</option>
                        <option value="GardenTool">Hageverktøy</option><option value="MeasuringTool">Måleverktøy</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <div id="seksjonMaterialer" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Materialtype</label>
                    <select id="inputMaterialType" class="form-select">
                        <option value="Wood">Treverk</option><option value="Metal">Metall</option>
                        <option value="Plastic">Plast</option><option value="Glass">Glass</option>
                        <option value="Gravel">Grus</option><option value="Stone">Stein</option>
                        <option value="Soil">Jord</option><option value="Sand">Sand</option>
                        <option value="Other">Annet</option>
                    </select>
                </div>

                <div id="seksjonKlær" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Størrelse</label>
                    <select id="inputSize" class="form-select">
                        <option value="XS">XS</option><option value="S">S</option><option value="M">M</option>
                        <option value="L">L</option><option value="XL">XL</option><option value="XXL">XXL</option>
                    </select>
                </div>

                <div id="seksjonProvisjon" class="kategori-seksjon mb-3" style="display:none;">
                    <label class="fw-bold">Provisjonstype</label>
                    <select id="inputProvisionType" class="form-select">
                        <option value="Water">Vann</option><option value="FoodOnePortion">Mat (1 porsjon)</option>
                    </select>
                </div>

                <div class="form-group mb-3"><label class="fw-bold">Antall</label><input id="inputQuantity" type="number" min="1" value="1" class="form-control" /></div>
                <button type="button" class="btn btn-secondary w-100" onclick="leggTilIListe()">+ Legg i listen</button>
            </div>

            <h6 class="fw-bold">Ressurser som blir registrert:</h6>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered" id="ressursTabell">
                    <thead class="table-light"><tr><th>Navn</th><th>Antall</th><th>Kategori</th><th>Handling</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>

            <div id="skjulteInputFelter"></div>

            <div class="row g-2 mb-4">
                <div class="col-6"><label asp-for="Latitude" class="form-label small mb-1 fw-bold">Breddegrad</label><input asp-for="Latitude" id="Latitude" class="form-control form-control-sm" readonly required /></div>
                <div class="col-6"><label asp-for="Longitude" class="form-label small mb-1 fw-bold">Lengdegrad</label><input asp-for="Longitude" id="Longitude" class="form-control form-control-sm" readonly required /></div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Opprett alle ressurser</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        let mekortListe = [];
        var currentMarker = null;
        var sideMeny = document.getElementById('sideMeny');

        var map = L.map('map').setView([58.1467, 7.9956], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(map);

        map.on('click', function(e) {
            var lat = e.latlng.lat.toFixed(6);
            var lng = e.latlng.lng.toFixed(6);
            document.getElementById('Latitude').value = lat;
            document.getElementById('Longitude').value = lng;
            if (currentMarker) map.removeLayer(currentMarker);
            currentMarker = L.marker([lat, lng]).addTo(map);
            sideMeny.classList.remove('d-none');
            var menyBredde = sideMeny.offsetWidth || 420;
            map.flyTo([lat, lng], map.getZoom(), { animate: true, duration: 0.8 });
            setTimeout(function() { map.panBy([-menyBredde / 2, 0], { animate: true, duration: 0.4 }); }, 300);
        });

        document.getElementById('lukkMenyBtn').addEventListener('click', function() {
            sideMeny.classList.add('d-none');
            if (currentMarker) {
                map.removeLayer(currentMarker);
                currentMarker = null;
                document.getElementById('Latitude').value = '';
                document.getElementById('Longitude').value = '';
            }
        });

        function oppdaterSkjemavisning() {
            let valgtTekst = document.getElementById('kategoriVelger').value;
            document.querySelectorAll('.kategori-seksjon').forEach(s => s.style.display = 'none');
            if (valgtTekst === "Vehicle") document.getElementById('seksjonKjøretøy').style.display = 'block';
            else if (valgtTekst === "Tool") document.getElementById('seksjonVerktøy').style.display = 'block';
            else if (valgtTekst === "Materials") document.getElementById('seksjonMaterialer').style.display = 'block';
            else if (valgtTekst === "Clothing") document.getElementById('seksjonKlær').style.display = 'block';
            else if (valgtTekst === "Provision") document.getElementById('seksjonProvisjon').style.display = 'block';
        }

        function leggTilIListe() {
            let name = document.getElementById('inputName').value;
            let description = document.getElementById('inputDescription').value;
            let phoneNumber = document.getElementById('inputPhoneNumber').value;
            let availability = document.getElementById('inputAvailability').checked;
            let availableFrom = document.getElementById('inputAvailableFrom').value;
            let availableTo = document.getElementById('inputAvailableTo').value;
            let quantity = document.getElementById('inputQuantity').value;
            
            let categorySelect = document.getElementById('kategoriVelger');
            let category = categorySelect.value;
            let categoryNameNO = categorySelect.options[categorySelect.selectedIndex].text;

            let vehicleType = document.getElementById('inputVehicleType') ? document.getElementById('inputVehicleType').value : '';
            let licensePlate = document.getElementById('inputLicensePlate') ? document.getElementById('inputLicensePlate').value : '';
            let toolType = document.getElementById('inputToolType') ? document.getElementById('inputToolType').value : '';
            let materialType = document.getElementById('inputMaterialType') ? document.getElementById('inputMaterialType').value : '';
            let size = document.getElementById('inputSize') ? document.getElementById('inputSize').value : '';
            let provisionType = document.getElementById('inputProvisionType') ? document.getElementById('inputProvisionType').value : '';

            if (!name || quantity <= 0 || !phoneNumber) { 
                alert("Vennligst fyll ut navn, telefonnummer og et gyldig antall."); 
                return; 
            }

            mekortListe.push({ 
                name, description, phoneNumber, availability, availableFrom, availableTo, 
                quantity, category, categoryNameNO, vehicleType, licensePlate, toolType, 
                materialType, size, provisionType 
            });

            // Tøm feltene
            document.getElementById('inputName').value = '';
            document.getElementById('inputDescription').value = '';
            document.getElementById('inputPhoneNumber').value = '';
            document.getElementById('inputQuantity').value = '1';
            if (document.getElementById('inputLicensePlate')) document.getElementById('inputLicensePlate').value = '';
            
            oppdaterTabell();
        }

        function oppdaterTabell() {
            let tbody = document.querySelector('#ressursTabell tbody');
            let skjulteInputs = document.getElementById('skjulteInputFelter');
            tbody.innerHTML = ''; skjulteInputs.innerHTML = '';

            mekortListe.forEach((item, index) => {
                tbody.innerHTML += `<tr><td>${item.name}</td><td>${item.quantity}</td><td>${item.categoryNameNO}</td><td><button type="button" class="btn btn-danger btn-sm" onclick="fjernFraListe(${index})">X</button></td></tr>`;

                let inputs = `
                    <input type="hidden" name="ResourceList[${index}].Name" value="${item.name}" />
                    <input type="hidden" name="ResourceList[${index}].Description" value="${item.description}" />
                    <input type="hidden" name="ResourceList[${index}].PhoneNumber" value="${item.phoneNumber}" />
                    <input type="hidden" name="ResourceList[${index}].Availability" value="${item.availability}" />
                    <input type="hidden" name="ResourceList[${index}].AvailableFrom" value="${item.availableFrom}" />
                    <input type="hidden" name="ResourceList[${index}].AvailableTo" value="${item.availableTo}" />
                    <input type="hidden" name="ResourceList[${index}].Quantity" value="${item.quantity}" />
                    <input type="hidden" name="ResourceList[${index}].Category" value="${item.category}" />
                `;

                if (item.category === "Vehicle") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].VehicleType" value="${item.vehicleType}" /><input type="hidden" name="ResourceList[${index}].LicensePlate" value="${item.licensePlate}" />`;
                } else if (item.category === "Tool") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].ToolType" value="${item.toolType}" />`;
                } else if (item.category === "Materials") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].MaterialType" value="${item.materialType}" />`;
                } else if (item.category === "Clothing") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].Size" value="${item.size}" />`;
                } else if (item.category === "Provision") {
                    inputs += `<input type="hidden" name="ResourceList[${index}].ProvisionType" value="${item.provisionType}" />`;
                }
                skjulteInputs.innerHTML += inputs;
            });
        }

        function fjernFraListe(index) { mekortListe.splice(index, 1); oppdaterTabell(); }
        setTimeout(function () { map.invalidateSize(); }, 200);
    </script>
}