@{
    ViewData["Title"] = "Eksporter data";
}

@* Eksportsiden for offentlige aktører. Ressursene hentes fra ResourceController, behovene fra NeedController. *@
<h1 class="mb-2">Eksporter data</h1>
<p class="text-muted">
    Last ned ressurser og behov som CSV (Excel) eller GeoJSON.
    GeoJSON kan åpnes direkte i kartprogrammer som QGIS, ArcGIS eller geojson.io.
</p>

<h2 class="h4 mt-4">Ressurser</h2>

<h5 class="mt-3">Tilgjengelige ressurser</h5>
<p class="text-muted">Kun ressurser som er markert som tilgjengelige for oppdrag.</p>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-controller="Resource" asp-action="ExportCsv" asp-route-bareTilgjengelige="true" class="btn btn-success">Eksporter CSV</a>
    <a asp-controller="Resource" asp-action="ExportGeoJson" asp-route-onlyAvailable="true" class="btn btn-primary">Eksporter GeoJSON</a>
</div>

<h5>Alle registrerte ressurser</h5>
<p class="text-muted">Alle ressurser, også de som ikke er tilgjengelige.</p>
<div class="d-flex flex-wrap gap-2 mb-5">
    <a asp-controller="Resource" asp-action="ExportCsv" asp-route-bareTilgjengelige="false" class="btn btn-outline-success">Eksporter CSV</a>
    <a asp-controller="Resource" asp-action="ExportGeoJson" asp-route-onlyAvailable="false" class="btn btn-outline-primary">Eksporter GeoJSON</a>
</div>

<h2 class="h4">Behov</h2>

<h5 class="mt-3">Åpne behov</h5>
<p class="text-muted">Behov som ikke er løst ennå (status Ny, Vurderes eller Tildelt).</p>
<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-controller="Need" asp-action="ExportCsv" asp-route-onlyOpen="true" class="btn btn-success">Eksporter CSV</a>
    <a asp-controller="Need" asp-action="ExportGeoJson" asp-route-onlyOpen="true" class="btn btn-primary">Eksporter GeoJSON</a>
</div>

<h5>Alle registrerte behov</h5>
<p class="text-muted">Alle behov, også de som er løst.</p>
<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Need" asp-action="ExportCsv" asp-route-onlyOpen="false" class="btn btn-outline-success">Eksporter CSV</a>
    <a asp-controller="Need" asp-action="ExportGeoJson" asp-route-onlyOpen="false" class="btn btn-outline-primary">Eksporter GeoJSON</a>
</div>
