<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Totalforsvaret</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.css"
          integrity="sha512-gc3xjCmIy673V6MyOAZhIW93xhM9ei1I+gLbmFjUHIjocENRsLX/QUE1htk5q1XV2D/iie/VQ8DXI6Vu8bexvQ=="
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Prosjekt.styles.css" asp-append-version="true" />

    <style>
            html, body {
                height: 100%;
                margin: 0;
                padding: 0;
                background-color: #f7f5f0;
                color: #1a3048;
                font-family: system-ui, -apple-system, sans-serif;
            }

            /* 1. Mørkeblå toppstripe med rød topplinje og svart bunnlinje */
            .top-alert-bar {
                background-color: #0b2238;
                color: #ffffff;
                font-size: 0.72rem;
                letter-spacing: 1px;
                text-transform: uppercase;
                font-weight: 600;
                border-top: 3px solid #d9534f;
                border-bottom: 2px solid #000000;
            }

            .alert-dot {
                width: 7px;
                height: 7px;
                background-color: #20c997;
                border-radius: 50%;
                display: inline-block;
            }

            /* 2. Hoved-Navbar */
            .custom-navbar {
                background-color: #f7f5f0;
                padding: 0.8rem 0;
            }

            .logo-line {
                height: 2px;
                width: 15px;
            }

            .logo-line-red {
                background-color: #d9534f;
            }

            .logo-line-blue {
                background-color: #5b768d;
            }

            .logo-text {
                font-family: Georgia, serif;
                font-size: 1.4rem;
            }

            /* Knapper */
            .btn-custom-outline, .btn-custom-dark {
                border-radius: 2px;
                padding: 0.45rem 1.25rem;
                font-weight: 600;
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 1px;
                text-decoration: none;
            }

            .btn-custom-outline {
                border: 1px solid #1a3048;
                color: #1a3048;
                background-color: transparent;
            }

                .btn-custom-outline:hover {
                    background-color: #e9e5dd;
                    color: #1a3048;
                }

            .btn-custom-dark {
                background-color: #0b2238;
                color: #ffffff !important;
                border: none;
            }

                .btn-custom-dark:hover {
                    background-color: #061424;
                    color: #ffffff;
                }

            /* Skillelinjer */
            .grid-border-bottom {
                border-bottom: 2px solid #1a3048 !important;
            }

            .menu-header-text {
                font-size: 0.75rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            main {
                padding-bottom: 0 !important;
                margin-bottom: 0 !important;
                background-color: #f7f5f0;
            }

            /* Navbar for brukere som ikke er innlogget */
            .public-navbar {
                background-color: #04245a;
                padding: 0.9rem 0;
            }

            .public-navbar .public-nav-inner {
                max-width: 1100px;
                margin: 0 auto;
                padding: 0 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .public-navbar .public-nav-links {
                display: flex;
                align-items: center;
                gap: 1.75rem;
            }

            .public-navbar .public-nav-link {
                position: relative;
                color: #ffffff;
                font-size: 0.95rem;
                font-weight: 600;
                text-decoration: none;
                padding-bottom: 0.35rem;
            }

            .public-navbar .public-nav-link.brand {
                font-size: 1.15rem;
                font-weight: 700;
            }

            .public-navbar .public-nav-link:hover {
                color: #d6deeb;
            }

            /* Rosa strek under siden man er på */
            .public-navbar .public-nav-link.active::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                width: 1.4rem;
                height: 2px;
                background-color: #e0607e;
            }

            .public-navbar .public-nav-buttons {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }

            .public-navbar .btn-public {
                border: 1px solid rgba(255, 255, 255, 0.7);
                border-radius: 2px;
                color: #ffffff;
                background-color: transparent;
                font-size: 0.95rem;
                padding: 0.5rem 1.1rem;
                text-decoration: none;
                white-space: nowrap;
            }

            .public-navbar .btn-public:hover {
                background-color: rgba(255, 255, 255, 0.1);
                border-color: #ffffff;
                color: #ffffff;
            }

            .public-navbar .btn-public.wide {
                padding: 0.5rem 1.75rem;
            }

            /* Navn og initialer oppe til høyre når man er innlogget som bruker */
            .public-navbar .user-menu-toggle {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                background: transparent;
                border: none;
                color: #ffffff;
                font-size: 0.95rem;
                padding: 0;
            }

            .public-navbar .user-avatar {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background-color: #ffffff;
                color: #04245a;
                font-size: 0.75rem;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .public-navbar .dropdown-menu {
                border-radius: 4px;
                font-size: 0.95rem;
            }

    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        bool IsCurrent(string controller, string action) => currentController == controller && currentAction == action;

        /// Viser «ola.haugland@...» som «Ola Haugland» og «OH»
        var userName = User.Identity?.Name ?? "";
        var nameParts = userName.Split('@')[0]
            .Split(new[] { '.', '_', '-', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        var displayName = nameParts.Length > 0
            ? string.Join(" ", nameParts.Select(p => char.ToUpper(p[0]) + p[1..]))
            : userName;
        var initials = nameParts.Length >= 2
            ? $"{nameParts[0][0]}{nameParts[1][0]}"
            : displayName.Length >= 2 ? displayName[..2] : displayName;
    }

    @if (User.Identity == null || !User.Identity.IsAuthenticated)
    {
        bool IsCurrentHome(string action) => IsCurrent("Home", action);

        <!-- Navbar når man ikke er innlogget -->
        <header class="sticky-top">
            <nav class="public-navbar">
                <div class="public-nav-inner">

                    <div class="public-nav-links">
                        <a class="public-nav-link brand @(IsCurrentHome("FrontPage") ? "active" : "")"
                           asp-controller="Home" asp-action="FrontPage">
                            Totalforsvaret
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(IsCurrentHome("CrisisInformation") ? "active" : "")"
                           asp-controller="Home" asp-action="CrisisInformation">
                            Kriseinformasjon
                        </a>
                    </div>

                    <div class="public-nav-buttons">
                        <a class="btn-public" asp-controller="Account" asp-action="Register">Registrer</a>
                        <a class="btn-public wide" asp-controller="Account" asp-action="Login">Logg inn</a>
                    </div>

                </div>
            </nav>
        </header>
    }
    else if (!User.IsInRole("Admin") && !User.IsInRole("Coordinator"))
    {
        <!-- Navbar for innlogget bruker -->
        <header class="sticky-top">
            <nav class="public-navbar">
                <div class="public-nav-inner">

                    <div class="public-nav-links">
                        <a class="public-nav-link brand"
                           asp-controller="Resource" asp-action="Overview">
                            Totalforsvaret
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(IsCurrent("Resource", "Overview") ? "active" : "")"
                           asp-controller="Resource" asp-action="Overview">
                            Mine ressurser
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(currentController == "Resource" && currentAction != "Overview" ? "active" : "")"
                           asp-controller="Resource" asp-action="Index">
                            Registrer ressurs
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(IsCurrent("Home", "CrisisInformation") ? "active" : "")"
                           asp-controller="Home" asp-action="CrisisInformation">
                            Kriseinformasjon
                        </a>
                    </div>

                    <div class="dropdown">
                        <button class="user-menu-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="d-none d-sm-inline">@displayName</span>
                            <span class="user-avatar">@initials.ToUpper()</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Resource" asp-action="Overview">Mine ressurser</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Resource" asp-action="Index">Registrer ressurs</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Home" asp-action="CrisisInformation">Kriseinformasjon</a></li>
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Min profil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" data-confirm-logout>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Logg ut</button>
                                </form>
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </header>
    }
    else
    {
      /// «Kart» er forsiden med ?visning=kart, så den skal ikke også markere «Oversikt»
        var visKart = Context.Request.Query["visning"] == "kart";
        var erKoordinator = !User.IsInRole("Admin");

        <!-- Navbar for admin og koordinator -->
        <header class="sticky-top">
            <nav class="public-navbar">
                <div class="public-nav-inner">

                    <div class="public-nav-links">
                        <a class="public-nav-link brand"
                           asp-controller="Home" asp-action="Index">
                            Totalforsvaret
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(IsCurrent("Home", "Index") && !visKart ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            Oversikt
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(IsCurrent("Home", "Index") && visKart ? "active" : "")"
                           asp-controller="Home" asp-action="Index" asp-route-visning="kart">
                            Kart
                        </a>
                        <a class="public-nav-link d-none d-md-inline @(currentController == "Need" ? "active" : "")"
                           asp-controller="Need" asp-action="Overview">
                            Behov
                        </a>
                        @* d-md-flex og ikke d-md-inline, ellers havner lenken litt lavere enn de andre *@
                        <div class="dropdown d-none d-md-flex">
                            @* Ikke Bootstrap sin dropdown-toggle, den bruker ::after som også er den rosa streken *@
                            <a class="public-nav-link @(currentController == "Resource" ? "active" : "")"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Ressurser <i class="fa-solid fa-chevron-down ms-1 small" aria-hidden="true"></i>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Resource" asp-action="Overview">Oversikt</a></li>
                                <li><a class="dropdown-item" asp-controller="Resource" asp-action="MyResources">Mine ressurser</a></li>
                            </ul>
                        </div>
                        <a class="public-nav-link d-none d-md-inline @(currentController == "AuditLog" ? "active" : "")"
                           asp-controller="AuditLog" asp-action="Index">
                            Logg
                        </a>
                        @* Bare admin kan opprette brukere (CreateUser krever Admin-rollen) *@
                        @if (!erKoordinator)
                        {
                            <a class="public-nav-link d-none d-md-inline @(IsCurrent("Account", "CreateUser") ? "active" : "")"
                               asp-controller="Account" asp-action="CreateUser">
                                Opprett bruker
                            </a>
                        }
                    </div>

                    <div class="dropdown">
                        <button class="user-menu-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="d-none d-sm-inline">@displayName</span>
                            <span class="user-avatar">@initials.ToUpper()</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Home" asp-action="Index">Oversikt</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Home" asp-action="Index" asp-route-visning="kart">Kart</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Need" asp-action="Overview">Behov</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Resource" asp-action="Overview">Ressurser</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="Resource" asp-action="MyResources">Mine ressurser</a></li>
                            <li class="d-md-none"><a class="dropdown-item" asp-controller="AuditLog" asp-action="Index">Logg</a></li>
                            @if (!erKoordinator)
                            {
                                <li class="d-md-none"><a class="dropdown-item" asp-controller="Account" asp-action="CreateUser">Opprett bruker</a></li>
                            }
                            <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Min profil</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" data-confirm-logout>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item">Logg ut</button>
                                </form>
                            </li>
                        </ul>
                    </div>

                </div>
            </nav>
        </header>
    }


    <!-- HOVEDINNHOLD -->
    <div class="container-fluid flex-grow-1 d-flex flex-column p-0">
        <main role="main" class="flex-grow-1">
            @RenderBody()
        </main>
    </div>


    <!-- BOOTSTRAP OFFCANVAS MENY -->
    <div class="offcanvas offcanvas-start"
         tabindex="-1"
         id="offcanvasMenu"
         aria-labelledby="offcanvasMenuLabel"
         style="background-color: #f7f5f0;">

        <div class="offcanvas-header border-bottom border-secondary-subtle">
            <h5 class="offcanvas-title fw-bold" id="offcanvasMenuLabel">
                Meny
            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="offcanvas"
                    aria-label="Lukk">
            </button>
        </div>

        <div class="offcanvas-body p-0">
            <div class="list-group list-group-flush bg-transparent">

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin") || User.IsInRole("Coordinator"))
                    {
                        <!-- MENY FOR ADMIN OG KOORDINATOR -->

                        <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                            Generelt
                        </div>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Home" asp-action="Index">
                            Hjem
                        </a>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Home" asp-action="Privacy">
                            Personvern
                        </a>

                        <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                            Registrering
                        </div>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Resource" asp-action="Index">
                            Registrer ressurs
                        </a>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Need" asp-action="Index">
                            Registrer behov
                        </a>

                        <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                            Oversikt
                        </div>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Resource" asp-action="Overview">
                            Oversikt over ressurser
                        </a>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Need" asp-action="Overview">
                            Oversikt over behov
                        </a>
                    }
                    else
                    {
                        <!-- VANLIG BRUKER -->

                        <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                            Generelt
                        </div>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Home" asp-action="Index">
                            Hjem
                        </a>

                        <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                            Registrering
                        </div>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Resource" asp-action="Index">
                            Registrer ressurs
                        </a>

                        <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                            Oversikt
                        </div>

                        <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                           asp-controller="Resource" asp-action="Overview">
                            Mine ressurser
                        </a>
                    }
                }
                else
                {
                    <!-- IKKE INNLOGGET -->

                    <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                        Generelt
                    </div>

                    <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                       asp-controller="Home" asp-action="Privacy">
                        Personvern
                    </a>
                }

                <!-- FELLES MENYVALG FOR ALLE -->

                <div class="list-group-item bg-transparent text-muted fw-bold border-0 pt-3 menu-header-text">
                    Informasjon og kart
                </div>

                <a class="list-group-item list-group-item-action bg-transparent py-3 border-0"
                   asp-controller="Home" asp-action="CrisisInformation">
                    Kriseinformasjon
                </a>

            </div>
        </div>
    </div>


    <!-- POPUP SOM BEKREFTER UTLOGGING -->
    <div class="modal fade" id="logoutConfirmModal" tabindex="-1" aria-labelledby="logoutConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content" style="color: #04245a; border-radius: 8px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-semibold" id="logoutConfirmTitle">Logg ut</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Lukk"></button>
                </div>
                <div class="modal-body">
                    Er du sikker på at du vil logge ut?
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Avbryt</button>
                    <button type="button" class="btn text-white" id="logoutConfirmButton" style="background-color: #04245a;">Logg ut</button>
                </div>
            </div>
        </div>
    </div>


    <!-- SKRIPTER -->
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"
            integrity="sha512-ozq8xQKq6urvuU6jNgkfqAmT7jKN2XumbrX1JiB3TnF7tI48DPI4Gy1GXKD/V3EExgAs1V+pRO7vwtS1LHg0Gw=="
            crossorigin="anonymous"></script>
    <script src="~/js/leaflet-draw-no.js" asp-append-version="true"></script>

    <script nonce="@Context.CspNonce()">
        // Spør om brukeren vil logge ut før skjemaet sendes
        (function () {
            const modalElement = document.getElementById("logoutConfirmModal");
            if (!modalElement) return;

            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            let pendingForm = null;

            document.addEventListener("submit", function (event) {
                const form = event.target.closest("form[data-confirm-logout]");
                if (!form) return;

                event.preventDefault();
                pendingForm = form;
                modal.show();
            });

            // form.submit() utløser ikke submit-hendelsen, så popupen vises ikke på nytt
            document.getElementById("logoutConfirmButton").addEventListener("click", function () {
                if (pendingForm) pendingForm.submit();
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html> 