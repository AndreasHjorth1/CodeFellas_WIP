@using Prosjekt.Models.ModelView
@model ProfilePageViewModel

@{
    ViewData["Title"] = "Min profil";
    var name = Model.HasProfile && !string.IsNullOrWhiteSpace(Model.Profile.Username) ? Model.Profile.Username : null;
    var total = Model.Resources.Count;
}

@functions {
    string Period(ProfileResourceItem r)
    {
        const string f = "dd.MM.yyyy";
        if (r.AvailableFrom.HasValue && r.AvailableTo.HasValue)
            return $"{r.AvailableFrom.Value.ToString(f)} – {r.AvailableTo.Value.ToString(f)}";
        if (r.AvailableFrom.HasValue) return $"Fra {r.AvailableFrom.Value.ToString(f)}";
        if (r.AvailableTo.HasValue) return $"Til {r.AvailableTo.Value.ToString(f)}";
        return "Ingen tidsbegrensning";
    }
}

<style>
    /* Samme grunnstil som Home/FrontPage.cshtml */
    body {
        background-color: #f4efe8;
        color: #1a3048;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    .section-tag {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #1a3048;
        margin-bottom: 1.25rem;
    }

        .section-tag::before {
            content: "";
            display: inline-block;
            width: 22px;
            height: 1px;
            background-color: #d9534f;
        }

    .serif-title {
        font-family: "Playfair Display", "Georgia", serif;
        font-weight: 400;
        letter-spacing: -0.5px;
        color: #1a3048;
    }

    .serif-italic {
        font-family: "Playfair Display", "Georgia", serif;
        font-style: italic;
        font-weight: 400;
        color: #6c757d;
    }

    .display-huge { font-size: 3.2rem; line-height: 1.08; }
    .text-muted-custom { color: #5a6572; }
    .grid-border-bottom { border-bottom: 1px solid #e0d8cc; }
    .col-border-right { border-right: 1px solid #e0d8cc; }

    .btn-navy {
        background-color: #0f2b48;
        color: #ffffff;
        border-radius: 0;
        padding: 0.85rem 1.75rem;
        font-weight: 600;
        font-size: 0.725rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        border: none;
        transition: background-color 0.2s;
    }

        .btn-navy:hover, .btn-navy:focus-visible { background-color: #1d4670; color: #ffffff; }

    /* Profilside */
    .pf-lede { max-width: 520px; line-height: 1.65; }

    .pf-note {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #5a6572;
        border: 1px solid #e0d8cc;
        padding: 0.55rem 0.8rem;
    }

    .pf-saved {
        display: flex;
        align-items: center;
        gap: 10px;
        max-width: 520px;
        border-left: 3px solid #427c62;
        background-color: #ffffff;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
        margin-top: 1.25rem;
    }

    .pf-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #5a6572;
        margin-bottom: 0.35rem;
    }

    .pf-input {
        width: 100%;
        min-height: 44px;
        border: 0;
        border-bottom: 1px solid #8a8983;
        border-radius: 0;
        background: transparent;
        padding: 0.5rem 0;
        font-size: 1.0625rem; /* minst 16px: hindrer at iPhone zoomer inn */
        color: #1a3048;
    }

        .pf-input:focus { outline: none; border-bottom: 2px solid #0f2b48; }
        .pf-input.input-validation-error { border-bottom: 2px solid #b02a37; }
        .pf-input::placeholder { color: #8a8983; }

    .pf-hint { display: block; font-size: 0.75rem; color: #5a6572; margin-top: 0.35rem; }
    .pf-error { display: block; font-size: 0.85rem; color: #b02a37; margin-top: 0.35rem; }

    .pf-link, .pf-textbtn {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        background: none;
        border: 0;
        padding: 0;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #1a3048;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .pf-danger { color: #b02a37; }

    .pf-stat {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.7rem 0;
        border-bottom: 1px solid #e0d8cc;
        font-size: 0.9rem;
    }

        .pf-stat strong { font-variant-numeric: tabular-nums; }

    .shape-square { display: inline-block; width: 10px; height: 10px; flex-shrink: 0; }

    .pf-empty { border: 1px dashed #c9c1b4; padding: 2rem; max-width: 600px; }

    .pf-table { width: 100%; border-collapse: collapse; }

        .pf-table th {
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: #5a6572;
            text-align: left;
            padding: 0 1rem 0.75rem 0;
            border-bottom: 2px solid #1a3048;
        }

        .pf-table td {
            padding: 1.1rem 1rem 1.1rem 0;
            border-bottom: 1px solid #e0d8cc;
            vertical-align: top;
            font-size: 0.95rem;
        }

    .pf-res-name { display: block; font-family: "Playfair Display", "Georgia", serif; font-size: 1.15rem; }
    .pf-meta { display: block; font-size: 0.75rem; color: #5a6572; margin-top: 0.2rem; }
    .pf-num { font-variant-numeric: tabular-nums; white-space: nowrap; }

    .pf-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .pf-actions { white-space: nowrap; text-align: right; }
        .pf-actions form { display: inline; margin-left: 1.25rem; }

    @@media (max-width: 991.98px) {
        .col-border-right { border-right: none; border-bottom: 1px solid #e0d8cc; }
        .display-huge { font-size: 2.4rem; }
    }

    /* Mobil: tabellen blir til kort, én ressurs per blokk */
    @@media (max-width: 767.98px) {
        .pf-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
        .pf-table, .pf-table tbody, .pf-table tr, .pf-table td { display: block; width: 100%; }
        .pf-table tr { border-bottom: 1px solid #1a3048; padding: 0.75rem 0; }

        .pf-table td {
            display: flex;
            justify-content: space-between;
            gap: 1rem;
            border: 0;
            padding: 0.35rem 0;
            text-align: right;
        }

            .pf-table td::before {
                content: attr(data-label);
                font-size: 0.65rem;
                font-weight: 700;
                letter-spacing: 2px;
                text-transform: uppercase;
                color: #5a6572;
                text-align: left;
            }

            .pf-table td.pf-first { display: block; text-align: left; }
            .pf-table td.pf-first::before, .pf-table td.pf-actions::before { content: none; }
            .pf-table td.pf-actions { justify-content: flex-start; }
    }
</style>

<!-- ========================================== -->
<!-- 1. TOPP                                    -->
<!-- ========================================== -->
<section class="grid-border-bottom">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-lg-3 col-border-right p-4 p-md-5">
                <div class="section-tag" style="margin: 0;">Min profil</div>
            </div>
            <div class="col-lg-9 p-4 p-md-5">
                <h1 class="display-huge serif-title mb-3">
                    @if (name is null)
                    {
                        <text>Din <span class="serif-italic">profil.</span></text>
                    }
                    else
                    {
                        <text>Hei, <span class="serif-italic">@(name).</span></text>
                    }
                </h1>
                <p class="text-muted-custom pf-lede mb-3">
                    Her endrer du kontaktinformasjonen din og ser alle ressursene du har registrert.
                </p>
                <span class="pf-note">Midlertidig: profilen lagres bare i denne nettleseren til innlogging er på plass</span>

                @if (Model.Saved)
                {
                    <div class="pf-saved" role="status">
                        <span class="shape-square" style="background-color: #427c62;"></span>
                        Endringene er lagret.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div class="pf-saved" role="status">
                        <span class="shape-square" style="background-color: #427c62;"></span>
                        @Model.Message
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- 2. KONTAKTINFORMASJON                      -->
<!-- ========================================== -->
<section class="grid-border-bottom">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-lg-3 col-border-right p-4 p-md-5">
                <div class="section-tag">Kontaktinformasjon</div>
                <h2 class="fs-2 serif-title mt-2">Slik når<br />vi deg.</h2>
                <p class="text-muted-custom small mb-0 mt-3" style="line-height: 1.6;">
                    Mobilnummeret brukes når en av ressursene dine blir tildelt et behov, og til å finne ressursene du har registrert.
                </p>
            </div>

            <div class="col-lg-9 p-4 p-md-5">
                <form asp-controller="Profile" asp-action="Index" method="post" style="max-width: 720px;">
                    <div asp-validation-summary="ModelOnly" class="pf-error mb-3"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="Profile.Username" class="pf-label"></label>
                            <input asp-for="Profile.Username" class="pf-input" autocomplete="username" placeholder="f.eks. kari.nordmann" />
                            <span asp-validation-for="Profile.Username" class="pf-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profile.PhoneNumber" class="pf-label"></label>
                            <input asp-for="Profile.PhoneNumber" type="tel" inputmode="tel" class="pf-input" autocomplete="tel" placeholder="912 34 567" />
                            <span class="pf-hint">Bruk samme nummer som da du registrerte ressursene.</span>
                            <span asp-validation-for="Profile.PhoneNumber" class="pf-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Profile.Email" class="pf-label"></label>
                            <input asp-for="Profile.Email" type="email" inputmode="email" class="pf-input" autocomplete="email" placeholder="kari@eksempel.no" />
                            <span class="pf-hint">Valgfritt.</span>
                            <span asp-validation-for="Profile.Email" class="pf-error"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Profile.Address" class="pf-label"></label>
                            <input asp-for="Profile.Address" class="pf-input" autocomplete="street-address" placeholder="Gateadresse, postnummer og sted" />
                            <span class="pf-hint">Valgfritt.</span>
                            <span asp-validation-for="Profile.Address" class="pf-error"></span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-4 mt-5">
                        <button type="submit" class="btn btn-navy d-inline-flex align-items-center gap-3">
                            Lagre endringer <span aria-hidden="true">&rarr;</span>
                        </button>
                        <a asp-controller="Profile" asp-action="Index" class="pf-link">Avbryt</a>
                    </div>
                </form>

                @if (Model.HasProfile)
                {
                    <form asp-controller="Profile" asp-action="Clear" method="post" class="mt-4"
                          onsubmit="return confirm('Fjerne profilen fra denne nettleseren? Ressursene dine blir ikke slettet.');">
                        <button type="submit" class="pf-textbtn pf-danger">Fjern profilen fra denne nettleseren</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- 3. MINE RESSURSER                          -->
<!-- ========================================== -->
<section class="grid-border-bottom">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-lg-3 col-border-right p-4 p-md-5">
                <div class="section-tag">Mine ressurser</div>

                @if (Model.HasProfile)
                {
                    <h2 class="fs-2 serif-title mt-2">@total <span class="serif-italic">registrert.</span></h2>

                    <div class="mt-4">
                        <div class="pf-stat">
                            <span class="d-inline-flex align-items-center gap-2"><span class="shape-square" style="background-color: #427c62;"></span> Ledige</span>
                            <strong>@Model.AvailableCount</strong>
                        </div>
                        <div class="pf-stat">
                            <span class="d-inline-flex align-items-center gap-2"><span class="shape-square" style="background-color: #a8a8a8;"></span> Utilgjengelige</span>
                            <strong>@Model.UnavailableCount</strong>
                        </div>
                        @if (Model.ExpiredCount > 0)
                        {
                            <div class="pf-stat">
                                <span class="d-inline-flex align-items-center gap-2"><span class="shape-square" style="background-color: #a8a8a8;"></span> Utløpt tidsrom</span>
                                <strong>@Model.ExpiredCount</strong>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <h2 class="fs-2 serif-title mt-2">Alt du har<br />registrert.</h2>
                }

                <a asp-controller="Resource" asp-action="Index" class="btn btn-navy d-inline-flex align-items-center gap-3 mt-4">
                    Registrer ny ressurs <span aria-hidden="true">&rarr;</span>
                </a>
            </div>

            <div class="col-lg-9 p-4 p-md-5">
                @if (!Model.HasProfile)
                {
                    <div class="pf-empty">
                        <h3 class="fs-5 serif-title">Ingen profil lagret ennå</h3>
                        <p class="text-muted-custom mb-0" style="line-height: 1.6;">
                            Fyll inn brukernavn og mobilnummer over og trykk «Lagre endringer». Da vises ressursene
                            du har registrert med det mobilnummeret her.
                        </p>
                    </div>
                }
                else if (total == 0)
                {
                    <div class="pf-empty">
                        <h3 class="fs-5 serif-title">Ingen ressurser funnet</h3>
                        <p class="text-muted-custom mb-3" style="line-height: 1.6;">
                            Vi fant ingen ressurser registrert med <strong>@Model.Profile.PhoneNumber</strong>.
                            Ressurser kobles til profilen via mobilnummeret du oppga da du registrerte dem.
                        </p>
                        <a asp-controller="Resource" asp-action="Index" class="pf-link">Registrer din første ressurs &rarr;</a>
                    </div>
                }
                else
                {
                    <table class="pf-table">
                        <caption class="visually-hidden">Ressurser registrert med @Model.Profile.PhoneNumber</caption>
                        <thead>
                            <tr>
                                <th scope="col">Ressurs</th>
                                <th scope="col">Kategori</th>
                                <th scope="col">Antall</th>
                                <th scope="col">Tilgjengelig</th>
                                <th scope="col">Status</th>
                                <th scope="col"><span class="visually-hidden">Handlinger</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Resources)
                            {
                                var statusText = !r.IsAvailable ? "Utilgjengelig" : r.IsExpired ? "Utløpt" : "Ledig";
                                var statusColor = r.IsAvailable && !r.IsExpired ? "#427c62" : "#a8a8a8";
                                <tr>
                                    <td class="pf-first">
                                        <span class="pf-res-name">@r.Name</span>
                                        <span class="pf-meta">Registrert @r.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    </td>
                                    <td data-label="Kategori">
                                        <span>
                                            @r.CategoryLabel
                                            @if (!string.IsNullOrWhiteSpace(r.SubCategory))
                                            {
                                                <span class="pf-meta">@r.SubCategory</span>
                                            }
                                        </span>
                                    </td>
                                    <td data-label="Antall" class="pf-num">@r.Quantity</td>
                                    <td data-label="Tilgjengelig" class="pf-num">@Period(r)</td>
                                    <td data-label="Status">
                                        <span class="pf-status">
                                            <span class="shape-square" style="background-color: @statusColor;"></span>@statusText
                                        </span>
                                    </td>
                                    <td class="pf-actions">
                                        <form asp-controller="Profile" asp-action="ToggleAvailability" asp-route-id="@r.Id" method="post">
                                            <button type="submit" class="pf-textbtn">@(r.IsAvailable ? "Sett utilgjengelig" : "Sett tilgjengelig")</button>
                                        </form>
                                        <a asp-controller="Resource" asp-action="Edit" asp-route-id="@r.Id" class="pf-link ms-4">Rediger</a>
                                        <form asp-controller="Resource" asp-action="Delete" asp-route-id="@r.Id" method="post"
                                              onsubmit="return confirm('Slette denne ressursen? Dette kan ikke angres.');">
                                            <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Profile")" />
                                            <button type="submit" class="pf-textbtn pf-danger">Slett</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</section>

<!-- ========================================== -->
<!-- 4. KOMMER MED INNLOGGING                   -->
<!-- ========================================== -->
<section class="grid-border-bottom">
    <div class="container-fluid p-0">
        <div class="row g-0">
            <div class="col-lg-3 col-border-right p-4 p-md-5">
                <div class="section-tag">Konto</div>
                <h2 class="fs-2 serif-title mt-2">Kommer med<br /><span class="serif-italic">innlogging.</span></h2>
            </div>
            <div class="col-lg-9 p-4 p-md-5">
                <p class="text-muted-custom pf-lede mb-3">
                    Disse funksjonene krever brukerkontoer, og blir tilgjengelige når innlogging er på plass.
                </p>
                <div style="max-width: 600px;">
                    <div class="pf-stat"><span>Endre passord</span><span class="pf-note">Kommer</span></div>
                    <div class="pf-stat"><span>Logg ut</span><span class="pf-note">Kommer</span></div>
                    <div class="pf-stat"><span>Slett konto og alle ressursene dine</span><span class="pf-note">Kommer</span></div>
                    <div class="pf-stat"><span>Se om en ressurs er tildelt et behov («Tildelt», «Løst»)</span><span class="pf-note">Kommer</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}