@using Prosjekt.Models.ModelView
@model RessursViewModel

@{
    ViewData["Title"] = "Opprett ny ressurs";
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="Ressurs" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label asp-for="Navn"></label>
        <input asp-for="Navn" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Beskrivelse"></label>
        <input asp-for="Beskrivelse" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Antall"></label>
        <input asp-for="Antall" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary mt-3">Lagre</button>
</form>