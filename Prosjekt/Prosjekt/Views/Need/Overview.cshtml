@using Prosjekt.Models.ModelView
@model List<NeedViewModel>

@{
    ViewData["Title"] = "Oversikt over behov";
}

@functions {
    string Farge(ImportanceLevel v) => v switch 
    { 
        ImportanceLevel.Acute => "#dc3545", 
        _ => "#ffc107" 
    };

    string OversettViktighet(ImportanceLevel v) => v switch
    {
        ImportanceLevel.Acute => "Akutt behov",
        _ => "Planlagt behov"
    };

    string OversettNeedType(NeedViewModel.NeedType type) => type switch
    {
        NeedViewModel.NeedType.Food => "Mat/Vann",
        NeedViewModel.NeedType.Medicine => "Medisiner",
        NeedViewModel.NeedType.Transport => "Transport",
        NeedViewModel.NeedType.PowerGenerator => "Strøm/aggregat",
        NeedViewModel.NeedType.SnowRemoval => "Snørydding",
        NeedViewModel.NeedType.SandGravel => "Sand/grus",
        NeedViewModel.NeedType.Machinery => "Maskiner",
        NeedViewModel.NeedType.Evacuation => "Evakuering",
        NeedViewModel.NeedType.Communication => "Samband",
        NeedViewModel.NeedType.Personnel => "Mannskap",
        _ => "Annet"
    };
}

<h1 class="mb-4">Oversikt over behov</h1>

<div class="row min-vh-100 g-3">
    <!-- Tabell-seksjon -->
    <div class="col-lg-7 col-md-12">
        <div class="table-responsive bg-white p-3 shadow-sm border rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Navn / Beskrivelse</th>
                        <th>Type</th>
                        <th>Tlf</th>
                        <th>Frist</th>
                        <th>Status</th>
                        <th>Viktighet</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Name</strong><br />
                                    <small class="text-secondary">@item.Description</small>
                                </td>
                                <td><span class="badge bg-secondary">@OversettNeedType(item.Type)</span></td>
                                <td><small class="text-muted">📞 @item.Phone</small></td>
                                <td class="small">@(item.Deadline.HasValue ? item.Deadline.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                                <td>
                                    @if (item.IsFulfilled)
                                    {
                                        <span class="badge bg-success">Oppfylt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-outline-secondary text-dark border">Ikke oppfylt</span>
                                    }
                                </td>
                                <td><span class="badge" style="@($"background-color: {Farge(item.Importance)}")">@OversettViktighet(item.Importance)</span></td>
                                <td class="text-nowrap">
                                    <div class="d-flex gap-1">
                                        <a asp-controller="Need" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Rediger</a>
                                        <form asp-controller="Need" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Er du sikker på at du vil slette @item.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-muted text-center py-4">Ingen behov registrert ennå.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Kart-seksjon -->
    <div class="col-lg-5 col-md-12">
        <div id="oversiktBehovKart" class="w-100 rounded shadow-sm border" style="min-height: 400px; height: 80vh; position: sticky; top: 1rem;"></div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var behov = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
            
            // 1. Initialiser kartet
            var kart = L.map('oversiktBehovKart').setView([58.163, 8.003], 12);
            
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { 
                attribution: '&copy; OpenStreetMap contributors' 
            }).addTo(kart);

            function getIkon(fargeNavn) {
                return new L.Icon({
                    iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                    iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
                });
            }
            
            var ikoner = { 0: getIkon('red'), 1: getIkon('gold') };

            behov.forEach(function(b) {
                var lat = parseFloat(b.Latitude);
                var lng = parseFloat(b.Longitude);
                if (isNaN(lat) || isNaN(lng)) return;

                var statusTekst = b.IsFulfilled 
                    ? '<span style="color: green; font-weight: bold;">Oppfylt</span>' 
                    : '<span style="color: red; font-weight: bold;">Ikke oppfylt</span>';

                var valgtIkon = ikoner[b.Importance] || ikoner[0];
                var marker = L.marker([lat, lng], { icon: valgtIkon }).addTo(kart);

                // Sett opp en midlertidig popup mens adressen hentes
                var basePopupContent = `
                    <b>${b.Name}</b><br/>
                    📞 Tlf: ${b.Phone || 'Ikke oppgitt'}<br/>
                    Status: ${statusTekst}<br/>
                    <div class="small text-muted mt-1"><i>Henter adresse...</i></div>
                `;
                marker.bindPopup(basePopupContent);

                // Slå opp adresse via Nominatim API
                var url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`;
                fetch(url)
                    .then(response => response.ok ? response.json() : null)
                    .then(data => {
                        var address = (data && data.display_name) ? data.display_name : 'Adresse ikke funnet';
                        
                        var updatedPopupContent = `
                            <b>${b.Name}</b><br/>
                            📞 Tlf: ${b.Phone || 'Ikke oppgitt'}<br/>
                            Status: ${statusTekst}<br/>
                            <hr class="my-1"/>
                            <small>📍 <b>Adresse:</b> ${address}</small>
                        `;
                        marker.setPopupContent(updatedPopupContent);
                    })
                    .catch(err => {
                        console.error('Kunne ikke hente adresse:', err);
                        var fallbackContent = `
                            <b>${b.Name}</b><br/>
                            📞 Tlf: ${b.Phone || 'Ikke oppgitt'}<br/>
                            Status: ${statusTekst}<br/>
                            <hr class="my-1"/>
                            <small>📍 <b>Adresse:</b> Ikke tilgjengelig</small>
                        `;
                        marker.setPopupContent(fallbackContent);
                    });
            });

            setTimeout(function () { kart.invalidateSize(); }, 200);
        });
    </script>
}