@using Prosjekt.Models.ModelView
@using Prosjekt.Models.Enums
@using System.Globalization
@model List<NeedViewModel>

@{
    ViewData["Title"] = "Oversikt over behov";
}

<link rel="stylesheet" href="~/css/need-icons.css" asp-append-version="true" />

@functions {
    string BehovIkon(NeedViewModel.NeedType type) => type switch
    {
        NeedViewModel.NeedType.Food => "food",
        NeedViewModel.NeedType.Medicine => "medicine",
        NeedViewModel.NeedType.Transport => "transport",
        NeedViewModel.NeedType.PowerGenerator => "power",
        NeedViewModel.NeedType.SnowRemoval => "snow",
        NeedViewModel.NeedType.SandGravel => "gravel",
        NeedViewModel.NeedType.Machinery => "machinery",
        NeedViewModel.NeedType.Evacuation => "evacuation",
        NeedViewModel.NeedType.Communication => "communication",
        NeedViewModel.NeedType.Personnel => "personnel",
        _ => "other"
    };

    string Farge(ImportanceLevel v) => v switch
    {
        ImportanceLevel.Acute => "#dc3545",
        _ => "#ffc107"
    };

    string OversettViktighet(ImportanceLevel v) => v switch
    {
        ImportanceLevel.Acute => "Akutt behov",
        _ => "Planlagt behov"
    };

    string OversettNeedType(NeedViewModel.NeedType type) => type switch
    {
        NeedViewModel.NeedType.Food => "Mat/Vann",
        NeedViewModel.NeedType.Medicine => "Medisiner",
        NeedViewModel.NeedType.Transport => "Transport",
        NeedViewModel.NeedType.PowerGenerator => "Strøm/aggregat",
        NeedViewModel.NeedType.SnowRemoval => "Snørydding",
        NeedViewModel.NeedType.SandGravel => "Sand/grus",
        NeedViewModel.NeedType.Machinery => "Maskiner",
        NeedViewModel.NeedType.Evacuation => "Evakuering",
        NeedViewModel.NeedType.Communication => "Samband",
        NeedViewModel.NeedType.Personnel => "Mannskap",
        _ => "Annet"
    };

    string OversettStatus(EntryStatus s) => s switch
    {
        EntryStatus.UnderReview => "Vurderes",
        EntryStatus.Assigned => "Tildelt",
        EntryStatus.Resolved => "Løst",
        _ => "Ny"
    };

    string StatusKlasse(EntryStatus s) => s switch
    {
        EntryStatus.UnderReview => "bg-warning text-dark",
        EntryStatus.Assigned => "bg-primary",
        EntryStatus.Resolved => "bg-success",
        _ => "bg-secondary"
    };
}

<style>
    .resizable-container {
        display: flex;
        width: 100%;
        height: calc(100vh - 120px);
        min-height: 500px;
        position: relative;
    }

    /* Behovsoversikten starter på 45 % av bredden */
    .table-section {
        flex: 0 0 45%;
        min-width: 250px;
        overflow-y: auto;
        padding-right: 10px;
    }

    /* Kartet tar resten av bredden */
    .map-section {
        flex: 1 1 0;
        min-width: 200px;
        position: relative;
    }

    /* Drabar skillelinje */
    .resizer {
        width: 10px;
        background: #e0e0e0;
        cursor: col-resize;
        transition: background 0.2s;
        border-radius: 4px;
        margin: 0 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        user-select: none;
    }

        .resizer:hover, .resizer.dragging {
            background: #0d6efd;
        }

        .resizer::after {
            content: "⋮";
            color: #666;
            font-weight: bold;
        }

        .resizer:hover::after, .resizer.dragging::after {
            color: white;
        }

    #oversiktBehovKart {
        width: 100%;
        height: 100%;
        border-radius: 8px;
    }

    .table-row-clickable {
        cursor: pointer;
    }
</style>

<h1 class="mb-3">Oversikt over behov</h1>

<div class="resizable-container" id="splitWrapper">
    <!-- Tabell-seksjon (Behovsoversikt) -->
    <div class="table-section" id="tableBox">
        <div class="table-responsive bg-white p-3 shadow-sm border rounded h-100">
            <div class="row g-2 mb-3">
                <div class="col-md-7">
                    <input type="search" id="sokeFelt" class="form-control" placeholder="Søk i navn, beskrivelse eller telefon" />
                </div>
                <div class="col-md-5">
                    <select id="typeFilter" class="form-select">
                        <option value="">Alle typer</option>
                        @foreach (var t in Enum.GetValues<NeedViewModel.NeedType>())
                        {
                            <option value="@t">@OversettNeedType(t)</option>
                        }
                    </select>
                </div>
                <div class="col-md-12">
                    <input type="search" id="stedsFelt" class="form-control" placeholder="Søk på sted, f.eks. Kristiansand - trykk Enter" />
                </div>
                <div class="col-md-12">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                        🖨️ Skriv ut listen
                    </button>
                </div>
                <div class="col-md-6 d-flex gap-2 align-items-center">
                    <button type="button" id="velgPunktBtn" class="btn btn-outline-primary btn-sm text-nowrap">
                        Velg punkt
                    </button>
                    <input type="number" id="radiusFelt" class="form-control form-control-sm" value="5" min="1" max="500" step="1" style="max-width: 90px;" />
                    <span class="small text-muted">km</span>
                </div>
            </div>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th>Navn / Beskrivelse</th>
                        <th>Type</th>
                        <th>Tlf</th>
                        <th>Frist</th>
                        <th>Status</th>
                        <th>Viktighet</th>
                        <th>Handlinger</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="table-row-clickable" data-lat="@((item.Latitude ?? 0).ToString(CultureInfo.InvariantCulture))" data-lng="@((item.Longitude ?? 0).ToString(CultureInfo.InvariantCulture))"
                                data-id="@item.Id" data-type="@item.Type" data-sok="@(($"{item.Name} {item.Description} {item.Phone}").ToLower())" onclick="fokuserPaBehov('@item.Id', @((item.Latitude ?? 0).ToString(CultureInfo.InvariantCulture)), @((item.Longitude ?? 0).ToString(CultureInfo.InvariantCulture)))">
                                <td>
                                    <strong>@item.Name</strong><br />
                                    <small class="text-secondary">@item.Description</small>
                                </td>
                                <td>
                                    <span class="need-type">
                                        <img class="need-type-icon"
                                             src="@Url.Content($"~/images/needs/{BehovIkon(item.Type)}.svg")"
                                             width="28" height="28" alt="" />
                                        <span class="badge bg-secondary">@OversettNeedType(item.Type)</span>
                                    </span>
                                </td>
                                <td><small class="text-muted">📞 @item.Phone</small></td>
                                <td class="small">@(item.Deadline.HasValue ? item.Deadline.Value.ToString("dd.MM.yyyy HH:mm") : "-")</td>
                                <td><span class="badge @StatusKlasse(item.Status)">@OversettStatus(item.Status)</span></td>
                                <td><span class="badge" style="@($"background-color: {Farge(item.Importance)}")">@OversettViktighet(item.Importance)</span></td>
                                <td class="text-nowrap" onclick="event.stopPropagation();">
                                    <div class="d-flex gap-1">
                                        <a asp-controller="Need" asp-action="Match" asp-route-id="@item.Id" class="btn btn-sm btn-success">🔗 Finn ressurser</a>
                                        <a asp-controller="Need" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Rediger</a>
                                        <form asp-controller="Need" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Er du sikker på at du vil slette @item.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-muted text-center py-4">Ingen behov registrert ennå.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Drabar skillelinje -->
    <div class="resizer" id="dragHandle"></div>

    <!-- Kart-seksjon -->
    <div class="map-section" id="mapBox">
        <div id="oversiktBehovKart" class="shadow-sm border"></div>
    </div>
</div>

@section Scripts {
    <script>
        var kart;
        var markorerMap = {};
        var omraderMap = {};

        function fokuserPaBehov(id, lat, lng) {
            if (lat && lng && markorerMap[id]) {
                kart.flyTo([lat, lng], 15, { duration: 1 });
                markorerMap[id].openPopup();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            var behov = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model ?? new List<NeedViewModel>()).Select(b => new
            {
                id = b.Id,
                name = b.Name,
                phone = b.Phone,
                latitude = b.Latitude,
                longitude = b.Longitude,
                status = (int)b.Status,
                importance = (int)b.Importance,
                areaGeoJson = b.AreaGeoJson,
                areaSquareMeters = b.AreaSquareMeters,
                typeName = OversettNeedType(b.Type),
                importanceName = OversettViktighet(b.Importance),
                iconUrl = Url.Content($"~/images/needs/{BehovIkon(b.Type)}.svg"),
                iconClass = b.Importance == ImportanceLevel.Acute ? "need-map-acute" : "need-map-planned"
            })));

            // Initialiser kartet
            kart = L.map('oversiktBehovKart').setView([58.163, 8.003], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(kart);

            var bounds = [];
           
            var kjorFilter = settOppFilter(kart, [markorerMap, omraderMap]);
            settOppStedssok(kart, kjorFilter);
            settOppRadiusSok(kart, kjorFilter);

            behov.forEach(function (b) {
                var lat = parseFloat(b.latitude);
                var lng = parseFloat(b.longitude);
                if (isNaN(lat) || isNaN(lng)) return;

                bounds.push([lat, lng]);

                // b.status kommer som tall: 0 = Ny, 1 = Vurderes, 2 = Tildelt, 3 = Løst
                var statusNavn = ['Ny', 'Vurderes', 'Tildelt', 'Løst'][b.status] || 'Ny';
                var statusFarge = ['gray', 'orange', 'blue', 'green'][b.status] || 'gray';
                var statusTekst = `<span style="color: ${statusFarge}; font-weight: bold;">${statusNavn}</span>`;

                var valgtIkon = L.icon({
                    iconUrl: b.iconUrl,
                    iconSize: [40, 40],
                    iconAnchor: [20, 20],
                    popupAnchor: [0, -24],
                    className: 'need-map-icon ' + b.iconClass
                });
                var marker = L.marker([lat, lng], {
                    icon: valgtIkon,
                    title: b.typeName + ': ' + b.name + ' – ' + b.importanceName,
                    alt: b.typeName + ': ' + b.name + ' – ' + b.importanceName
                }).addTo(kart);
                markorerMap[b.id] = marker;

                if (b.areaGeoJson) {
                    var omrade = L.geoJSON(JSON.parse(b.areaGeoJson), {
                        style: {
                            color: b.importance === 0 ? '#dc3545' : '#fd7e14',
                            weight: 2,
                            fillOpacity: 0.12
                        }
                    }).addTo(kart);
                    omraderMap[b.Id] = omrade;

                    if (b.areaSquareMeters) {
                        omrade.bindTooltip(
                            `${b.name}: ca. ${b.areaSquareMeters} m²`,
                            { sticky: true }
                        );
                    }
                }

                var toppInnhold = `
                    <b>${b.name}</b><br/>
                    📞 Tlf: ${b.phone || 'Ikke oppgitt'}<br/>
                    Status: ${statusTekst}<br/>`;

                marker.bindPopup(toppInnhold + '<div class="small text-muted mt-1"><i>Henter adresse...</i></div>');

                // Slå opp adresse via Nominatim API
                fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
                    .then(response => response.ok ? response.json() : null)
                    .then(data => {
                        var address = (data && data.display_name) ? data.display_name : 'Adresse ikke funnet';
                        marker.setPopupContent(toppInnhold + `<hr class="my-1"/><small>📍 <b>Adresse:</b> ${address}</small>`);
                    })
                    .catch(function () {
                        marker.setPopupContent(toppInnhold + '<hr class="my-1"/><small>📍 <b>Adresse:</b> Ikke tilgjengelig</small>');
                    });
            });

            if (bounds.length > 0) {
                kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 14 });
            }

            // --- DRAG / RESIZE LOGIKK ---
            const resizer = document.getElementById('dragHandle');
            const leftSide = document.getElementById('tableBox');
            const container = document.getElementById('splitWrapper');

            let x = 0;
            let leftWidth = 0;

            const mouseDownHandler = function (e) {
                x = e.clientX;
                leftWidth = leftSide.getBoundingClientRect().width;

                resizer.classList.add('dragging');
                document.addEventListener('mousemove', mouseMoveHandler);
                document.addEventListener('mouseup', mouseUpHandler);
            };

            const mouseMoveHandler = function (e) {
                const dx = e.clientX - x;
                const newLeftWidth = ((leftWidth + dx) * 100) / container.getBoundingClientRect().width;

                // Tillat justering mellom 15 % og 85 % bredde
                if (newLeftWidth > 15 && newLeftWidth < 85) {
                    leftSide.style.flex = `0 0 ${newLeftWidth}%`;
                    kart.invalidateSize();
                }
            };

            const mouseUpHandler = function () {
                resizer.classList.remove('dragging');
                document.removeEventListener('mousemove', mouseMoveHandler);
                document.removeEventListener('mouseup', mouseUpHandler);
                kart.invalidateSize();
            };

            resizer.addEventListener('mousedown', mouseDownHandler);

            setTimeout(function () { kart.invalidateSize(); }, 200);
        });
    </script>
}