@using Prosjekt.Models.ModelView
@using Prosjekt.Models
@model List<NeedViewModel>

@{
    ViewData["Title"] = "Oversikt over behov";
}
@functions {
    string Farge(Importance v) => v switch { Importance.High => "#dc3545", Importance.Medium => "#ffc107", _ => "#198754" };

    string OversettViktighet(Importance v) => v switch
    {
        Importance.High => "Høy",
        Importance.Medium => "Middels",
        _ => "Lav"
    };
}
<h1 class="mb-4">Oversikt over behov</h1>
<div class="row">
    <div class="col-lg-7 col-md-12 mb-4">
        <div class="table-responsive shadow-sm border rounded">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Navn</th><th>Beskrivelse</th><th>Antall som trengs</th><th>Dekket</th><th>Viktighet</th><th>Handlinger</th></tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>@item.Total</td>
                                <td>
                                    @item.Covered / @item.Total
                                    <span class="badge bg-secondary">@item.Status</span>
                                </td>
                                <td><span class="badge" style="@($"background-color: {Farge(item.Importance)}")">@OversettViktighet(item.Importance)</span></td>
                                <td class="text-nowrap">
                                    <a asp-controller="Need" asp-action="Edit" asp-route-name="@item.Name" class="btn btn-sm btn-warning">Rediger</a>
                                    <form asp-controller="Need" asp-action="Delete" asp-route-name="@item.Name" method="post" style="display:inline;" onsubmit="return confirm('Er du sikker på at du vil slette @item.Name?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Slett</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">Ingen behov registrert ennå.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5 col-md-12">
        <div id="oversiktBehovKart" class="shadow-sm rounded" style="height: 65vh; min-height: 400px; border-radius: 8px;"></div>
    </div>
</div>

@section Scripts {
    <script>
        var behov = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
        var kart = L.map('oversiktBehovKart').setView([58.1467, 7.9956], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap contributors' }).addTo(kart);
        var bounds = [];

        function getIkon(fargeNavn) {
            return new L.Icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
            });
        }
        var ikoner = { 0: getIkon('green'), 1: getIkon('gold'), 2: getIkon('red') };

        behov.forEach(function(b) {
            var lat = parseFloat(b.Latitude);
            var lng = parseFloat(b.Longitude);
            if (isNaN(lat) || isNaN(lng)) return;

            var valgtIkon = ikoner[b.Importance] || ikoner[0];
            L.marker([lat, lng], { icon: valgtIkon })
                .bindTooltip(`<b>${b.Name}</b><br>Antall: ${b.Total}`)
                .addTo(kart);
            bounds.push([lat, lng]);
        });

        if (bounds.length > 0) kart.fitBounds(bounds, { padding: [30, 30], maxZoom: 13 });
        setTimeout(function () { kart.invalidateSize(); }, 200);
    </script>
}