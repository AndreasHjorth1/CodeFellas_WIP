<link rel="stylesheet" href="~/css/map-symbols.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.css" asp-append-version="true" />
<link rel="stylesheet" href="~/lib/leaflet-markercluster/MarkerCluster.Default.css" asp-append-version="true" />
@using Prosjekt.Models.ModelView
@using Prosjekt.Models.Enums
@model List<ResourceMatchViewModel>

@{
    ViewData["Title"] = "Passende ressurser";
    var allocations = ViewBag.Allocations as List<AllocationViewModel> ?? new List<AllocationViewModel>();
}

@functions {
        string RessursIkonFil(string? kategori, bool harLedige) =>
        (kategori switch
        {
            "Vehicle" => "vehicle",
            "Tool" => "tool",
            "Clothing" => "clothing",
            "Provision" => "provision",
            "Materials" => "materials",
            _ => "other"
        }) + (harLedige ? "" : "-unavailable") + ".svg";
    /// Viser avstand i meter under 1 km, ellers kilometer
    string FormatDistance(double meters) =>
        meters < 1000
            ? $"{Math.Round(meters)} m"
            : $"{(meters / 1000):0.0} km".Replace(".", ",");

    string OversettKategori(string? kategori) => kategori switch
    {
        "Vehicle" => "Kjøretøy",
        "Tool" => "Verktøy",
        "Clothing" => "Klær",
        "Provision" => "Mat og utstyr",
        "Materials" => "Materialer",
        "Other" => "Annet",
        _ => string.IsNullOrWhiteSpace(kategori) ? "Ikke oppgitt" : kategori
    };
}

<style>
        .match-resource-selected {
        border-radius: 50%;
        outline: 3px solid #04245a;
        outline-offset: 3px;
    }
    /* Raden man har trykket på får en annen farge, slik som på ressurssiden */
    .match-table tbody tr.match-row {
        cursor: pointer;
    }

    .match-table tbody tr.match-row[aria-expanded="true"] > td,
    .match-table tbody tr.match-row[aria-expanded="true"] + .match-detail-row > td {
        --bs-table-bg-state: #e6ecf5;
    }

    .match-table tbody tr.match-row[aria-expanded="true"] > td:first-child {
        box-shadow: inset 3px 0 0 #04245a, inset 0 0 0 9999px #e6ecf5;
    }

    /* Kolonneoverskrifter man kan trykke på for å sortere */
    .match-sort-btn {
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        font-weight: 600;
        color: inherit;
        white-space: nowrap;
    }

    .match-sort-btn i {
        font-size: 0.75rem;
        margin-left: 0.2rem;
        color: #6c757d;
    }

    th[aria-sort="ascending"] .match-sort-btn i {
        color: #04245a;
    }

    /* Luftlinje og kjøreavstand skal se like ut */
    .match-table .match-distance {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.4em 0.65em;
    }

    /* Luft på sidene, så raden med negative marger ikke stikker utenfor skjermen */
    .match-side {
        padding: 0 1rem;
    }

    /* Tettere celler, så tabellen får plass uten sidelengs rulling */
    .match-table > :not(caption) > * > * {
        padding: 0.6rem 0.45rem;
    }

    .match-table td:first-child {
        overflow-wrap: anywhere;
    }

    /* Antallsfeltet ligger over «Tildel»-knappen, så kolonnen blir smal */
    .match-tildel-skjema {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        width: 4.5rem;
    }

    .match-table .match-antall {
        width: 100%;
    }

    /* Mobil: hver ressurs blir et lite kort. Tabellhodet viser bare sorteringsknappene. */
    @@media (max-width: 575px) {
        .match-table,
        .match-table thead,
        .match-table tbody {
            display: block;
            width: 100%;
        }

        .match-table tbody tr.match-row > td {
            min-width: 0;
        }

        .match-table thead tr {
            display: flex;
            gap: 1.25rem;
        }

        .match-table thead th:not([aria-sort]) {
            display: none;
        }

        .match-table tbody tr.match-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            align-items: start;
        }

        .match-table tbody tr.match-row > td {
            border-bottom-width: 0;
        }

        .match-table tbody tr.match-row > td:first-child,
        .match-table tbody tr.match-row > td.match-tildel {
            grid-column: 1 / -1;
        }

        .match-table td[data-label]::before {
            content: attr(data-label);
            display: block;
            font-size: 0.75rem;
            font-weight: 600;
            color: #6c757d;
            margin-bottom: 0.2rem;
        }

        .match-table tbody tr.match-detail-row,
        .match-table tbody tr.match-detail-row > td {
            display: block;
        }

        .match-tildel-skjema {
            flex-direction: row;
            width: auto;
        }

        .match-table .match-antall {
            width: 4.5rem;
        }
    }

    .match-table .see-more-btn {
        background: none;
        border: none;
        padding: 0;
        margin-top: 0.25rem;
        color: #2d4f86;
        font-size: 0.85rem;
        text-decoration: underline;
    }

    .match-table .see-more-btn i {
        font-size: 0.7rem;
        margin-left: 0.15rem;
        transition: transform 0.2s;
    }

    .match-table .see-more-btn:not(.collapsed) i {
        transform: rotate(180deg);
    }

    /* Informasjonsraden er usynlig til «Se mer» åpner den */
    .match-table tbody tr.match-detail-row > td {
        padding: 0;
        border-bottom-width: 0;
    }

    .match-details {
        display: grid;
        grid-template-columns: 150px 1fr;
        gap: 0.4rem 1rem;
        margin: 0;
        padding: 0.25rem 0.75rem 1rem 1rem;
        border-bottom: 1px solid var(--bs-border-color);
        font-size: 0.85rem;
    }

    .match-details dt {
        font-weight: 600;
    }

    .match-details dd {
        margin: 0;
        overflow-wrap: anywhere;
    }

    /* Knappene under kartet - samme stil som «Meld behov» og «Eksporter» på oversikten */
    .match-btn-primary,
    .match-btn-outline {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        border-radius: 3px;
        font-size: 0.9rem;
        padding: 0.55rem 1.1rem;
        text-decoration: none;
        cursor: pointer;
    }

    .match-btn-primary {
        background-color: #04245a;
        border: 1px solid #04245a;
        color: #ffffff;
        font-weight: 700;
    }

    .match-btn-primary:hover,
    .match-btn-primary:focus {
        background-color: #0f3a80;
        border-color: #0f3a80;
        color: #ffffff;
    }

    .match-btn-outline {
        background-color: #ffffff;
        border: 1px solid #c3ccd8;
        color: #0b1f3a;
        font-weight: 600;
    }

    .match-btn-outline:hover,
    .match-btn-outline:focus {
        background-color: #f4f6f9;
        color: #0b1f3a;
    }

    @@media (max-width: 575px) {
        .match-details {
            grid-template-columns: 1fr;
            gap: 0.1rem;
        }

        .match-details dd {
            margin-bottom: 0.4rem;
        }
    }
</style>

@* Luft på sidene, ellers stikker .row (negative marger) utenfor skjermen og siden kan rulles sidelengs *@
<div class="match-side">
<h1 class="mb-1">Passende ressurser</h1>
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<p class="text-muted mb-3">
    For behovet <strong>@ViewBag.NeedName</strong> — nærmeste først.
</p>

<div class="row g-3">
    @* Tabellen trenger halve skjermen fra xl og opp. Under det ligger kartet under tabellen. *@
    <div class="col-xl-6">
        @if (allocations.Any())
        {
            <div class="border rounded p-3 mb-3 bg-light">
                <h5 class="mb-2">Allerede tildelt</h5>
                @foreach (var a in allocations)
                {
                    <form asp-action="Deallocate" method="post" class="d-flex align-items-center gap-2 mb-1">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="allocationId" value="@a.Id" />
                        <input type="hidden" name="needId" value="@ViewBag.NeedId" />
                        <span class="flex-grow-1">@a.Quantity × @a.ResourceName</span>
                        <button type="submit" class="btn btn-sm btn-outline-danger">Fjern</button>
                    </form>
                }
            </div>
        }
        @if (!Model.Any())
        {
            <div class="alert alert-warning">
                Ingen tilgjengelige ressurser passer dette behovet.
            </div>
        }
        else
        {
            @* Ingen table-responsive: tabellen er laget for å passe i bredden uten sidelengs rulling *@
            <div class="bg-white p-3 shadow-sm border rounded">
                <table class="table table-hover align-middle mb-0 match-table">
                    <thead class="table-light">
                        <tr>
                            <th>Navn</th>
                            <th>Ledig</th>
                            @* Luftlinje passer for helikopter, kjøreavstand for bil. Begge kan sorteres. *@
                            <th aria-sort="ascending">
                                <button type="button" class="match-sort-btn" data-sort="luft">
                                    Luft&shy;linje <i class="fa-solid fa-sort-up" aria-hidden="true"></i>
                                </button>
                            </th>
                            <th aria-sort="none">
                                <button type="button" class="match-sort-btn" data-sort="kjor">
                                    Kjøre&shy;avstand <i class="fa-solid fa-sort" aria-hidden="true"></i>
                                </button>
                            </th>
                            <th>Tildel</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model)
                        {
                            @* Raden og «Se mer» åpner informasjonen i raden under (Bootstrap collapse) *@
                            <tr class="match-row collapsed" data-id="@m.Id"
                                data-luft="@m.DistanceMeters.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                data-bs-toggle="collapse" data-bs-target="#ressursInfo-@m.Id"
                                aria-expanded="false" aria-controls="ressursInfo-@m.Id">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
    <img class="map-symbol-small"
         src="@Url.Content($"~/images/resources/{RessursIkonFil(m.Category, m.Available > 0)}")"
         width="28" height="28" alt="" />
    <strong>@m.Name</strong>
</div>
                                    <small class="text-secondary">@m.Description</small><br />
                                    <small class="text-muted">📞 @m.PhoneNumber</small>
                                    @if (m.AllocatedToThisNeed > 0)
                                    {
                                        <br /><span class="badge bg-success">@m.AllocatedToThisNeed tildelt dette behovet</span>
                                    }
                                    <br />
                                    <button type="button" class="see-more-btn collapsed"
                                            data-bs-toggle="collapse" data-bs-target="#ressursInfo-@m.Id"
                                            aria-expanded="false" aria-controls="ressursInfo-@m.Id">
                                        Se mer <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
                                    </button>
                                </td>
                                @* data-label vises som overskrift i cellen på mobil, der tabellhodet er skjult *@
                                <td class="small" data-label="Ledig">@m.Available av @m.Quantity</td>
                                <td class="text-nowrap" data-label="Luftlinje"><span class="badge bg-primary match-distance">@FormatDistance(m.DistanceMeters)</span></td>
                                @* Fylles inn av skriptet med svar fra Valhalla *@
                                <td id="kjor-@m.Id" class="text-nowrap" data-label="Kjøreavstand"><small class="text-muted">Henter …</small></td>
                                @* Tildel-skjemaet skal ikke åpne «Se mer» *@
                                <td class="match-tildel" data-stop-click>
                                    @if (ViewBag.NeedStatus == EntryStatus.Resolved)
                                    {
                                        <span class="badge bg-secondary">Behovet er løst</span>
                                    }
                                    else if (m.Available > 0)
                                    {
                                        <form asp-action="Allocate" method="post" class="match-tildel-skjema">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="needId" value="@ViewBag.NeedId" />
                                            <input type="hidden" name="resourceId" value="@m.Id" />
                                            <input type="number" name="quantity" value="1" min="1" max="@m.Available"
                                                   class="form-control form-control-sm match-antall" aria-label="Antall å tildele" />
                                            <button type="submit" class="btn btn-sm btn-success">Tildel</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Opptatt</span>
                                    }
                                </td>
                            </tr>
                            <tr class="match-detail-row">
                                <td colspan="5">
                                    <div class="collapse" id="ressursInfo-@m.Id">
                                        <dl class="match-details">
                                            <dt>Kategori</dt>
                                            <dd>@OversettKategori(m.Category)</dd>

                                            <dt>Antall</dt>
                                            <dd>@m.Quantity stk (@m.Allocated i bruk, @m.Available ledig)</dd>

                                            <dt>Tildelt dette behovet</dt>
                                            <dd>@m.AllocatedToThisNeed stk</dd>

                                            <dt>Avstand</dt>
                                            <dd>@FormatDistance(m.DistanceMeters) fra behovet (luftlinje)</dd>

                                            @* Fylles inn av skriptet når panelet åpnes *@
                                            <dt>Kjørerute</dt>
                                            <dd id="rute-@m.Id" aria-live="polite">Henter rute …</dd>

                                            <dt>Eier</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(m.OwnerName) ? "Ukjent" : m.OwnerName)</dd>

                                            <dt>Telefon</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(m.PhoneNumber) ? "Ikke oppgitt" : m.PhoneNumber)</dd>

                                            <dt>Beskrivelse</dt>
                                            <dd>@(string.IsNullOrWhiteSpace(m.Description) ? "Ingen beskrivelse" : m.Description)</dd>
                                        </dl>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-xl-6">
        <div id="matchKart" class="rounded shadow-sm" style="height: 60vh; min-height: 400px;"></div>

        @* Knappene ligger under kartet, så man slipper å bla ned forbi hele listen *@
        <div class="d-flex flex-wrap gap-2 mt-3">
            <a asp-action="Overview" class="match-btn-outline">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Tilbake til oversikten
            </a>
            @if (ViewBag.NeedStatus == EntryStatus.Resolved)
            {
                <form asp-action="Unresolve" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@ViewBag.NeedId" />
                    <button type="submit" class="match-btn-outline">
                        <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> Gjenåpne behovet
                    </button>
                </form>
            }
            else if (ViewBag.NeedStatus == EntryStatus.Assigned)
            {
                <form asp-action="Resolve" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@ViewBag.NeedId" />
                    <button type="submit" class="match-btn-primary">
                        <i class="fa-solid fa-check" aria-hidden="true"></i> Marker som løst
                    </button>
                </form>
            }
            else
            {
                @* Ny eller Vurderes: må få tildelt ressurser før det kan løses *@
                <button type="button" class="match-btn-primary" disabled
                        title="Tildel minst én ressurs før behovet kan markeres som løst">
                    <i class="fa-solid fa-check" aria-hidden="true"></i> Marker som løst
                </button>
                <small class="text-muted align-self-center">Tildel minst én ressurs først.</small>
            }
        </div>
    </div>
</div>
</div>

@section Scripts {

    <script src="~/lib/leaflet-markercluster/leaflet.markercluster.js" asp-append-version="true"></script>
    <script src="~/js/map-symbols.js"
            data-resources-url="@Url.Content("~/images/resources/")"
            data-needs-url="@Url.Content("~/images/needs/")"
            asp-append-version="true"></script>
    <script nonce="@Context.CspNonce()">
  
        var needLat = @ViewBag.NeedLat;
        var needLng = @ViewBag.NeedLng;
        var matches = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));

        var kart = L.map('matchKart').setView([needLat, needLng], 11);

        L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {

            attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>'

        }).addTo(kart);

        /// Kjørerutene kommer fra Valhalla, som bruker veidata fra OpenStreetMap
        kart.attributionControl.addAttribution(
            'Ruting: <a href="https://valhalla.github.io/valhalla/">Valhalla</a> / &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        );

        /// Behovet selv - rød sirkel i midten
        L.circleMarker([needLat, needLng], {
            radius: 10, color: '#dc3545', fillColor: '#dc3545', fillOpacity: 0.8
        }).addTo(kart).bindPopup('<b>' + escapeHtml(@Json.Serialize((string)ViewBag.NeedName)) + '</b><br/>Behovet');

        var punkter = [[needLat, needLng]];

        /// Markørene etter ressurs-id, så en valgt rad kan finne sin markør
        var resourceMarkers = MapSymbols.createCluster(kart);
        var markorer = {};
        var vanligeIkoner = {};
        var valgteIkoner = {};
        var luftlinjer = {};

        matches.forEach(function (m) {

            var harLedige = m.Available > 0;
            var ikonUrl = MapSymbols.resourceUrl(m.Category, harLedige);

            vanligeIkoner[m.Id] = MapSymbols.resourceIcon(m.Category, harLedige);
            valgteIkoner[m.Id] = MapSymbols.icon(ikonUrl, 'match-resource-selected');

            markorer[m.Id] = L.marker([m.Coords.Latitude, m.Coords.Longitude], {
                icon: vanligeIkoner[m.Id],
                title: m.Name,
                alt: m.Name
            }).addTo(resourceMarkers).bindPopup(
          
                `<b>${escapeHtml(m.Name)}</b><br/>Antall: ${m.Quantity}<br/>📞 ${escapeHtml(m.PhoneNumber)}`
            );

            /// Strek fra behovet til ressursen
            luftlinjer[m.Id] = L.polyline([[needLat, needLng], [m.Coords.Latitude, m.Coords.Longitude]], {
                color: '#198754', weight: 1, opacity: 0.4, dashArray: '4 4'
            }).addTo(kart);

            punkter.push([m.Coords.Latitude, m.Coords.Longitude]);
        });

        if (punkter.length > 1) {
            kart.fitBounds(punkter, { padding: [30, 30] });
        }

        /// Når «Se mer» åpnes for en ressurs, utheves markøren og kjøreruten vises.
        /// Når den lukkes igjen, får markøren vanlig stil.
        function markorForPanel(panel) {
            if (!panel.id || !panel.id.startsWith('ressursInfo-')) return null;
            return markorer[panel.id.replace('ressursInfo-', '')] || null;
        }

        document.addEventListener('show.bs.collapse', function (e) {
            var markor = markorForPanel(e.target);
            if (!markor) return;
            var id = e.target.id.replace('ressursInfo-', '');
            markor.setIcon(valgteIkoner[id]);
            markor.setZIndexOffset(1000);
            apnePaneler[id] = true;
            /// Viser ressursen og behovet med en gang. Når ruten kommer, tilpasses kartet til den.
            /// (Zoom inn til markøren kolliderte med zoomen til ruten, så den er tatt bort her.)
            kart.fitBounds([[needLat, needLng], markor.getLatLng()], { padding: [30, 30] });
            visRute(id);
        });

        document.addEventListener('hide.bs.collapse', function (e) {
            var markor = markorForPanel(e.target);
                        if (!markor) return;
            var id = e.target.id.replace('ressursInfo-', '');
            markor.setIcon(vanligeIkoner[id]);
            markor.setZIndexOffset(0);
            delete apnePaneler[id];
            skjulRute(id);
        });

        /// Kjørerute langs veien fra Valhalla (offentlig server, ingen nøkkel).
        /// Ruten hentes først når «Se mer» åpnes, så vi ikke sender mange kall når siden lastes.
        var VALHALLA_URL = 'https://valhalla1.openstreetmap.de/route';
        var ruter = {};      /// Ferdige ruter per ressurs-id, så vi slipper å hente samme rute igjen
        var ruteLag = {};    /// Rutene som vises på kartet nå
        /// Paneler som er åpne. Vi kan ikke bruke klassen «show», for Bootstrap setter den først
        /// når animasjonen er ferdig, og Valhalla svarer ofte før det.
        var apnePaneler = {};

        function visRute(id) {
            var m = matches.find(function (x) { return String(x.Id) === String(id); });
            if (!m) return;

            if (ruter[id]) {
                tegnRute(id, ruter[id]);
                return;
            }

            var foresporsel = {
                locations: [
                    { lat: m.Coords.Latitude, lon: m.Coords.Longitude },
                    { lat: needLat, lon: needLng }
                ],
                costing: 'auto',
                units: 'kilometers',
                directions_type: 'none'
            };

            /// GET med json-parameter, så nettleseren slipper et ekstra CORS-kall før selve foresporselen
            fetch(VALHALLA_URL + '?json=' + encodeURIComponent(JSON.stringify(foresporsel)))
                .then(function (svar) {
                    if (!svar.ok) throw new Error('Valhalla svarte ' + svar.status);
                    return svar.json();
                })
                .then(function (data) {
                    var tur = data.trip;
                    ruter[id] = {
                        punkter: tur.legs.flatMap(function (leg) { return dekodPolyline(leg.shape, 6); }),
                        km: tur.summary.length,
                        sekunder: tur.summary.time
                    };
                    /// Brukeren kan ha lukket panelet mens vi ventet
                    if (apnePaneler[id]) {
                        tegnRute(id, ruter[id]);
                    }
                })
                .catch(function () {
                    settRuteTekst(id, 'Fant ingen kjørerute. Viser luftlinje på kartet.');
                });
        }

        function tegnRute(id, rute) {
            skjulRute(id);
            if (luftlinjer[id]) kart.removeLayer(luftlinjer[id]);

            /// Blå med hvit kant under, så ruten skiller seg fra blått vann og bygninger i Kartverket-kartet
            ruteLag[id] = L.featureGroup([
                L.polyline(rute.punkter, { color: '#ffffff', weight: 9, opacity: 1 }),
                L.polyline(rute.punkter, { color: '#0d6efd', weight: 5, opacity: 1 })
            ]).addTo(kart);

            kart.fitBounds(ruteLag[id].getBounds(), { padding: [30, 30] });
            settRuteTekst(id, formaterKm(rute.km) + ' med bil, ca. ' + formaterTid(rute.sekunder));
        }

        function skjulRute(id) {
            if (ruteLag[id]) {
                kart.removeLayer(ruteLag[id]);
                delete ruteLag[id];
            }
            if (luftlinjer[id] && !kart.hasLayer(luftlinjer[id])) {
                luftlinjer[id].addTo(kart);
            }
        }

        function settRuteTekst(id, tekst) {
            var felt = document.getElementById('rute-' + id);
            if (felt) felt.textContent = tekst;
        }

        function formaterKm(km) {
            return km < 1
                ? Math.round(km * 1000) + ' m'
                : km.toFixed(1).replace('.', ',') + ' km';
        }

        function formaterTid(sekunder) {
            var minutter = Math.max(1, Math.round(sekunder / 60));
            if (minutter < 60) return minutter + ' min';
            var timer = Math.floor(minutter / 60);
            var rest = minutter % 60;
            return timer + ' t' + (rest > 0 ? ' ' + rest + ' min' : '');
        }

        /// --- Kjøreavstand i tabellen ---
        /// Ett Matrix-kall til Valhalla gir kjøreavstand fra hver ressurs til behovet.
        /// Retningen er ressurs → behov, samme som ruten i «Se mer», så tallene stemmer overens.
        var VALHALLA_MATRIX_URL = 'https://valhalla1.openstreetmap.de/sources_to_targets';
        /// Den offentlige serveren har grense på antall punkter, så vi spør bare for de nærmeste
        var MAKS_KJOREAVSTANDER = 25;

        function hentMatrise(ressurser) {
            var foresporsel = {
                sources: ressurser.map(function (m) {
                    return { lat: m.Coords.Latitude, lon: m.Coords.Longitude };
                }),
                targets: [{ lat: needLat, lon: needLng }],
                costing: 'auto',
                units: 'kilometers'
            };
            return fetch(VALHALLA_MATRIX_URL + '?json=' + encodeURIComponent(JSON.stringify(foresporsel)))
                .then(function (svar) {
                    /// 400 betyr at minst ett punkt ikke har vei. Andre feil betyr at serveren ikke svarte som den skulle.
                    if (svar.status === 400) throw { ingenVei: true };
                    if (!svar.ok) throw { ingenVei: false };
                    return svar.json();
                })
                .then(function (data) {
                    /// Én rad per ressurs, med ett mål (behovet)
                    return data.sources_to_targets.map(function (rad) { return rad[0]; });
                });
        }

        function visKjoreavstand(id, km, sekunder) {
            var celle = document.getElementById('kjor-' + id);
            var rad = document.querySelector('tr.match-row[data-id="' + id + '"]');
            if (!celle || !rad) return;

            if (km == null) {
                celle.textContent = 'Ingen vei';
                rad.dataset.kjor = 'ingen';
                return;
            }
            celle.innerHTML = '<span class="badge bg-primary match-distance">' + formaterKm(km) + '</span>'
                + '<small class="d-block text-muted mt-1">' + formaterTid(sekunder) + '</small>';
            rad.dataset.kjor = String(km * 1000);
        }

        function visUkjentKjoreavstand(id) {
            var celle = document.getElementById('kjor-' + id);
            if (celle) celle.textContent = '–';
        }

        function hentKjoreavstander() {
            /// Listen fra serveren er allerede sortert på luftlinje, så de første er de nærmeste
            var utvalg = matches.slice(0, MAKS_KJOREAVSTANDER);
            matches.slice(MAKS_KJOREAVSTANDER).forEach(function (m) { visUkjentKjoreavstand(m.Id); });
            if (utvalg.length === 0) return;

            hentMatrise(utvalg)
                .then(function (svar) {
                    utvalg.forEach(function (m, i) {
                        visKjoreavstand(m.Id, svar[i].distance, svar[i].time);
                    });
                    sorterEtterValgtKolonne();
                })
                .catch(function (feil) {
                    if (!feil || !feil.ingenVei) {
                        utvalg.forEach(function (m) { visUkjentKjoreavstand(m.Id); });
                        return;
                    }
                    /// Ett punkt uten vei får hele kallet til å feile. Spør da for én og én ressurs,
                    /// så bare de som faktisk mangler vei får «Ingen vei».
                    Promise.all(utvalg.map(function (m) {
                        return hentMatrise([m])
                            .then(function (svar) { visKjoreavstand(m.Id, svar[0].distance, svar[0].time); })
                            .catch(function (f) {
                                if (f && f.ingenVei) visKjoreavstand(m.Id, null, null);
                                else visUkjentKjoreavstand(m.Id);
                            });
                    })).then(sorterEtterValgtKolonne);
                });
        }

        /// --- Sortering ---
        /// Hver ressurs har to rader (hovedraden og «Se mer»-raden), som flyttes sammen.
        var valgtSortering = 'luft';

        function sorteringsverdi(rad, kolonne) {
            if (kolonne === 'luft') return Number(rad.dataset.luft);
            /// Uten kjøreavstand havner ressursen nederst. «Ingen vei» kommer etter dem vi ikke fikk svar på.
            if (rad.dataset.kjor === 'ingen') return Infinity;
            if (rad.dataset.kjor === undefined) return Number.MAX_VALUE;
            return Number(rad.dataset.kjor);
        }

        function sorterTabell(kolonne) {
            valgtSortering = kolonne;
            var tbody = document.querySelector('.match-table tbody');
            if (!tbody) return;

            var par = Array.from(tbody.querySelectorAll('tr.match-row')).map(function (rad) {
                return { rad: rad, detaljer: rad.nextElementSibling };
            });
            par.sort(function (a, b) {
                return sorteringsverdi(a.rad, kolonne) - sorteringsverdi(b.rad, kolonne)
                    || Number(a.rad.dataset.luft) - Number(b.rad.dataset.luft);
            });
            par.forEach(function (p) {
                tbody.appendChild(p.rad);
                if (p.detaljer) tbody.appendChild(p.detaljer);
            });

            document.querySelectorAll('.match-sort-btn').forEach(function (knapp) {
                var valgt = knapp.dataset.sort === kolonne;
                knapp.closest('th').setAttribute('aria-sort', valgt ? 'ascending' : 'none');
                knapp.querySelector('i').className = 'fa-solid ' + (valgt ? 'fa-sort-up' : 'fa-sort');
            });
        }

        function sorterEtterValgtKolonne() {
            sorterTabell(valgtSortering);
        }

        document.querySelectorAll('.match-sort-btn').forEach(function (knapp) {
            knapp.addEventListener('click', function () {
                sorterTabell(knapp.dataset.sort);
            });
        });

        hentKjoreavstander();

        /// Valhalla sender ruten som en kodet streng (Google polyline med 6 desimaler).
        /// Denne gjør den om til en liste med [lat, lng]-punkter som Leaflet kan tegne.
        function dekodPolyline(kodet, presisjon) {
            var faktor = Math.pow(10, presisjon);
            var punkter = [];
            var indeks = 0, lat = 0, lng = 0;

            while (indeks < kodet.length) {
                var resultat = 0, skift = 0, b;
                do {
                    b = kodet.charCodeAt(indeks++) - 63;
                    resultat |= (b & 0x1f) << skift;
                    skift += 5;
                } while (b >= 0x20);
                lat += (resultat & 1) ? ~(resultat >> 1) : (resultat >> 1);

                resultat = 0; skift = 0;
                do {
                    b = kodet.charCodeAt(indeks++) - 63;
                    resultat |= (b & 0x1f) << skift;
                    skift += 5;
                } while (b >= 0x20);
                lng += (resultat & 1) ? ~(resultat >> 1) : (resultat >> 1);

                punkter.push([lat / faktor, lng / faktor]);
            }
            return punkter;
        }
    </script>
}