@using Prosjekt.Models.ModelView
@using Prosjekt.Models
@model NeedCreatorViewModel

@{
    ViewData["Title"] = "Opprett et nytt behov";
}
<div class="position-relative w-100 overflow-hidden" style="height: calc(100vh - 80px); min-height: 500px;">
    <div id="map" class="w-100 h-100"></div>

    <div id="sideMeny" class="position-absolute top-0 start-0 h-100 bg-white shadow-lg p-4 rounded-end d-none"
         style="z-index: 1000; width: 420px; max-width: 100%; overflow-y: auto;">

        <button type="button" class="btn-close float-end mb-2" id="lukkMenyBtn" aria-label="Lukk"></button>
        <div class="clearfix"></div>

        <h2 class="mb-1">Registrer Behov</h2>
        <p class="text-muted small">Fyll inn informasjon om behovet for den valgte posisjonen.</p>
        <hr />

        <form asp-controller="Need" asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="border p-3 mb-4 rounded bg-light">
                <div class="form-group mb-3">
                    <label class="fw-bold">Navn</label>
                    <input id="inputName" class="form-control" placeholder="F.eks. Rullestoler, Førstehjelpsskrin" />
                </div>
                
                <div class="form-group mb-3">
                    <label class="fw-bold">Beskrivelse</label>
                    <textarea id="inputDescription" class="form-control" rows="3" placeholder="Utdypende informasjon..."></textarea>
                </div>
                
                <div class="form-group mb-3">
                    <label class="fw-bold">Antall</label>
                    <input id="inputTotal" type="number" class="form-control" min="1" value="1"/>
                </div>
                
                <div class="form-group mb-4">
                    <label asp-for="Importance" class="fw-bold">Viktighet</label>
                    <select id="viktighetSelect" asp-for="Importance" asp-items="Html.GetEnumSelectList<Importance>()" class="form-select"></select>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label asp-for="Latitude" class="form-label small mb-1 fw-bold">Breddegrad</label>
                        <input asp-for="Latitude" id="Latitude" class="form-control form-control-sm" readonly required />
                    </div>
                    <div class="col-6">
                        <label asp-for="Longitude" class="form-label small mb-1 fw-bold">Lengdegrad</label>
                        <input asp-for="Longitude" id="Longitude" class="form-control form-control-sm" readonly required />
                    </div>
                </div>

                <button type="button" class="btn btn-outline-primary w-100" onclick="leggTilIListe()">
                    Legg til i listen
                </button>

                <h6 class="fw-bold">Behov i denne registreringen</h6>
                <table class="table table-sm table-bordered">
                    <tbody id="behovTabell"></tbody>
                </table>
                <div id="skjulteInputFelter"></div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Lagre behov</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var currentMarker = null;
        var sideMeny = document.getElementById('sideMeny');
        var selectedLat, selectedLng;

        var map = L.map('map').setView([58.1467, 7.9956], 12);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        function getIkon(fargeNavn) {
            return new L.Icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41], iconAnchor: [12, 41], popupAnchor: [1, -34], shadowSize: [41, 41]
            });
        }

        var ikoner = { 0: getIkon('green'), 1: getIkon('gold'), 2: getIkon('red') };

        function getAktueltIkon() {
            var selectVal = document.getElementById('viktighetSelect').value;
            return ikoner[selectVal] || ikoner[0];
        }

        function updateMarkor() {
            if (!selectedLat || !selectedLng) return;
            if (currentMarker) map.removeLayer(currentMarker);
            currentMarker = L.marker([selectedLat, selectedLng], { icon: getAktueltIkon() }).addTo(map);
        }

        document.getElementById('viktighetSelect').addEventListener('change', function() {
            if (currentMarker) currentMarker.setIcon(getAktueltIkon());
        });

        map.on('click', function(e) {
            selectedLat = e.latlng.lat.toFixed(6);
            selectedLng = e.latlng.lng.toFixed(6);
            document.getElementById('Latitude').value = selectedLat;
            document.getElementById('Longitude').value = selectedLng;
            updateMarkor();
            if (sideMeny.classList.contains('d-none')) sideMeny.classList.remove('d-none');
            var menyBredde = sideMeny.offsetWidth || 420;
            map.flyTo([selectedLat, selectedLng], map.getZoom(), { animate: true, duration: 0.8 });
            setTimeout(function() { map.panBy([-menyBredde / 2, 0], { animate: true, duration: 0.4 }); }, 300);
        });

        document.getElementById('lukkMenyBtn').addEventListener('click', function() {
            sideMeny.classList.add('d-none');
            if (currentMarker) {
                map.removeLayer(currentMarker);
                currentMarker = null; selectedLat = null; selectedLng = null;
                document.getElementById('Latitude').value = '';
                document.getElementById('Longitude').value = '';
            }
        });

        setTimeout(function () { map.invalidateSize(); }, 200);

        var behovListe = [];

        function leggTilIListe() {
            var navn = document.getElementById('inputName').value.trim();
            if (!navn) { alert('Behovet må ha et navn.'); return; }

            behovListe.push({
                name: navn,
                description: document.getElementById('inputDescription').value,
                total: document.getElementById('inputTotal').value,
                latitude: document.getElementById('Latitude').value,
                longitude: document.getElementById('Longitude').value,
                importance: document.getElementById('viktighetSelect').value
            });

            document.getElementById('inputName').value = '';
            document.getElementById('inputDescription').value = '';
            document.getElementById('inputTotal').value = 1;

            oppdaterTabell();
        }
        
        function oppdaterTabell() {
            var rader = '', felter = '';

            behovListe.forEach(function(item, i) {
                rader += `<tr>
                    <td>${item.name}</td>
                    <td>${item.total}</td>
                    <td><button type="button" class="btn btn-sm btn-danger" onclick="fjernFraListe(${i})">x</button></td>
                </tr>`;

                felter += `
                <input type="hidden" name="NeedList[${i}].Name" value="${item.name}" />
                <input type="hidden" name="NeedList[${i}].Description" value="${item.description}" />
                <input type="hidden" name="NeedList[${i}].Total" value="${item.total}" />
                <input type="hidden" name="NeedList[${i}].Latitude" value="${item.latitude}" />
                <input type="hidden" name="NeedList[${i}].Longitude" value="${item.longitude}" />
                <input type="hidden" name="NeedList[${i}].Importance" value="${item.importance}" />`;
                
            });
            document.getElementById('behovTabell').innerHTML = rader;
            document.getElementById('skjulteInputFelter').innerHTML = felter;
        }

        function fjernFraListe(i) 
        {
            behovListe.splice(i, 1);
            oppdaterTabell();
        }
    </script>
}