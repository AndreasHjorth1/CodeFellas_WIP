@using Prosjekt.Models.ModelView
@model NeedCreatorViewModel

@{
    ViewData["Title"] = "Meld behov";
}

<div class="position-relative w-100 overflow-hidden" style="height: calc(100vh - 80px); min-height: 500px;">
    <!-- Kart -->
    <div id="map" class="w-100 h-100"></div>

    <!-- Sidemeny på HØYRE side -->
    <aside id="sideMeny" class="position-absolute top-0 end-0 h-100 tf-panel d-none" aria-labelledby="panelTittel"
           style="z-index: 1000; width: 480px; max-width: 100%; overflow-y: auto;">

        <div class="tf-panel-head">
            <div>
                <p class="tf-kicker">Ny registrering</p>
                <h2 id="panelTittel" class="tf-title fs-2">Meld <em>behov.</em></h2>
                <p class="tf-lede">Klikk på kartet eller tegn et område. Alle behov i listen får samme plassering, viktighet og frist.</p>
            </div>
            <button type="button" class="tf-close" id="lukkMenyBtn" aria-label="Lukk panelet">Lukk <span aria-hidden="true">✕</span></button>
        </div>

        <form asp-controller="Need" asp-action="Create" method="post" autocomplete="off" id="hovedSkjema" class="tf-form" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="tf-error mb-3"></div>

            <!-- Steg 1: felles for alle behovene -->
            <section class="tf-block" aria-labelledby="steg1">
                <p class="tf-step" id="steg1"><span>01</span> Hvor mye haster det?</p>

                <div class="row g-2">
                    <div class="col-6">
                        <label for="viktighetSelect">Viktighet</label>
                        <select id="viktighetSelect" asp-for="Importance" asp-items="Html.GetEnumSelectList<ImportanceLevel>()" class="form-select"></select>
                    </div>
                    <div class="col-6">
                        <label asp-for="Deadline">Frist<span class="tf-req" aria-hidden="true">*</span></label>
                        <input asp-for="Deadline" type="datetime-local" class="form-control" required />
                    </div>
                </div>
                <span asp-validation-for="Deadline" class="tf-error d-block mt-1"></span>
                <span class="tf-hint">Akutt betyr at liv, helse eller viktig infrastruktur er truet nå.</span>
            </section>

            <!-- Steg 2: beskriv hvert behov -->
            <section class="tf-block" aria-labelledby="steg2">
                <p class="tf-step" id="steg2"><span>02</span> Hva trengs?</p>

                <div class="tf-subcard">
                    <div class="mb-3">
                        <label for="inputType">Behovstype</label>
                        <select id="inputType" class="form-select">
                            <option value="Food">Mat/Vann</option>
                            <option value="Medicine">Medisiner</option>
                            <option value="Transport">Transport</option>
                            <option value="PowerGenerator">Strøm/aggregat</option>
                            <option value="SnowRemoval">Snørydding</option>
                            <option value="SandGravel">Sand/grus</option>
                            <option value="Machinery">Maskiner</option>
                            <option value="Evacuation">Evakuering</option>
                            <option value="Communication">Samband</option>
                            <option value="Personnel">Mannskap</option>
                            <option value="Other">Annet</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="inputName">Kort navn<span class="tf-req" aria-hidden="true">*</span></label>
                        <input id="inputName" class="form-control" placeholder="F.eks. Aggregat til sykehjem" />
                    </div>

                    <div class="mb-3">
                        <label for="inputDescription">Beskrivelse<span class="tf-req" aria-hidden="true">*</span></label>
                        <textarea id="inputDescription" class="form-control" rows="2" placeholder="Hvor mye, hvor lenge, og hvem det gjelder."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="inputPhone">Telefon til kontaktperson<span class="tf-req" aria-hidden="true">*</span></label>
                        <input id="inputPhone" type="tel" inputmode="tel" autocomplete="tel" class="form-control" placeholder="912 34 567" />
                    </div>

                    <p id="skjemaFeil" class="tf-error mb-3" role="alert" aria-live="assertive"></p>

                    <button type="button" class="tf-btn tf-btn--ghost w-100" onclick="leggTilIListe()">+ Legg i listen</button>
                </div>
            </section>

            <!-- Steg 3: kontroller listen -->
            <section class="tf-block" aria-labelledby="steg3">
                <p class="tf-step" id="steg3"><span>03</span> Kontroller listen</p>
                <table class="tf-table tf-table--compact" id="behovTabell">
                    <thead>
                        <tr>
                            <th scope="col">Navn</th>
                            <th scope="col">Type</th>
                            <th scope="col">Telefon</th>
                            <th scope="col"><span class="visually-hidden">Handling</span></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
                <p id="tomListe" class="tf-meta mt-2">Ingen behov i listen ennå. Fyll inn steg 2 og trykk «Legg i listen».</p>

                <!-- Skjulte felter for binding mot NeedList -->
                <div id="skjulteInputFelter"></div>
            </section>

            <!-- Steg 4: plassering og innsending -->
            <section class="tf-block" aria-labelledby="steg4">
                <p class="tf-step" id="steg4"><span>04</span> Plassering</p>
                <div class="row g-2 mb-1">
                    <div class="col-6">
                        <label asp-for="Latitude">Breddegrad</label>
                        <input asp-for="Latitude" id="Latitude" class="form-control" readonly required />
                    </div>
                    <div class="col-6">
                        <label asp-for="Longitude">Lengdegrad</label>
                        <input asp-for="Longitude" id="Longitude" class="form-control" readonly required />
                    </div>
                </div>
                <div id="omradeInfo" class="tf-meta mt-1 d-none">
                    Område: ca. <span id="omradeAreal"></span> &middot; omkrets ca. <span id="omradeOmkrets"></span>
                </div>
                <span class="tf-hint mb-4">Klikk et annet sted på kartet, eller tegn et nytt område, for å flytte.</span>

                <input asp-for="AreaGeoJson" id="AreaGeoJson" type="hidden" />
                <input asp-for="AreaSquareMeters" id="AreaSquareMeters" type="hidden" />
                <input asp-for="PerimeterMeters" id="PerimeterMeters" type="hidden" />

                <button type="submit" id="opprettKnapp" class="tf-btn w-100" onclick="return validerInnsending()">Opprett behov <span aria-hidden="true">&rarr;</span></button>
            </section>
        </form>
    </aside>
</div>

@section Scripts {
    <script>
        let behovListe = [];
        var sideMeny = document.getElementById('sideMeny');

        // Funksjon for fargede markører
        function getIkon(fargeNavn) {
            return new L.Icon({
                iconUrl: `https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-${fargeNavn}.png`,
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
        }

        function HentValgtIkon() {
            var importanceVal = document.getElementById('viktighetSelect').value;
            return (importanceVal === '0' || importanceVal === 'Acute') ? getIkon('red') : getIkon('gold');
        }

        function HentValgtFarge() {
            var importanceVal = document.getElementById('viktighetSelect').value;
            return (importanceVal === '0' || importanceVal === 'Acute') ? '#dc3545' : '#fd7e14';
        }

        // 1. Definer kartlagene med noWrap
        var osmKart = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors',
            noWrap: true
        });

        var geonorgeTopo = L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
            attribution: '&copy; <a href="https://www.kartverket.no/">Kartverket</a>',
            noWrap: true
        });

        var geonorgeFlybilder = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
            attribution: '&copy; Midlertidig satellitt (Esri) - Venter på Geonorge-tilgang',
            noWrap: true
        });

        // 2. Start kartet med grenser og fast verden
        var map = L.map('map', {
            center: [58.1467, 7.9956],
            zoom: 12,
            minZoom: 3,
            maxBounds: [
                [-90, -180],
                [90, 180]
            ],
            maxBoundsViscosity: 1.0,
            layers: [osmKart]
        });

        // 3. Lag menyen oppe i hjørnet for å bytte kart
        var bakgrunnsKart = {
            "Standard (OSM)": osmKart,
            "Topografisk (Geonorge)": geonorgeTopo,
            "Flybilder (Geonorge)": geonorgeFlybilder
        };
        L.control.layers(bakgrunnsKart).addTo(map);

        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        // Creates the drawing control on the map
        var drawControl = new L.Control.Draw({
            draw: {
                polygon: {
                    allowIntersection: false,
                    showArea: true,
                    metric: true,
                    shapeOptions: {color: '#dc3545'}
                },
                polyline: false, circle: false, rectangle: false,
                marker: true
            },
            edit: { featureGroup: drawnItems, remove: true }
        });
        map.addControl(drawControl);

        var tegnerNaa = false;
        map.on('draw:drawstart', function() { tegnerNaa = true; });
        map.on('draw:drawstop', function() { tegnerNaa = false; });

        // Oppdaterer eksisterende markør dersom brukeren endrer dropdown-valget for Viktighet
        document.getElementById('viktighetSelect').addEventListener('change', function() {
            var valgtIkon = HentValgtIkon();
            var valgtFarge = HentValgtFarge();
            drawnItems.eachLayer(function(layer) {
                if (layer instanceof L.Marker) {
                    layer.setIcon(valgtIkon);
                } else if (layer instanceof L.Polygon) {
                    layer.setStyle({ color: valgtFarge });
                }
            });
        });

        // Event handler for tegning på kartet
        map.on('draw:created', function(e) {
            var layer = e.layer;
            drawnItems.clearLayers();

            var latlng;
            
            if (layer instanceof L.Polygon) {
                latlng = layer.getBounds().getCenter();
                layer.setStyle({ color: HentValgtFarge(), fillOpacity: 0.15 });
                lagreOmrade(layer);
            } else {
                if (layer instanceof L.Marker) {
                    layer.setIcon(HentValgtIkon());
                }
                latlng = layer.getLatLng();
                tomOmrade();
            }
            drawnItems.addLayer(layer);
            settPosisjonOgVisMeny(latlng.lat.toFixed(6), latlng.lng.toFixed(6));

        });

        // Vanlig klikk på kartet
        map.on('click', function(e) {
            if (tegnerNaa) return;
            var lat = e.latlng.lat.toFixed(6);
            var lng = e.latlng.lng.toFixed(6);
            
            var harOmrade = document.getElementById('AreaGeoJson').value !== '';
            if (harOmrade && !confirm('Du har tegnet et område. Vil du erstatte det med en markør?')) {
                return;
            }

            drawnItems.clearLayers();

            tomOmrade();
            var newMarker = L.marker([lat, lng], { icon: HentValgtIkon() });
            drawnItems.addLayer(newMarker);

            settPosisjonOgVisMeny(lat, lng);
        });

        function settPosisjonOgVisMeny(lat, lng) {
            document.getElementById('Latitude').value = lat;
            document.getElementById('Longitude').value = lng;
            sideMeny.classList.remove('d-none');

            var menyBredde = sideMeny.offsetWidth || 480;
            map.flyTo([lat, lng], map.getZoom(), { animate: true, duration: 0.8 });
            setTimeout(function() {
                map.panBy([menyBredde / 2, 0], { animate: true, duration: 0.4 });
            }, 300);
        }

        // Lukk meny
        document.getElementById('lukkMenyBtn').addEventListener('click', function() {
            sideMeny.classList.add('d-none');
            drawnItems.clearLayers();
            tomOmrade();
            document.getElementById('Latitude').value = '';
            document.getElementById('Longitude').value = '';
        });

        function leggTilIListe() {
            let name = document.getElementById('inputName').value.trim();
            let phone = document.getElementById('inputPhone').value.trim();
            let description = document.getElementById('inputDescription').value.trim();

            let typeSelect = document.getElementById('inputType');
            let type = typeSelect.value;
            let typeText = typeSelect.options[typeSelect.selectedIndex].text;

            if (!name) { alert("Vennligst fyll ut 'Navn'."); document.getElementById('inputName').focus(); return; }
            if (!phone) { alert("Vennligst fyll ut 'Telefonnummer'."); document.getElementById('inputPhone').focus(); return; }
            if (!description) { alert("Vennligst fyll ut 'Beskrivelse'."); document.getElementById('inputDescription').focus(); return; }

            behovListe.push({ name, phone, type, typeText, description });

            document.getElementById('inputName').value = '';
            document.getElementById('inputPhone').value = '';
            document.getElementById('inputDescription').value = '';

            oppdaterTabell();
        }

        function oppdaterTabell() {
            let tbody = document.querySelector('#behovTabell tbody');
            let skjulteInputs = document.getElementById('skjulteInputFelter');
            tbody.innerHTML = '';
            skjulteInputs.innerHTML = '';

            behovListe.forEach((item, index) => {
                tbody.innerHTML += `<tr><td>${item.name}</td><td>${item.typeText}</td><td>${item.phone}</td><td><button type="button" class="btn btn-danger btn-sm" onclick="fjernFraListe(${index})">X</button></td></tr>`;

                skjulteInputs.innerHTML += `
                    <input type="hidden" name="NeedList[${index}].Name" value="${item.name}" />
                    <input type="hidden" name="NeedList[${index}].Phone" value="${item.phone}" />
                    <input type="hidden" name="NeedList[${index}].Type" value="${item.type}" />
                    <input type="hidden" name="NeedList[${index}].Description" value="${item.description}" />
                `;
            });
        }

        function validerInnsending() {
            if (behovListe.length === 0) {
                alert("Du må legge til minst ett behov i listen før du kan opprette!");
                return false;
            }
            return true;
        }

        function fjernFraListe(index) {
            behovListe.splice(index, 1);
            oppdaterTabell();
        }

        setTimeout(function () { map.invalidateSize(); }, 200);
    </script>
}