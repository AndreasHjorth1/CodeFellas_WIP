<link rel="stylesheet" href="~/css/map-symbols.css" asp-append-version="true" />
﻿@using Prosjekt.Models.ModelView
@using System.Globalization
@model NeedViewModel
@using Prosjekt.Models.Enums;

@{
    ViewData["Title"] = "Rediger Behov";
}

<div class="row min-vh-100 g-0 mt-2">
    <div class="col-lg-5 col-md-6 p-3 d-flex flex-column">
        <h2 class="mb-4">Rediger Behov</h2>
        <form asp-controller="Need" asp-action="Edit" asp-route-id="@Model.Id" method="post" autocomplete="off" class="flex-grow-1">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="border p-4 mb-3 rounded bg-light shadow-sm">
                <!-- Navn -->
                <div class="form-group mb-3">
                    <label asp-for="Name" class="fw-bold">Navn *</label>
                    <input asp-for="Name" class="form-control" required />
                </div>

                <!-- Beskrivelse -->
                <div class="form-group mb-3">
                    <label asp-for="Description" class="fw-bold">Beskrivelse *</label>
                    <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                </div>

                <!-- Telefonnummer -->
                <div class="form-group mb-3">
                    <label asp-for="Phone" class="fw-bold">Telefonnummer *</label>
                    <input asp-for="Phone" class="form-control" required />
                </div>

                <!-- Behovstype -->
                <div class="form-group mb-3">
                    <label asp-for="Type" class="fw-bold">Behovstype *</label>
                    <select asp-for="Type" class="form-select">
                        <option value="Food">Mat/Vann</option>
                        <option value="Medicine">Medisiner</option>
                        <option value="Transport">Transport</option>
                        <option value="PowerGenerator">Strøm/aggregat</option>
                        <option value="SnowRemoval">Snørydding</option>
                        <option value="SandGravel">Sand/grus</option>
                        <option value="Machinery">Maskiner</option>
                        <option value="Evacuation">Evakuering</option>
                        <option value="Communication">Samband</option>
                        <option value="Personnel">Mannskap</option>
                        <option value="Other">Annet</option>
                    </select>
                    <div id="behovSymbolPreview" class="map-symbol-preview" aria-live="polite"></div>
                </div>

                <!-- Viktighet -->
                <div class="form-group mb-3">
                    <label asp-for="Importance" class="fw-bold">Viktighet *</label>
                    <select asp-for="Importance" asp-items="Html.GetEnumSelectList<ImportanceLevel>()" class="form-select"></select>
                </div>

                <!-- Tidsfrist -->
                <div class="form-group mb-3">
                    <label asp-for="Deadline" class="fw-bold">Tidsfrist *</label>
                    <input asp-for="Deadline" type="datetime-local" class="form-control" required />
                </div>

                <!-- Status / Oppfylt -->
                <div class="form-group mb-3">
                    <label asp-for="Status" class="fw-bold">Status</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<EntryStatus>()" class="form-select"></select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

            </div>

            <!-- Koordinater -->
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label asp-for="Latitude" class="form-label small fw-bold">Breddegrad *</label>
                    <input asp-for="Latitude" id="Latitude" class="form-control form-control-sm" readonly required />
                </div>
                <div class="col-6">
                    <label asp-for="Longitude" class="form-label small fw-bold">Lengdegrad *</label>
                    <input asp-for="Longitude" id="Longitude" class="form-control form-control-sm" readonly required />
                </div>
            </div>

            <div id="omradeInfo" class="small text-muted mb-3 d-none">
                Område: ca. <span id="omradeAreal"></span> &middot; omkrets ca. <span id="omradeOmkrets"></span>
            </div>

            <input asp-for="AreaGeoJson" id="AreaGeoJson" type="hidden" />
            <input asp-for="AreaSquareMeters" id="AreaSquareMeters" type="hidden" />
            <input asp-for="PerimeterMeters" id="PerimeterMeters" type="hidden" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary w-50">Lagre</button>
                <a asp-action="Overview" class="btn btn-secondary w-50">Avbryt</a>
            </div>
        </form>
    </div>

    <!-- Kart-seksjon -->
    <div class="col-lg-7 col-md-6 d-flex flex-column p-3">
        <div id="map" class="flex-grow-1 w-100 rounded shadow-sm" style="min-height: 400px; height: 60vh;"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/map-symbols.js" data-resources-url="@Url.Content("~/images/resources/")" data-needs-url="@Url.Content("~/images/needs/")" asp-append-version="true"></script>
    <script src="~/js/need-area-symbol.js" asp-append-version="true"></script>
    <script>
        var lat = @(Model.Latitude.HasValue ? Model.Latitude.Value.ToString(CultureInfo.InvariantCulture) : "null");
        var lng = @(Model.Longitude.HasValue ? Model.Longitude.Value.ToString(CultureInfo.InvariantCulture) : "null");

        var harPosisjon = (lat !== null && lng !== null && !isNaN(lat) && !isNaN(lng));
        var startPunkt = harPosisjon ? [lat, lng] : [58.163, 8.003];

        const behovstype = document.getElementById('Type');
        const viktighet = document.getElementById('Importance');
        function HentValgtIkon() { return MapSymbols.needIcon(behovstype.value, viktighet.value); }
        function hentFarge() { return MapSymbols.isAcute(viktighet.value) ? '#dc3545' : '#fd7e14'; }

        // 1. Initialiser kartet
        var map = L.map('map').setView(startPunkt, harPosisjon ? 14 : 13);

        // 2. Legg til tile layer
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        // 3. Initialiser Leaflet.Draw feature group
        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);
        const areaSymbol = createNeedAreaSymbol(map);

        var omradeJson = @Json.Serialize(Model.AreaGeoJson);

        if (omradeJson) {
            var eksisterende = L.geoJSON(JSON.parse(omradeJson), {
                style: { color: hentFarge(), weight: 2, fillOpacity: 0.15 }
            });
            eksisterende.eachLayer(function (l) { drawnItems.addLayer(l); });
            map.fitBounds(eksisterende.getBounds(), { padding: [20, 20] });
        } else if (harPosisjon) {
            var existingMarker = L.marker(startPunkt, { icon: HentValgtIkon() });
            drawnItems.addLayer(existingMarker);
        }

        // 4. Opprett draw control
        var drawControl = new L.Control.Draw({
            draw: {
                polygon: {
                    allowIntersection: false,
                    showArea: true,
                    metric: true,
                    shapeOptions: { color: hentFarge() }
                },
                polyline: false, circle: false, rectangle: false,
                marker: { icon: HentValgtIkon() }
            },
            edit: { featureGroup: drawnItems, remove: true }
        });
        map.addControl(drawControl);

        function oppdaterBehovSymbol() {
            document.getElementById('behovSymbolPreview').innerHTML =
                MapSymbols.image(MapSymbols.needUrl(behovstype.value), MapSymbols.needClass(viktighet.value)) +
                '<span>' + MapSymbols.escape(behovstype.options[behovstype.selectedIndex].text) + '</span>';
            drawnItems.eachLayer(layer => {
                if (layer instanceof L.Marker) layer.setIcon(HentValgtIkon());
                if (layer instanceof L.Polygon) layer.setStyle({color:hentFarge()});
            });
            drawControl.setDrawingOptions({marker:{icon:HentValgtIkon()},polygon:{shapeOptions:{color:hentFarge()}}});
            synkroniserBehovsomrade(false);
        }
        behovstype.addEventListener('change', oppdaterBehovSymbol);
        viktighet.addEventListener('change', oppdaterBehovSymbol);

        map.on('draw:created', function (e) {
            drawnItems.clearLayers();
            if (e.layer instanceof L.Polygon) e.layer.setStyle({color:hentFarge(),fillOpacity:.15});
            if (e.layer instanceof L.Marker) e.layer.setIcon(HentValgtIkon());
            drawnItems.addLayer(e.layer);
            synkroniserBehovsomrade(true);
        });

        function synkroniserBehovsomrade(lagre) {
            const layer = drawnItems.getLayers()[0];
            const polygon = layer instanceof L.Polygon ? layer : null;
            const center = areaSymbol.update(polygon, HentValgtIkon());
            if (!lagre) return;
            const position = center || (layer instanceof L.Marker ? layer.getLatLng() : null);
            if (polygon) lagreOmrade(polygon); else tomOmrade();
            document.getElementById('Latitude').value = position ? position.lat.toFixed(6) : '';
            document.getElementById('Longitude').value = position ? position.lng.toFixed(6) : '';
        }

        map.on('draw:edited draw:deleted', () => synkroniserBehovsomrade(true));
        map.on('draw:editvertex draw:editstop deletestop draw:deletestop', () => synkroniserBehovsomrade(false));

        oppdaterBehovSymbol();

        setTimeout(function () { map.invalidateSize(); }, 200);
    </script>
    <partial name="_ValidationScriptsPartial" />
}