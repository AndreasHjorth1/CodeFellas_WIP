@{
    ViewData["Title"] = "Sjekk e-posten din";
}

<style>
    .forgot-page {
        min-height: 80vh;
        background-color: #eff3f6;
        padding: 2.5rem 1rem;
    }

    .forgot-layout {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 2.5rem;
        align-items: flex-start;
    }

    .forgot-card {
        flex: 1 1 300px;
        max-width: 370px;
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 1.5rem 1.5rem 1.5rem;
    }

    .forgot-card .back-link {
        font-size: 0.85rem;
    }

    .forgot-card h1 {
        color: #0f2a4f;
        font-size: 1.9rem;
        font-weight: 700;
        margin: 1.25rem 0 1.25rem;
    }

    .forgot-card .intro {
        color: #5f6f86;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1.25rem;
    }

    .forgot-page a {
        color: #2d4f86;
        text-decoration: underline;
    }

    .forgot-page a:hover {
        color: #0f2a4f;
    }

    .forgot-card a.btn-send {
        display: block;
        width: 100%;
        background-color: #04245a;
        border: none;
        border-radius: 0;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.7rem;
        text-align: center;
        text-decoration: none;
    }

    .forgot-card a.btn-send:hover,
    .forgot-card a.btn-send:focus {
        background-color: #0f3a80;
        color: #ffffff;
    }

    .forgot-side {
        flex: 1 1 300px;
        max-width: 370px;
        padding-top: 0.35rem;
    }

    .forgot-info {
        display: flex;
        gap: 0.75rem;
        background-color: #e3f1ea;
        border-radius: 4px;
        padding: 1rem;
    }

    .forgot-info .check-icon {
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #ffffff;
        color: #0f2a4f;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-info h2 {
        color: #0f2a4f;
        font-size: 1rem;
        font-weight: 700;
        margin: 0.15rem 0 0.35rem;
    }

    .forgot-info p {
        color: #5f6f86;
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0;
    }

    .forgot-side .help-text {
        color: #5f6f86;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-top: 1rem;
    }
</style>

<div class="forgot-page">
    <div class="forgot-layout">
        <div class="forgot-card">
            <a asp-action="ForgotPassword" class="back-link">&lsaquo; Tilbake</a>

            <h1>Sjekk e-posten din</h1>

            <p class="intro">Hvis e-posten er registrert hos oss, har vi sendt deg en lenke for å lage nytt passord.</p>

            <a asp-action="Login" class="btn btn-send">Tilbake til innlogging</a>
        </div>

        <div class="forgot-side">
            <div class="forgot-info">
                <div class="check-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="2.5 8.5 6.5 12.5 13.5 4" />
                    </svg>
                </div>
                <div>
                    <h2>Ressursene dine er trygge</h2>
                    <p>De er fortsatt registrert og synlige for kommunen mens du lager nytt passord.</p>
                </div>
            </div>

            <p class="help-text">Får du ingen e-post? Sjekk søppelpost, eller ta kontakt med kommunens beredskapsansvarlige.</p>
        </div>
    </div>
</div>
