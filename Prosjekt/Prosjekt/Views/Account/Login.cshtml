```cshtml
@model Prosjekt.Models.ModelView.Account.LoginViewModel

@{
    ViewData["Title"] = "Logg inn";
}

<h1>Logg inn</h1>

<form asp-action="Login" method="post" class="col-md-6">
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-postadresse</label>
        <input asp-for="Email" class="form-control" autocomplete="email" placeholder="Skriv inn e-postadresse" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Passord</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" placeholder="Skriv inn passord" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="RememberMe" class="form-check-input" />
        <label asp-for="RememberMe" class="form-check-label">Husk meg</label>
    </div>

    <button type="submit" class="btn btn-primary">Logg inn</button>
</form>

<p class="mt-3">
    <a asp-action="ForgotPassword">Glemt passordet ditt?</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```