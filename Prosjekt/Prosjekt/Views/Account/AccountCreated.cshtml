@{
    ViewData["Title"] = "Bruker opprettet";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 text-center p-5">

                <!-- Suksess-ikon (Grønn sirkel med hake) -->
                <div class="mb-4">
                    <div class="rounded-circle bg-success d-inline-flex align-items-center justify-content-center shadow-sm" style="width: 80px; height: 80px;">
                        <span class="text-white fw-bold" style="font-size: 2.5rem;">✓</span>
                    </div>
                </div>

                <h2 class="fw-bold mb-3">Bruker opprettet!</h2>

                <p class="text-muted mb-4">
                    Kontoen din er nå opprettet, og du er innlogget i TotalForsvaret-systemet. Du kan nå starte med å registrere ressurser, behov og geografiske hendelser.
                </p>

                <!-- Handlingsknapper (Fjernet "Gå til innlogging") -->
                <div class="d-grid gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg fw-bold shadow-sm">
                        Gå til hovedsiden
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>