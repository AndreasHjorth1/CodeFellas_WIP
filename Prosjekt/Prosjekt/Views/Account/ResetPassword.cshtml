@model Prosjekt.Models.ModelView.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Velg nytt passord";
}

<style>
    /* Samme oppsett som «Lag nytt passord» (ForgotPassword) */
    .reset-page {
        min-height: 80vh;
        background-color: #eff3f6;
        padding: 2.5rem 1rem;
    }

    .reset-layout {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        gap: 2.5rem;
        align-items: flex-start;
    }

    .reset-card {
        flex: 1 1 300px;
        max-width: 370px;
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 1.5rem;
    }

    .reset-card .back-link {
        font-size: 0.85rem;
    }

    .reset-card h1 {
        color: #0f2a4f;
        font-size: 1.9rem;
        font-weight: 700;
        margin: 1.25rem 0 1.25rem;
    }

    .reset-card .intro {
        color: #5f6f86;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1.25rem;
    }

    .reset-card .form-label {
        color: #0f2a4f;
        font-size: 0.9rem;
        font-weight: 700;
        margin-bottom: 0.4rem;
    }

    .reset-card .field-hint {
        color: #5f6f86;
        font-size: 0.85rem;
        line-height: 1.4;
        margin: -0.1rem 0 0.5rem;
    }

    .reset-card .form-control {
        border: 1px solid #8a9bb3;
        border-radius: 0;
        color: #0f2a4f;
        font-size: 0.95rem;
        padding: 0.55rem 0.5rem;
    }

    .reset-card .form-control:focus {
        border-color: #0f2a4f;
        box-shadow: 0 0 0 2px rgba(15, 42, 79, 0.2);
    }

    /* Vis/skjul passord, samme som på registreringssiden */
    .password-field {
        position: relative;
    }

    .password-field .form-control {
        padding-right: 2.75rem;
    }

    .password-field .form-control::-ms-reveal {
        display: none;
    }

    .password-toggle {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        width: 2.75rem;
        border: none;
        background: transparent;
        color: #5f6f86;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .password-toggle:hover {
        color: #0f2a4f;
    }

    .password-toggle .icon-hide,
    .password-toggle.is-visible .icon-show {
        display: none;
    }

    .password-toggle.is-visible .icon-hide {
        display: block;
    }

    .reset-page a {
        color: #2d4f86;
        text-decoration: underline;
    }

    .reset-page a:hover {
        color: #0f2a4f;
    }

    .reset-card .btn-save {
        width: 100%;
        background-color: #04245a;
        border: none;
        border-radius: 0;
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        padding: 0.7rem;
        margin-top: 0.25rem;
    }

    .reset-card .btn-save:hover,
    .reset-card .btn-save:focus {
        background-color: #0f3a80;
        color: #ffffff;
    }

    .reset-side {
        flex: 1 1 300px;
        max-width: 370px;
        padding-top: 0.35rem;
    }

    .reset-info {
        display: flex;
        gap: 0.75rem;
        background-color: #e3f1ea;
        border-radius: 4px;
        padding: 1rem;
    }

    .reset-info .check-icon {
        flex: 0 0 32px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #ffffff;
        color: #0f2a4f;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .reset-info h2 {
        color: #0f2a4f;
        font-size: 1rem;
        font-weight: 700;
        margin: 0.15rem 0 0.35rem;
    }

    .reset-info p {
        color: #5f6f86;
        font-size: 0.9rem;
        line-height: 1.5;
        margin: 0;
    }

    .reset-side .help-text {
        color: #5f6f86;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-top: 1rem;
    }
</style>

<div class="reset-page">
    <div class="reset-layout">
        <div class="reset-card">
            <a asp-action="Login" class="back-link">&lsaquo; Tilbake til innlogging</a>

            <h1>Velg nytt passord</h1>

            <p class="intro">Skriv inn det nye passordet to ganger. Du bruker det neste gang du logger inn.</p>

            <form asp-action="ResetPassword" method="post">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Code" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Nytt passord</label>
                    <p class="field-hint" id="PasswordHint">Minst 6 tegn, med stor og liten bokstav, et tall og et spesialtegn.</p>
                    <div class="password-field">
                        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" aria-describedby="PasswordHint" />
                        <button type="button" class="password-toggle" data-target="Password" aria-label="Vis passord">
                            <svg class="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /> <circle cx="12" cy="12" r="3" /> </svg> <svg class="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /> <line x1="1" y1="1" x2="23" y2="23" /> </svg>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Gjenta nytt passord</label>
                    <div class="password-field">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                        <button type="button" class="password-toggle" data-target="ConfirmPassword" aria-label="Vis passord">
                            <svg class="icon-show" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7S1 12 1 12z" /> <circle cx="12" cy="12" r="3" /> </svg> <svg class="icon-hide" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" /> <line x1="1" y1="1" x2="23" y2="23" /> </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-save">Lagre nytt passord</button>
            </form>
        </div>

        <div class="reset-side">
            <div class="reset-info">
                <div class="check-icon" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="2.5 8.5 6.5 12.5 13.5 4" />
                    </svg>
                </div>
                <div>
                    <h2>Ressursene dine er trygge</h2>
                    <p>De er fortsatt registrert og synlige for kommunen mens du bytter passord.</p>
                </div>
            </div>

            <p class="help-text">Virker ikke lenken? <a asp-action="ForgotPassword">Be om en ny lenke</a>, eller ta kontakt med kommunens beredskapsansvarlige.</p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Context.CspNonce()">
        document.querySelectorAll('.password-toggle').forEach(function (button) {
            button.addEventListener('click', function () {
                var input = document.getElementById(button.dataset.target);
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                button.classList.toggle('is-visible', show);
                button.setAttribute('aria-label', show ? 'Skjul passord' : 'Vis passord');
            });
        });
    </script>
}
