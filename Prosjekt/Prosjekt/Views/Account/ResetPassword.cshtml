```cshtml
@model Prosjekt.Models.ModelView.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Tilbakestill passord";
}

<h1>Tilbakestill passord</h1>

<form asp-action="ResetPassword" method="post" class="col-md-6">

    <input asp-for="Email" type="hidden" />
    <input asp-for="Code" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label">Nytt passord</label>
        <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" placeholder="Skriv inn nytt passord" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label">Bekreft nytt passord</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" placeholder="Gjenta nytt passord" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Tilbakestill passord</button>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```