@{
    ViewData["Title"] = "Passordet er endret";
}

<style>
    .reset-done-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #eff3f6;
        padding: 2rem 1rem;
    }

    .reset-done-card {
        width: 100%;
        max-width: 400px;
        background-color: #ffffff;
        border: 1px solid #dde3ea;
        border-radius: 6px;
        padding: 2rem 1.75rem 1.75rem;
    }

    .reset-done-card .check-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background-color: #e3f1ea;
        color: #0f2a4f;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
    }

    .reset-done-card h1 {
        color: #0f2a4f;
        font-size: 1.9rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .reset-done-card p {
        color: #5f6f86;
        font-size: 0.95rem;
        line-height: 1.5;
        margin-bottom: 1.5rem;
    }

    .reset-done-card a.btn-login {
        display: block;
        width: 100%;
        background-color: #04245a;
        border: none;
        border-radius: 0;
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
        padding: 0.75rem;
        text-align: center;
        text-decoration: none;
    }

    .reset-done-card a.btn-login:hover,
    .reset-done-card a.btn-login:focus {
        background-color: #0f3a80;
        color: #ffffff;
    }
</style>

<div class="reset-done-page">
    <div class="reset-done-card">
        <div class="check-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="2.5 8.5 6.5 12.5 13.5 4" />
            </svg>
        </div>

        <h1>Passordet er endret</h1>

        <p>Du kan nå logge inn med det nye passordet ditt.</p>

        <a asp-action="Login" class="btn btn-login">Logg inn</a>
    </div>
</div>
